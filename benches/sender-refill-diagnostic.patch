@@ -3258,3 +3258,75 @@ fn ack_transfer_returns_before_final_report_and_reuses_without_changing_fences()
     assert!(workers[1].sender.incoming.is_empty());
     assert_eq!(workers[0].counters.ack_buffer_drops, 0);
 }
+
+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn refill_backlog_snapshot_follows_submitted_byte_accounting() {
+    for remaining in [false, true] {
+        let (mut workers, _rx) = workers();
+        frame(&mut workers[1]);
+        if remaining {
+            queue_frame(&mut workers[1], 60);
+        }
+        let (_, Message::Request(request)) = workers[1].sender.outgoing.pop_front().unwrap() else {
+            panic!()
+        };
+        let owner = workers[0].sender.owner.as_mut().unwrap();
+        owner.request(request).unwrap();
+        let now = Duration::from_millis(1);
+        let mut outgoing = VecDeque::with_capacity(16);
+        owner.advance(now, &mut outgoing).unwrap();
+        let (_, Message::Permit(flight)) = outgoing.pop_front().unwrap() else {
+            panic!()
+        };
+        assert_eq!(flight.packets().len(), 1);
+        let worker = &mut workers[1];
+        worker.sender_message(Message::Permit(flight), now).unwrap();
+        let deadline = worker.sender.job.unwrap().deadline;
+        let index = worker.sender_index(0, 1).unwrap();
+        let mut batch = worker.sessions[0].batches[1].take().unwrap();
+        let inputs: Vec<_> = batch.frames[..batch.len]
+            .iter()
+            .map(|id| worker.frames.input(id.unwrap()).unwrap())
+            .collect();
+        let mut parts = [&[][..]; pack::BATCH_SLICES];
+        let bytes: Vec<_> = batch
+            .plan
+            .slices(0, &inputs, &mut parts)
+            .unwrap()
+            .iter()
+            .flat_map(|part| part.iter().copied())
+            .collect();
+        assert!(worker.reserve_pieces(&batch, 1).unwrap());
+        worker.transmit[0].paths[0].lanes[1]
+            .socket
+            .as_ref()
+            .unwrap()
+            .send(&bytes, BASE_UDP_PAYLOAD)
+            .unwrap();
+        worker.finish_sender_send(1, Some(now), false).unwrap();
+        assert_eq!(
+            worker.sender.lanes[index].unsent_bytes,
+            if remaining { 120 } else { 60 }
+        );
+        let (_, Message::Complete(flight)) = worker.sender.outgoing.front().unwrap() else {
+            panic!()
+        };
+        let completed = flight.refill_trace.unwrap().completed;
+        worker.submitted_batch(0, 1, &mut batch, 1, true).unwrap();
+        worker.sessions[0].batches[1] = Some(batch);
+        assert_eq!(
+            worker.sender.lanes[index].unsent_bytes,
+            if remaining { 60 } else { 0 }
+        );
+        assert_eq!(worker.sessions[0].unexpanded_bytes[1], 0);
+        worker.flush_sender_messages(now).unwrap();
+        let Event::Sender(Message::Complete(flight)) =
+            workers[0].incoming[1].as_mut().unwrap().try_pop().unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(flight.refill_backlog_until, remaining.then_some(deadline));
+        assert_eq!(flight.refill_trace.unwrap().completed, completed);
+    }
+}
