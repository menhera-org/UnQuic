+// Experimental DATA pacer: scaled bytes avoid discarding fractional service.
+#[derive(Default)]
+struct Pacer {
+    credit: u128,
+    at: Option<Duration>,
+    rate: u64,
+    capacity: u64,
+    retry: Option<Duration>,
+}
+
+impl Pacer {
+    fn take(
+        &mut self,
+        bytes: u32,
+        capacity: u64,
+        rate: u64,
+        now: Duration,
+    ) -> Result<(), GrantError> {
+        const SCALE: u128 = 1_000_000_000;
+        let credit = match self.at {
+            None => u128::from(capacity) * SCALE,
+            Some(at) => {
+                let elapsed = now.checked_sub(at).ok_or(GrantError::Invalid)?;
+                self.credit
+                    .saturating_add(elapsed.as_nanos().saturating_mul(u128::from(self.rate)))
+                    .min(u128::from(self.capacity) * SCALE)
+                    .min(u128::from(capacity) * SCALE)
+            }
+        };
+        let cost = u128::from(bytes) * SCALE;
+        let accepted = rate != 0 && credit >= cost;
+        let remaining = if accepted { credit - cost } else { credit };
+        let needed = if accepted { 100 * SCALE } else { cost };
+        let retry = if rate == 0 || remaining >= needed {
+            None
+        } else {
+            let nanos = (needed - remaining).div_ceil(u128::from(rate));
+            Some(
+                now.checked_add(Duration::from_nanos(
+                    u64::try_from(nanos).map_err(|_| GrantError::Exhausted)?,
+                ))
+                .ok_or(GrantError::Exhausted)?,
+            )
+        };
+        self.credit = remaining;
+        self.at = Some(now);
+        self.rate = rate;
+        self.capacity = capacity;
+        self.retry = retry;
+        if accepted {
+            Ok(())
+        } else {
+            Err(GrantError::Blocked)
+        }
+    }
+}
