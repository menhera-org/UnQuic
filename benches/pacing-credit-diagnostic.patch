+#[cfg(test)]
+mod credit_tests {
+    use super::*;
+
+    fn limits() -> Limits {
+        Limits {
+            window: u64::MAX,
+            rate: 128_000_000,
+            quantum: 2560,
+            max_datagram: 1280,
+        }
+    }
+
+    #[test]
+    fn repeated_late_service_preserves_partial_quantum_credit() {
+        let limits = limits();
+        let mut grants = Grants::new(1).unwrap();
+        let initial = grants
+            .reserve(0, 2560, false, limits, Duration::ZERO)
+            .unwrap();
+        grants.reported(initial, 0, None).unwrap();
+        let mut strict_due = Duration::from_micros(20);
+        let mut strict_count = 0;
+        let mut credited_count = 0;
+        for visit in 0..32 {
+            let now = Duration::from_micros(25 + visit * 15);
+            if now >= strict_due {
+                strict_count += 1;
+                strict_due = now + Duration::from_micros(10);
+            }
+            let mut count = 0;
+            loop {
+                match grants.reserve(0, 1280, false, limits, now) {
+                    Ok(grant) => {
+                        grants.reported(grant, 0, None).unwrap();
+                        count += 1;
+                    }
+                    Err(GrantError::Blocked) => break,
+                    Err(error) => panic!("{error}"),
+                }
+            }
+            assert!(count <= 2);
+            credited_count += count;
+        }
+        assert_eq!(strict_count, 32);
+        assert_eq!(credited_count, 48);
+    }
+
+    #[test]
+    fn idle_credit_is_one_total_quantum_and_unused_or_partial_sends_never_refund_it() {
+        for sent in [0, 1280, 2560] {
+            let mut grants = Grants::new(2).unwrap();
+            let limits = limits();
+            let now = Duration::from_secs(1000);
+            let first = grants.reserve(0, 2560, false, limits, now).unwrap();
+            grants
+                .reported(first, sent, (sent != 0).then_some(now))
+                .unwrap();
+            assert_eq!(grants.in_flight(), u64::from(sent));
+            assert_eq!(
+                grants.reserve(1, 1280, false, limits, now),
+                Err(GrantError::Blocked)
+            );
+            assert_eq!(grants.deadline(now), Some(now + Duration::from_micros(10)));
+            let next = grants
+                .reserve(1, 1280, false, limits, now + Duration::from_micros(10))
+                .unwrap();
+            grants.reported(next, 0, None).unwrap();
+            assert_eq!(grants.in_flight(), u64::from(sent));
+            assert_eq!(
+                grants.reserve(0, 100, false, limits, now + Duration::from_micros(10)),
+                Err(GrantError::Blocked)
+            );
+        }
+    }
+
+    #[test]
+    fn rate_changes_use_old_rate_until_observation_and_growth_mints_no_credit() {
+        let mut pacer = Pacer::default();
+        let us = Duration::from_micros;
+        pacer.take(2560, 2560, 128_000_000, us(0)).unwrap();
+        pacer.take(1280, 2560, 64_000_000, us(10)).unwrap();
+        assert_eq!(
+            pacer.take(1280, 2560, 64_000_000, us(20)),
+            Err(GrantError::Blocked)
+        );
+        assert_eq!(pacer.retry, Some(us(30)));
+        assert_eq!(
+            pacer.take(1280, 5120, 256_000_000, us(20)),
+            Err(GrantError::Blocked)
+        );
+        assert_eq!(pacer.retry, Some(Duration::from_nanos(22_500)));
+        pacer
+            .take(1280, 5120, 256_000_000, Duration::from_nanos(22_500))
+            .unwrap();
+        assert_eq!(pacer.credit, 0);
+        assert_eq!(
+            pacer.take(100, 5120, 0, Duration::from_nanos(22_500)),
+            Err(GrantError::Blocked)
+        );
+        assert_eq!(
+            pacer.take(100, 5120, 256_000_000, us(1000)),
+            Err(GrantError::Blocked)
+        );
+        assert_eq!(pacer.credit, 0);
+    }
+
+    #[test]
+    fn shrink_caps_credit_and_backward_time_or_overflow_cannot_spend_it() {
+        let mut pacer = Pacer::default();
+        let us = Duration::from_micros;
+        pacer.take(100, 2560, 128_000_000, us(10)).unwrap();
+        assert_eq!(
+            pacer.take(100, 2560, 128_000_000, us(9)),
+            Err(GrantError::Invalid)
+        );
+        assert_eq!(pacer.at, Some(us(10)));
+        assert_eq!(pacer.credit, 2460 * 1_000_000_000);
+        pacer.take(1280, 1280, 128_000_000, us(1000)).unwrap();
+        assert_eq!(pacer.credit, 0);
+        let prior = (pacer.credit, pacer.at, pacer.retry);
+        assert_eq!(
+            pacer.take(1280, 1280, 1, Duration::MAX),
+            Err(GrantError::Exhausted)
+        );
+        assert_eq!((pacer.credit, pacer.at, pacer.retry), prior);
+    }
+
+    #[test]
+    fn outstanding_expired_grants_and_pto_allowance_still_bound_credit() {
+        let mut grants = Grants::new(3).unwrap();
+        let limits = Limits {
+            window: 0,
+            ..limits()
+        };
+        grants.probe_allowance(2).unwrap();
+        let a = grants
+            .reserve(0, 1280, true, limits, Duration::ZERO)
+            .unwrap();
+        let b = grants
+            .reserve(1, 1280, true, limits, Duration::ZERO)
+            .unwrap();
+        assert_eq!(
+            grants.reserve(2, 100, true, limits, Duration::from_secs(1)),
+            Err(GrantError::Blocked)
+        );
+        assert_eq!(grants.reserved(), 2560);
+        grants.reported(a, 1280, Some(Duration::ZERO)).unwrap();
+        grants.reported(b, 1280, Some(Duration::ZERO)).unwrap();
+        assert_eq!(
+            grants.reserve(2, 100, true, limits, Duration::from_secs(1)),
+            Err(GrantError::Blocked)
+        );
+        assert_eq!(
+            grants.reserve(2, 100, false, limits, Duration::from_secs(1)),
+            Err(GrantError::Blocked)
+        );
+        assert_eq!(grants.in_flight(), 2560);
+    }
+}
