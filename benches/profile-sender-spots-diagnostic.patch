@@ -105,5 +105,20 @@ pub fn report(worker: usize, phases: &[u64; PHASES]) {
             100.0 * phases[index] as f64 / total.max(1) as f64
         ));
     }
+    let spots: Vec<String> = SPOTS.iter().map(|s| format!("{}/{}", s[0].load(std::sync::atomic::Ordering::Relaxed), s[1].load(std::sync::atomic::Ordering::Relaxed))).collect();
+    line.push_str(&format!(" spots {}", spots.join(",")));
     eprintln!("{line}");
 }
+
+/// Diagnostic spots inside a phase, process-wide: cycles and visits.
+pub static SPOTS: [[std::sync::atomic::AtomicU64; 2]; 16] =
+    [const { [const { std::sync::atomic::AtomicU64::new(0) }; 2] }; 16];
+
+/// Charges the time since `started` to spot `index` and returns the time now.
+pub fn spot(index: usize, started: u64) -> u64 {
+    use std::sync::atomic::Ordering::Relaxed;
+    let now = now();
+    SPOTS[index][0].fetch_add(now.wrapping_sub(started), Relaxed);
+    SPOTS[index][1].fetch_add(1, Relaxed);
+    now
+}
