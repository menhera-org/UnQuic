+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn receive_ack_pressure_preserves_gro_position_and_expired_admission() {
+    use super::super::tests::{receive_bytes, receive_piece, receive_worker};
+    let (mut worker, tap) = receive_worker();
+    worker.unpaced_fixture = false;
+    let received = Duration::from_micros(3);
+    let ranges = [AckRange { start: 1, end: 1 }];
+    let mut records = vec![receive_piece(1, 0, &[1; 30])];
+    for delay_us in 0..5 {
+        records.push(Record::Ack {
+            lane: 2,
+            delay_us,
+            ranges: AckRanges::new(&ranges).unwrap(),
+        });
+    }
+    let mut packet = worker.free.pop().unwrap();
+    let first = receive_bytes(1, &records, &mut packet.bytes);
+    let second = receive_bytes(
+        2,
+        &[receive_piece(1, 30, &[1; 30])],
+        &mut packet.bytes[first..],
+    );
+    assert!(second < first);
+    packet.length = first + second;
+    packet.segment_size = first;
+    packet.deadline = received;
+    worker.received.push_back(packet);
+    assert!(!worker.drain_packets(Duration::from_millis(1)).unwrap());
+    assert_eq!(worker.received.front().unwrap().offset, 0);
+    assert_eq!(worker.received.front().unwrap().rx_record, Some(5));
+    let now = Duration::from_millis(101);
+    assert_eq!(worker.sessions[0].rx[0].as_mut().unwrap().expire(now), 1);
+    let mut markers = Vec::new();
+    resume_returns(&mut worker, received, &mut markers);
+    assert!(!worker.drain_packets(now).unwrap());
+    resume_returns(&mut worker, received, &mut markers);
+    worker.flush_taps(now).unwrap();
+    assert!(worker.received.is_empty());
+    assert_eq!(markers, (0..5).collect::<Vec<_>>());
+    assert_eq!(
+        worker.sessions[0].rx[0]
+            .as_ref()
+            .unwrap()
+            .expired_incomplete_frames(),
+        1
+    );
+    assert_eq!(
+        tap.recv(&mut [0; 60]).unwrap_err().kind(),
+        io::ErrorKind::WouldBlock
+    );
+    assert_eq!(worker.counters.ack_buffer_drops, 0);
+}
