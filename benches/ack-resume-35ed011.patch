+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn receive_ack_pressure_rechecks_generation_and_owner_before_resuming() {
+    use super::super::tests::{receive_bytes, receive_worker};
+    for stale_owner in [false, true] {
+        let (mut worker, _tap) = receive_worker();
+        worker.unpaced_fixture = false;
+        let held = std::mem::take(&mut worker.sender.ack_free);
+        let ranges = [AckRange { start: 1, end: 1 }];
+        let mut packet = worker.free.pop().unwrap();
+        packet.length = receive_bytes(
+            1,
+            &[Record::Ack {
+                lane: 2,
+                delay_us: 0,
+                ranges: AckRanges::new(&ranges).unwrap(),
+            }],
+            &mut packet.bytes,
+        );
+        worker.received.push_back(packet);
+        assert!(!worker.drain_packets(Duration::ZERO).unwrap());
+        assert_eq!(worker.received.front().unwrap().rx_record, Some(0));
+        if stale_owner {
+            worker.shared.owners[0][7].store(255, Ordering::Release);
+        } else {
+            worker.sessions[0].connection.as_mut().unwrap().initiator = Tag::new(3).unwrap();
+        }
+        assert!(!worker.drain_packets(Duration::ZERO).unwrap());
+        assert!(worker.received.is_empty());
+        assert!(worker.sender.outgoing.is_empty());
+        worker.sender.ack_free = held;
+    }
+}
