+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn receive_ack_pressure_resumes_exact_record_and_allows_other_datagrams() {
+    use super::super::tests::{receive_bytes, receive_piece, receive_worker};
+    let (mut worker, tap) = receive_worker();
+    worker.unpaced_fixture = false;
+    let received = Duration::from_micros(3);
+    let now = Duration::from_millis(1);
+    let ranges = [AckRange { start: 1, end: 1 }];
+    let mut records = vec![Record::Probe, receive_piece(1, 0, &[1; 60])];
+    for delay_us in 0..9 {
+        records.push(Record::Ack {
+            lane: 2,
+            delay_us,
+            ranges: AckRanges::new(&ranges).unwrap(),
+        });
+    }
+    let mut packet = worker.free.pop().unwrap();
+    packet.length = receive_bytes(1, &records, &mut packet.bytes);
+    packet.deadline = received;
+    worker.received.push_back(packet);
+    assert!(!worker.drain_packets(now).unwrap());
+    assert_eq!(worker.received.front().unwrap().rx_record, Some(6));
+    assert_eq!(worker.control_replies, 1);
+    assert_eq!(worker.counters.ack_buffer_deferred, 1);
+    assert!(!worker.drain_packets(now).unwrap());
+    assert_eq!(worker.counters.ack_buffer_deferred, 1);
+
+    // A duplicate must not replay its ACKs; another datagram can still deliver DATA.
+    for (number, bytes) in [(1, 1), (2, 2)] {
+        let mut packet = worker.free.pop().unwrap();
+        packet.length = receive_bytes(
+            number,
+            &[receive_piece(number, 0, &[bytes; 60])],
+            &mut packet.bytes,
+        );
+        packet.deadline = received;
+        worker.received.push_back(packet);
+    }
+    assert!(!worker.drain_packets(now).unwrap());
+    assert_eq!(worker.counters.duplicate_packets, 1);
+    worker.flush_taps(now).unwrap();
+    let mut frame = [0; 60];
+    assert_eq!(tap.recv(&mut frame).unwrap(), 60);
+    assert_eq!(frame, [1; 60]);
+    assert_eq!(tap.recv(&mut frame).unwrap(), 60);
+    assert_eq!(frame, [2; 60]);
+
+    let mut markers = Vec::new();
+    resume_returns(&mut worker, received, &mut markers);
+    assert!(!worker.drain_packets(now).unwrap());
+    assert_eq!(worker.received.front().unwrap().rx_record, Some(10));
+    resume_returns(&mut worker, received, &mut markers);
+    assert!(!worker.drain_packets(now).unwrap());
+    resume_returns(&mut worker, received, &mut markers);
+    assert!(worker.received.is_empty());
+    assert_eq!(markers, (0..9).collect::<Vec<_>>());
+    assert_eq!(worker.sender.ack_free.len(), ACK_BUFFERS);
+    assert_eq!(worker.control_replies, 1);
+    assert_eq!(worker.counters.duplicate_packets, 1);
+    assert_eq!(worker.counters.ack_buffer_drops, 0);
+}
