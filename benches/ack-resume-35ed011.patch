+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn receive_ack_pressure_all_waiting_beyond_datagram_budget_does_not_spin() {
+    use super::super::tests::receive_worker;
+    let (mut worker, _tap) = receive_worker();
+    let held = std::mem::take(&mut worker.sender.ack_free);
+    // Forwarded buffers can exceed one reader's eight credits on a many-worker host.
+    for _ in 0..BATCH_SIZE + 1 {
+        let mut packet = worker.free.pop().unwrap();
+        packet.rx_record = Some(0);
+        packet.session = 0;
+        packet.tag = 1;
+        packet.lane = 7;
+        worker.received.push_back(packet);
+    }
+    assert!(!worker.drain_packets(Duration::ZERO).unwrap());
+    assert_eq!(worker.received.len(), BATCH_SIZE + 1);
+    worker.sender.ack_free = held;
+}
