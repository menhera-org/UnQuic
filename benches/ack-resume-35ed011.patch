+fn resume_returns(worker: &mut Worker, received: Duration, markers: &mut Vec<u32>) {
+    while let Some((_, message)) = worker.sender.outgoing.pop_front() {
+        let Message::Ack(ack) = message else {
+            panic!("unexpected sender message");
+        };
+        assert_eq!(ack.received, received);
+        markers.push(ack.delay_us);
+        worker
+            .sender_message(Message::AckReturn(ack), received)
+            .unwrap();
+    }
+}
