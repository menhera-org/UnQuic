+//! Source-deadline abandonment is advisory metadata, independent of retained DATA.
+//! Each worker retains at most 128 advisories in its accounted inline storage.
+//! Origin 1 and lane-retirement transmission are separate runtime work.
+use super::*;
+
+const CAPACITY: usize = 128;
+const LIFETIME: Duration = Duration::from_millis(100);
+const LENGTH: usize = wire::HEADER_LEN + 4 + 12;
+
+#[derive(Clone, Copy)]
+struct Advisory {
+    serial: u64,
+    session: usize,
+    generation: u64,
+    lane: usize,
+    frame: u64,
+    expires: Duration,
+    due: Duration,
+    sent: [u64; 3],
+    attempts: usize,
+}
+impl Advisory {
+    fn acknowledged(self, history: &History) -> bool {
+        // shortcut: retired ACK proof may allow a redundant bounded copy. Keep
+        // no permanent ACK ledger; add one only if its measured cost warrants it.
+        self.sent
+            .iter()
+            .take(self.attempts)
+            .any(|&n| history.acknowledged(n))
+    }
+    fn current(self, local: &Session, lane: &Lane) -> bool {
+        local.connection.is_some()
+            && local
+                .installed
+                .is_some_and(|c| c.generation == self.generation)
+            && lane.generation == self.generation
+    }
+}
+
+pub(super) struct Pending {
+    entries: [Option<Advisory>; CAPACITY],
+    serial: u64,
+    count: usize,
+    cursor: usize,
+    yield_data: bool,
+}
+impl Pending {
+    pub(super) const fn new() -> Self {
+        Self {
+            entries: [None; CAPACITY],
+            serial: 0,
+            count: 0,
+            cursor: 0,
+            yield_data: false,
+        }
+    }
+    fn get(&self, slot: usize, serial: u64) -> Option<Advisory> {
+        self.entries
+            .get(slot)
+            .copied()
+            .flatten()
+            .filter(|a| a.serial == serial)
+    }
+    fn remove(&mut self, slot: usize, serial: u64) {
+        if self.get(slot, serial).is_some()
+            && let Some(entry) = self.entries.get_mut(slot)
+        {
+            *entry = None;
+            self.count -= 1;
+        }
+    }
+}
+
+impl Worker {
+    fn count_abandon(&mut self, session: usize, lane: usize, field: fn(&mut Snapshot) -> &mut u64) {
+        let local = &mut self.sessions[session];
+        for totals in [
+            &mut self.counters,
+            &mut local.totals,
+            &mut local.tx_totals[lane],
+        ] {
+            let counter = field(totals);
+            *counter = counter.wrapping_add(1);
+        }
+        local.tx_dirty |= 1_u64 << lane;
+    }
+
+    pub(in crate::worker) fn queue_abandon(
+        &mut self,
+        session: usize,
+        lane: usize,
+        frame: u64,
+        now: Duration,
+    ) {
+        if !self.sender_enabled() {
+            return;
+        }
+        let Some(generation) = self
+            .sessions
+            .get(session)
+            .and_then(|s| s.installed)
+            .map(|c| c.generation)
+        else {
+            return;
+        };
+        let pending = &mut self.sender.abandons;
+        if pending.count == CAPACITY {
+            self.count_abandon(session, lane, |s| &mut s.abandon_dropped);
+            return;
+        }
+        let serial = pending.serial.checked_add(1);
+        let slot = pending.entries.iter_mut().find(|a| a.is_none());
+        if let (Some(serial), Some(slot)) = (serial, slot) {
+            *slot = Some(Advisory {
+                serial,
+                session,
+                generation,
+                lane,
+                frame,
+                expires: now.saturating_add(LIFETIME),
+                due: now,
+                sent: [0; 3],
+                attempts: 0,
+            });
+            pending.serial = serial;
+            pending.count += 1;
+            self.count_abandon(session, lane, |s| &mut s.abandon_queued);
+        } else {
+            self.count_abandon(session, lane, |s| &mut s.abandon_dropped);
+        }
+    }
+
+    pub(super) fn defer_abandon(&mut self, job: Job, now: Duration) {
+        if let JobKind::Abandon { slot, serial } = job.kind
+            && let Some(current) = self
+                .sender
+                .abandons
+                .entries
+                .get_mut(slot)
+                .and_then(Option::as_mut)
+                .filter(|a| a.serial == serial)
+        {
+            current.due = now.saturating_add(RETRY);
+        }
+    }
+
+    pub(in crate::worker) fn abandon_deadline(&self) -> Option<Duration> {
+        if self.sender.abandons.count == 0 {
+            return None;
+        }
+        let available = self.sender.job.is_none() && self.sender.flight.is_some();
+        self.sender
+            .abandons
+            .entries
+            .iter()
+            .flatten()
+            .map(|a| {
+                if available && a.attempts < a.sent.len() {
+                    a.expires.min(a.due)
+                } else {
+                    a.expires
+                }
+            })
+            .min()
+    }
+
+    pub(super) fn service_abandons(&mut self, now: Duration) -> io::Result<()> {
+        if self.sender.abandons.count == 0 {
+            return Ok(());
+        }
+        // Every advisory request leaves the next free-flight turn for DATA.
+        let available = self.sender.job.is_none() && self.sender.flight.is_some();
+        let yield_data = available && std::mem::take(&mut self.sender.abandons.yield_data);
+        for _ in 0..32 {
+            let slot = self.sender.abandons.cursor;
+            self.sender.abandons.cursor = (slot + 1) % CAPACITY;
+            let Some(advisory) = self.sender.abandons.entries.get(slot).copied().flatten() else {
+                continue;
+            };
+            let index = self.sender_index(advisory.session, advisory.lane)?;
+            let history = &self.sender.lanes[index];
+            let current = advisory.current(&self.sessions[advisory.session], history);
+            if current && now < advisory.due && now < advisory.expires {
+                continue;
+            }
+            let acknowledged = current && advisory.acknowledged(&history.history);
+            if !current || acknowledged || now >= advisory.expires {
+                self.sender.abandons.remove(slot, advisory.serial);
+                if !current {
+                    self.count_abandon(advisory.session, advisory.lane, |s| &mut s.abandon_dropped);
+                } else if !acknowledged {
+                    self.count_abandon(advisory.session, advisory.lane, |s| &mut s.abandon_expired);
+                }
+            } else if !yield_data
+                && now >= advisory.due
+                && advisory.attempts < advisory.sent.len()
+                && self.sender.job.is_none()
+                && self.sender.flight.is_some()
+            {
+                self.request_abandon(slot, advisory, index, now)?;
+                if self.sender.job.is_some() {
+                    self.sender.abandons.yield_data = true;
+                    break;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn request_abandon(
+        &mut self,
+        slot: usize,
+        advisory: Advisory,
+        index: usize,
+        now: Duration,
+    ) -> io::Result<()> {
+        let local = &mut self.sessions[advisory.session];
+        let Some(tx) = local.tx.get_mut(advisory.lane).and_then(Option::as_mut) else {
+            return Ok(());
+        };
+        let number = match tx.allocate_packets(1) {
+            Ok(number) => number,
+            Err(_) => {
+                self.sender.abandons.remove(slot, advisory.serial);
+                self.count_abandon(advisory.session, advisory.lane, |s| &mut s.abandon_dropped);
+                return Ok(());
+            }
+        };
+        match self.sender.lanes[index]
+            .history
+            .reserve(number, (LENGTH + 48) as u16, true, true)
+        {
+            Ok(()) => {}
+            Err(crate::ack::HistoryError::Full) => {
+                self.sender.reclaim = Some(self.sender.lanes.len());
+                if let Some(pending) = self
+                    .sender
+                    .abandons
+                    .entries
+                    .get_mut(slot)
+                    .and_then(Option::as_mut)
+                {
+                    pending.due = now.saturating_add(RETRY);
+                }
+                return Ok(());
+            }
+            Err(error) => return Err(io::Error::other(error)),
+        }
+        let mut flight = self
+            .sender
+            .flight
+            .take()
+            .ok_or(io::ErrorKind::InvalidData)?;
+        flight
+            .prepare(&[pacing::Planned {
+                id: PacketId {
+                    session: advisory.session,
+                    generation: advisory.generation,
+                    lane: advisory.lane as u16 + 1,
+                    number,
+                },
+                bytes: (LENGTH + 48) as u16,
+            }])
+            .map_err(io::Error::other)?;
+        self.sender.job = Some(Job {
+            session: advisory.session,
+            generation: advisory.generation,
+            lane: advisory.lane,
+            path: local.path,
+            first: number,
+            count: 1,
+            deadline: advisory.expires,
+            kind: JobKind::Abandon {
+                slot,
+                serial: advisory.serial,
+            },
+        });
+        let peer = self
+            .shared
+            .config
+            .peer_for_session(advisory.session)
+            .ok_or(io::ErrorKind::InvalidData)?;
+        let mtu = (self.transmit[peer].paths[local.path].lanes[advisory.lane]
+            .mtu
+            .payload_limit()
+            + 48)
+            .max(1280) as u16;
+        self.sender.queue(
+            0,
+            Message::Request(Request {
+                flight,
+                group: self.sender.lanes[index].group,
+                deadline: advisory.expires,
+                probe: None,
+                pmtu: false,
+                mtu,
+            }),
+        )
+    }
+
+    pub(super) fn send_abandon(
+        &mut self,
+        job: Job,
+        slot: usize,
+        serial: u64,
+        now: Duration,
+    ) -> io::Result<()> {
+        let index = self.sender_index(job.session, job.lane)?;
+        let grant = self
+            .sender
+            .flight
+            .as_ref()
+            .and_then(|f| f.grant())
+            .ok_or(io::ErrorKind::InvalidData)?;
+        let Some(advisory) = self.sender.abandons.get(slot, serial) else {
+            return self.finish_sender_send(0, None, false);
+        };
+        let local = &self.sessions[job.session];
+        let connection = local.connection.ok_or(io::ErrorKind::InvalidData)?;
+        let mut bytes = [0; LENGTH];
+        wire::encode_datagram(
+            Header {
+                cookie: self.shared.config.config().sessions[job.session].cookie,
+                receive_tag: connection.remote_tag().get(),
+                lane: job.lane as u16 + 1,
+                packet_number: job.first,
+                record_area_len: 0,
+            },
+            &[Record::FrameAbandon {
+                lane: job.lane as u16 + 1,
+                origin: 0,
+                reason: 1,
+                frame_id: advisory.frame,
+            }],
+            &mut bytes,
+        )
+        .map_err(io::Error::other)?;
+        let peer = self
+            .shared
+            .config
+            .peer_for_session(job.session)
+            .ok_or(io::ErrorKind::InvalidData)?;
+        let mut clock = self.io_clock(now);
+        let pending = &self.sender.abandons;
+        let history = &self.sender.lanes[index];
+        let socket = self.transmit[peer].paths[job.path].lanes[job.lane]
+            .socket
+            .as_ref();
+        let mut canceled = false;
+        let mut acknowledged = false;
+        let result = if let Some(socket) = socket {
+            socket.send_batch_checked(
+                &[SendDatagram { parts: &[&bytes] }],
+                BASE_UDP_PAYLOAD,
+                || {
+                    let at = clock()?;
+                    if !grant.valid_at(at)
+                        || pending.get(slot, serial).is_none_or(|a| {
+                            at >= a.expires
+                                || !a.current(local, history)
+                                || {
+                                    acknowledged = a.acknowledged(&history.history);
+                                    acknowledged
+                                }
+                                || a.attempts >= a.sent.len()
+                        })
+                    {
+                        canceled = true;
+                        return Err(io::ErrorKind::WouldBlock.into());
+                    }
+                    Ok(at)
+                },
+            )
+        } else {
+            Err(io::ErrorKind::NotConnected.into())
+        };
+        let sent = result.as_ref().ok().copied();
+        self.finish_sender_send(
+            sent.map_or(0, |(n, _)| n),
+            sent.and_then(|(n, at)| (n != 0).then_some(at)),
+            !canceled
+                && result
+                    .as_ref()
+                    .is_err_and(|e| e.kind() == io::ErrorKind::WouldBlock),
+        )?;
+        if let Some((1, at)) = sent {
+            if let Some(current) = self
+                .sender
+                .abandons
+                .entries
+                .get_mut(slot)
+                .and_then(Option::as_mut)
+                .filter(|a| a.serial == serial)
+            {
+                let number = current
+                    .sent
+                    .get_mut(current.attempts)
+                    .ok_or(io::ErrorKind::InvalidData)?;
+                *number = job.first;
+                current.attempts += 1;
+                current.due = if current.attempts == current.sent.len() {
+                    current.expires
+                } else {
+                    at.saturating_add(self.sender.lanes[index].rtt.pto_period(0))
+                };
+            }
+            self.count_abandon(job.session, job.lane, |s| &mut s.abandon_sent);
+            if advisory.attempts != 0 {
+                self.count_abandon(job.session, job.lane, |s| &mut s.abandon_retried);
+            }
+            let local = &mut self.sessions[job.session];
+            for totals in [
+                &mut self.counters,
+                &mut local.totals,
+                &mut local.tx_totals[job.lane],
+            ] {
+                totals.tx_outer_bytes = totals.tx_outer_bytes.wrapping_add((LENGTH + 48) as u64);
+            }
+            local.tx_dirty |= 1_u64 << job.lane;
+        } else if acknowledged {
+            self.sender.abandons.remove(slot, serial);
+        } else if let Some(current) = self
+            .sender
+            .abandons
+            .entries
+            .get_mut(slot)
+            .and_then(Option::as_mut)
+            .filter(|a| a.serial == serial)
+        {
+            current.due = now.saturating_add(RETRY);
+        }
+        if let Err(error) = result
+            && !canceled
+            && !transient(&error)
+        {
+            self.counters.socket_errors = self.counters.socket_errors.wrapping_add(1);
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        alloc::{GlobalAlloc, Layout, System},
+        cell::Cell,
+    };
+
+    struct Allocator;
+    thread_local! {
+        static ALLOCATIONS: Cell<Option<usize>> = const { Cell::new(None) };
+        static CLOCK_CALLS: Cell<usize> = const { Cell::new(0) };
+    }
+    #[global_allocator]
+    static ALLOCATOR: Allocator = Allocator;
+    // SAFETY: the unchanged allocation contracts are delegated to System.
+    unsafe impl GlobalAlloc for Allocator {
+        unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+            let _ = ALLOCATIONS.try_with(|c| c.set(c.get().map(|n| n + 1)));
+            // SAFETY: forwarding the caller's layout.
+            unsafe { System.alloc(layout) }
+        }
+        unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
+            // SAFETY: forwarding the live pointer and matching layout.
+            unsafe { System.dealloc(pointer, layout) }
+        }
+        unsafe fn realloc(&self, pointer: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+            let _ = ALLOCATIONS.try_with(|c| c.set(c.get().map(|n| n + 1)));
+            // SAFETY: forwarding the caller's allocation and requested size.
+            unsafe { System.realloc(pointer, layout, size) }
+        }
+    }
+
+    fn without_allocations(f: impl FnOnce()) {
+        ALLOCATIONS.with(|c| c.set(Some(0)));
+        f();
+        assert_eq!(ALLOCATIONS.with(|c| c.replace(None)), Some(0));
+    }
+
+    #[test]
+    fn acknowledgement_is_not_loss_retirement_or_reservation() {
+        let mut history = History::new().unwrap();
+        without_allocations(|| {
+            for number in 1..=3 {
+                history.reserve(number, 112, true, true).unwrap();
+            }
+            assert!(history.submit(1, Duration::ZERO));
+            assert!(history.submit(2, Duration::ZERO));
+            assert!(history.lose(2).is_some());
+            assert!(!history.acknowledged(1));
+            assert!(!history.acknowledged(2));
+            assert!(!history.acknowledged(3));
+            history
+                .acknowledge(
+                    AckRanges::new(&[AckRange { start: 1, end: 1 }]).unwrap(),
+                    |_| {},
+                )
+                .unwrap();
+            assert!(history.acknowledged(1));
+            assert_eq!(history.retire_oldest_resolved().unwrap().unwrap().number, 1);
+            assert!(!history.acknowledged(1));
+        });
+    }
+
+    fn setup() -> ([Worker; 2], ReceiveSocket) {
+        let (mut workers, rx) = super::super::tests::workers();
+        for worker in &mut workers {
+            worker.io_time = Some(Ok);
+            for control in &mut worker.controls {
+                control.probe_due = Duration::MAX;
+            }
+            for lane in &mut worker.sender.lanes {
+                lane.rtt.sample(Duration::ZERO, Duration::from_millis(1), 0);
+            }
+        }
+        (workers, rx)
+    }
+
+    fn pump(worker: &mut Worker, now: Duration) {
+        for _ in 0..16 {
+            worker.service_sender(now).unwrap();
+        }
+    }
+
+    fn permit(worker: &mut Worker, now: Duration) -> Job {
+        for _ in 0..16 {
+            worker.service_abandons(now).unwrap();
+            worker.flush_sender_messages(now).unwrap();
+            worker
+                .sender
+                .owner
+                .as_mut()
+                .unwrap()
+                .advance(now, &mut worker.sender.outgoing)
+                .unwrap();
+            worker.flush_sender_messages(now).unwrap();
+            if worker.sender.permitted {
+                return worker.sender.job.unwrap();
+            }
+        }
+        panic!("advisory did not obtain ordinary credit");
+    }
+
+    fn receive(rx: &ReceiveSocket) -> u64 {
+        let mut bytes = [0; BASE_UDP_PAYLOAD];
+        let length = rx.recv(&mut bytes).unwrap().0;
+        assert_eq!(length, LENGTH);
+        let packet = Datagram::decode(&bytes[..length]).unwrap();
+        assert!(matches!(
+            packet.records().next(),
+            Some(Record::FrameAbandon {
+                lane: 1,
+                origin: 0,
+                reason: 1,
+                frame_id: 0x0001_0000_0000_0001,
+            })
+        ));
+        packet.header().packet_number
+    }
+
+    fn empty(rx: &ReceiveSocket) {
+        assert_eq!(
+            rx.recv(&mut [0; BASE_UDP_PAYLOAD]).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+    }
+
+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn abandonment_retries_are_charged_and_stop_at_three_copies_and_original_deadline() {
+        let (mut workers, rx) = setup();
+        let worker = &mut workers[0];
+        worker.queue_abandon(0, 0, (1 << 48) | 1, Duration::ZERO);
+        let mut previous = 0;
+        without_allocations(|| {
+            for millis in [1, 20, 40] {
+                let now = Duration::from_millis(millis);
+                permit(worker, now);
+                worker.use_sender_permit(now).unwrap();
+                pump(worker, now);
+                let number = receive(&rx);
+                assert!(number > previous);
+                previous = number;
+                let packet = worker.sender.lanes[0].history.packet(number).unwrap();
+                assert!(packet.eliciting && packet.charged && packet.sample_slot.is_some());
+                assert!(!worker.sender.lanes[0].history.acknowledged(number));
+            }
+            pump(worker, Duration::from_millis(60));
+            empty(&rx);
+            assert_eq!(worker.counters.abandon_sent, 3);
+            assert_eq!(worker.counters.abandon_retried, 2);
+            assert_eq!(
+                worker
+                    .sender
+                    .owner
+                    .as_ref()
+                    .unwrap()
+                    .snapshot(0)
+                    .unwrap()
+                    .bytes_in_flight,
+                3 * 112
+            );
+            pump(worker, Duration::from_millis(100));
+            assert_eq!(worker.sender.abandons.count, 0);
+            assert_eq!(worker.counters.abandon_expired, 1);
+            assert_eq!(worker.sender.lanes[0].history.inflight_bytes(), 3 * 112);
+        });
+    }
+
+    fn retain_data_plan(worker: &mut Worker) -> u64 {
+        let mut frame = worker.free.pop().unwrap();
+        frame.session = 0;
+        frame.lane = 0;
+        frame.tag = 1;
+        frame.length = 60;
+        frame.bytes[..60].fill(7);
+        frame.deadline = Duration::from_millis(100);
+        frame.tx_reserved = true;
+        worker.sessions[0].tx_retained += 1;
+        worker.sessions[0].tx_bytes += frame.length;
+        worker.input_frame(frame, Duration::ZERO).unwrap();
+        let mut batch = worker.sessions[0].batches[0].take().unwrap();
+        let index = batch
+            .pending
+            .pop_front(&mut worker.frames)
+            .unwrap()
+            .unwrap();
+        batch.frames[0] = Some(index);
+        batch.len = 1;
+        worker.recovery.set(index, Place::Batch).unwrap();
+        batch
+            .prepare(
+                worker.sessions[0].tx[0].as_mut().unwrap(),
+                &worker.frames,
