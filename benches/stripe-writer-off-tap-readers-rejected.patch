+    #[test]
+    fn stripe_writers_avoid_tap_readers_and_stay_until_their_stripe_goes_silent() {
+        let readers: Vec<_> = (0..4).map(|_| AtomicU64::new(0)).collect();
+        let slot = AtomicU64::new(0);
+        // Without a shared slot the stripe number picks the writer.
+        assert_eq!(stripe_writer(None, &readers, 6, 4, 0), 2);
+        // Worker 0 reads a TAP, so stripe 0 goes to the first quiet worker.
+        mark_reader(&readers[0], 100);
+        assert_eq!(stripe_writer(Some(&slot), &readers, 0, 4, 150), 1);
+        // The choice holds while frames arrive, even once worker 1 reads too.
+        mark_reader(&readers[1], 200);
+        assert_eq!(stripe_writer(Some(&slot), &readers, 0, 4, 250), 1);
+        assert_eq!(
+            stripe_writer(Some(&slot), &readers, 0, 4, 250 + FLOW_IDLE_MS - 1),
+            1
+        );
+        // After a silent second the stripe is placed afresh; no worker has
+        // read within READER_MS, so stripe 5 takes worker 5 mod 4.
+        let late = 250 + 2 * FLOW_IDLE_MS;
+        assert_eq!(stripe_writer(Some(&slot), &readers, 5, 4, late), 1);
+        // With worker 1 reading, it takes the third of workers 0, 2 and 3.
+        let slot = AtomicU64::new(0);
+        mark_reader(&readers[1], late);
+        assert_eq!(stripe_writer(Some(&slot), &readers, 5, 4, late), 3);
+        // When every worker reads, the stripe number decides.
+        for reader in &readers {
+            mark_reader(reader, late);
+        }
+        let slot = AtomicU64::new(0);
+        assert_eq!(stripe_writer(Some(&slot), &readers, 7, 4, late), 3);
+    }
