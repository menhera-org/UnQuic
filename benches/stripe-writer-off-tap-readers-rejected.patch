+/// A worker that read a TAP this recently counts as busy reading.
+const READER_MS: u64 = 100;
+
+/// Records for stripe writers that this worker is reading a TAP.
+fn mark_reader(stamp: &AtomicU64, ms: u64) {
+    let now = STRIPE_IN_USE | (ms & FLOW_MS_MASK);
+    if stamp.load(Ordering::Relaxed) != now {
+        stamp.store(now, Ordering::Relaxed);
+    }
+}
+
+/// The worker that writes a stripe's frames to the TAP. Receive owners
+/// share the choice through `slot`, which holds the writer plus one and a
+/// millisecond stamp. The first to forward a frame of a silent stripe
+/// chooses, among workers that have not read a TAP within READER_MS when
+/// there are any, so that one worker does not both read a TAP and write a
+/// striped flow. A stripe silent for FLOW_IDLE_MS, past the writer's own
+/// restart, may be given another writer.
+fn stripe_writer(
+    slot: Option<&AtomicU64>,
+    readers: &[AtomicU64],
+    number: u16,
+    workers: usize,
+    ms: u64,
+) -> usize {
+    let fallback = usize::from(number) % workers;
+    let Some(slot) = slot else {
+        return fallback;
+    };
+    let now = ms & FLOW_MS_MASK;
+    let quiet = |worker: usize| {
+        readers.get(worker).is_none_or(|stamp| {
+            let stamp = stamp.load(Ordering::Relaxed);
+            stamp == 0 || now.wrapping_sub(stamp) & FLOW_MS_MASK >= READER_MS
+        })
+    };
+    let mut old = slot.load(Ordering::Acquire);
+    loop {
+        let (writer, stamp) = ((old >> 24) as usize, old & FLOW_MS_MASK);
+        if old != 0
+            && (1..=workers).contains(&writer)
+            && now.wrapping_sub(stamp) & FLOW_MS_MASK < FLOW_IDLE_MS
+        {
+            if stamp != now {
+                // A lost race only leaves the stamp a millisecond older.
+                let _ = slot.compare_exchange(
+                    old,
+                    (writer as u64) << 24 | now,
+                    Ordering::AcqRel,
+                    Ordering::Acquire,
+                );
+            }
+            return writer - 1;
+        }
+        let count = (0..workers).filter(|&w| quiet(w)).count();
+        let choice = (0..workers)
+            .filter(|&w| quiet(w))
+            .nth(usize::from(number) % count.max(1))
+            .unwrap_or(fallback);
+        match slot.compare_exchange(
+            old,
+            ((choice + 1) as u64) << 24 | now,
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        ) {
+            Ok(_) => return choice,
+            Err(current) => old = current,
+        }
+    }
+}
