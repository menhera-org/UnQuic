+#[test]
+fn loss_scan_diagnostics_count_sparse_prefix_and_zero_inflight_fast_path() {
+    let mut history = History::new().unwrap();
+    sent(&mut history, 65_535, true);
+    let mut scan = history.outstanding_scan();
+    assert_eq!(scan.diagnostic(), (0, 0, 65_535));
+    let mut budget = 64;
+    assert_eq!(scan.advance(&history, &mut budget), None);
+    assert_eq!(budget, 0);
+    assert!(!scan.is_complete());
+    assert_eq!(scan.diagnostic(), (64, 64, 65_535));
+    let mut budget = 2_000;
+    assert_eq!(scan.advance(&history, &mut budget).unwrap().number, 65_535);
+    assert!(scan.is_complete());
+    assert_eq!(scan.diagnostic(), (1_024, 1_023, 65_535));
+
+    assert!(history.lose(65_535).is_some());
+    let mut scan = history.outstanding_scan();
+    let mut budget = 64;
+    assert_eq!(scan.advance(&history, &mut budget), None);
+    assert_eq!(budget, 64);
+    assert!(scan.is_complete());
+    assert_eq!(scan.diagnostic(), (0, 0, 65_535));
+}
