diff --git a/tmp/unquic-handoff-diagnostic-v2/src/worker/sender/handoff.rs b/src/worker/sender/handoff.rs
new file mode 100644
index 0000000..f005352
--- /dev/null
+++ b/src/worker/sender/handoff.rs
@@ -0,0 +1,201 @@
+//! Temporary handoff diagnostics; timestamps never affect transport decisions.
+use super::*;
+use std::time::Instant;
+
+#[derive(Clone, Copy, Default)]
+pub(super) struct Pending {
+    first: Option<Instant>,
+    count: u64,
+    offsets: u128,
+    invalid: bool,
+}
+
+impl Pending {
+    pub(super) fn push(&mut self, at: Instant) {
+        let first = *self.first.get_or_insert(at);
+        self.count += 1;
+        if let Some(age) = at.checked_duration_since(first) {
+            self.offsets += age.as_nanos();
+        } else {
+            self.invalid = true;
+        }
+    }
+
+    fn take(&mut self, at: Instant) -> (u64, Option<u64>) {
+        let pending = std::mem::take(self);
+        let sum = pending
+            .first
+            .filter(|_| !pending.invalid)
+            .and_then(|first| at.checked_duration_since(first))
+            .and_then(|age| {
+                (age.as_nanos() * u128::from(pending.count)).checked_sub(pending.offsets)
+            })
+            .and_then(|sum| u64::try_from(sum).ok());
+        (pending.count, sum)
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+pub(super) struct Totals {
+    pub(super) queued: u64,
+    pub(super) retries: u64,
+    notified: u64,
+    pub(super) queue_ns: u64,
+    notify_ns: u64,
+    observed: u64,
+    observe_ns: u64,
+    pub(super) censored: u64,
+}
+
+impl Message {
+    pub(super) fn stamp_queued(&mut self) {
+        let stamp = match self {
+            Self::Permit(flight) | Self::Complete(flight) => &mut flight.diagnostic_queued,
+            Self::Report(report) => &mut report.diagnostic_queued,
+            _ => return,
+        };
+        *stamp = Some(Instant::now());
+    }
+
+    pub(super) fn handoff_stamp(
+        &mut self,
+    ) -> Option<(usize, &mut Option<Instant>, Option<Instant>)> {
+        match self {
+            Self::Permit(flight) => {
+                Some((0, &mut flight.diagnostic_handoff, flight.diagnostic_queued))
+            }
+            Self::Complete(flight) => {
+                Some((1, &mut flight.diagnostic_handoff, flight.diagnostic_queued))
+            }
+            Self::Report(report) => {
+                Some((2, &mut report.diagnostic_handoff, report.diagnostic_queued))
+            }
+            _ => None,
+        }
+    }
+}
+
+impl Worker {
+    pub(in crate::worker) fn observe_sender_handoff(&mut self, message: &mut Message) {
+        let Some((kind, stamp, _)) = message.handoff_stamp() else {
+            return;
+        };
+        let Some(queued) = stamp.take() else { return }; // Local messages have no SPSC stamp.
+        let totals = &mut self.sender.handoff_totals[kind];
+        match Instant::now()
+            .checked_duration_since(queued)
+            .and_then(|age| u64::try_from(age.as_nanos()).ok())
+        {
+            Some(age) => {
+                totals.observed = totals.observed.wrapping_add(1);
+                totals.observe_ns = totals.observe_ns.wrapping_add(age);
+            }
+            None => totals.censored = totals.censored.wrapping_add(1),
+        }
+    }
+
+    pub(in crate::worker) fn sender_notification_clock(&self, worker: usize) -> Option<Instant> {
+        self.sender.handoff_pending[worker]
+            .iter()
+            .any(|p| p.count != 0)
+            .then(Instant::now)
+    }
+
+    pub(in crate::worker) fn record_sender_notification(&mut self, worker: usize, at: Instant) {
+        for (pending, totals) in self.sender.handoff_pending[worker]
+            .iter_mut()
+            .zip(&mut self.sender.handoff_totals)
+        {
+            let (count, sum) = pending.take(at);
+            if count == 0 {
+                continue;
+            }
+            if let Some(sum) = sum {
+                totals.notified = totals.notified.wrapping_add(count);
+                totals.notify_ns = totals.notify_ns.wrapping_add(sum);
+            } else {
+                totals.censored = totals.censored.wrapping_add(count);
+            }
+        }
+    }
+
+    pub(in crate::worker) fn publish_sender_handoffs(&mut self) {
+        macro_rules! publish {
+            ($kind:expr, $queued:ident, $queue_ns:ident, $notified:ident, $notify_ns:ident,
+             $observed:ident, $observe_ns:ident, $retry:ident, $censored:ident, $pending:ident) => {
+                let totals = &self.sender.handoff_totals[$kind];
+                self.counters.$queued = totals.queued;
+                self.counters.$queue_ns = totals.queue_ns;
+                self.counters.$notified = totals.notified;
+                self.counters.$notify_ns = totals.notify_ns;
+                self.counters.$observed = totals.observed;
+                self.counters.$observe_ns = totals.observe_ns;
+                self.counters.$retry = totals.retries;
+                self.counters.$censored = totals.censored;
+                self.counters.$pending = self
+                    .sender
+                    .handoff_pending
+                    .iter()
+                    .map(|p| p[$kind].count)
+                    .sum();
+            };
+        }
+        publish!(
+            0,
+            permit_enqueued,
+            permit_queue_ns,
+            permit_notified,
+            permit_notify_ns,
+            permit_observed,
+            permit_observe_ns,
+            permit_enqueue_retries,
+            permit_censored,
+            permit_notify_pending
+        );
+        publish!(
+            1,
+            complete_enqueued,
+            complete_queue_ns,
+            complete_notified,
+            complete_notify_ns,
+            complete_observed,
+            complete_observe_ns,
+            complete_enqueue_retries,
+            complete_censored,
+            complete_notify_pending
+        );
+        publish!(
+            2,
+            report_enqueued,
+            report_queue_ns,
+            report_notified,
+            report_notify_ns,
+            report_observed,
+            report_observe_ns,
+            report_enqueue_retries,
+            report_censored,
+            report_notify_pending
+        );
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn notification_offsets_preserve_each_enqueue_age_and_reset() {
+    let start = Instant::now();
+    let mut pending = Pending::default();
+    pending.push(start);
+    pending.push(start + Duration::from_micros(3));
+    assert_eq!(
+        pending.take(start + Duration::from_micros(10)),
+        (2, Some(17_000))
+    );
+    assert_eq!(pending.take(start + Duration::from_micros(20)), (0, None));
+    pending.push(start + Duration::from_micros(30));
+    assert_eq!(
+        pending.take(start + Duration::from_micros(31)),
+        (1, Some(1_000))
+    );
+    pending.push(start + Duration::from_micros(40));
+    assert_eq!(pending.take(start), (1, None));
+}
