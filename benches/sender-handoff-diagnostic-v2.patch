@@ -1355,3 +1366,58 @@ fn canceled_probe_defers_refill_until_reserved_suffix_drains() {
     workers[1].flush_frames(observed).unwrap();
     assert!(workers[1].sender.job.unwrap().first > job.first + count);
 }
+
+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn handoff_diagnostic_excludes_failed_pushes_and_preserves_early_observation() {
+    let (mut workers, _rx) = workers();
+    let [consumer, producer] = &mut workers;
+    while producer
+        .push(0, Event::Sender(Message::ProbeReplied { group: 0 }))
+        .is_ok()
+    {}
+    let report = producer.sender.report.take().unwrap();
+    producer.sender.queue(0, Message::Report(report)).unwrap();
+    let (_, Message::Report(report)) = producer.sender.outgoing.back_mut().unwrap() else {
+        panic!("missing queued report");
+    };
+    let queued = std::time::Instant::now() - Duration::from_millis(1);
+    report.diagnostic_queued = Some(queued);
+    producer.flush_sender_messages(Duration::ZERO).unwrap();
+    producer.publish_sender_handoffs();
+    assert_eq!(producer.counters.report_enqueue_retries, 1);
+    assert_eq!(producer.counters.report_enqueued, 0);
+    assert_eq!(producer.counters.report_queue_ns, 0);
+    let (_, Message::Report(report)) = producer.sender.outgoing.back().unwrap() else {
+        panic!("missing retried report");
+    };
+    assert_eq!(report.diagnostic_queued, Some(queued));
+    assert_eq!(producer.counters.report_notify_pending, 0);
+    while consumer.incoming[1].as_mut().unwrap().try_pop().is_some() {}
+    producer.flush_sender_messages(Duration::ZERO).unwrap();
+    let Some(Event::Sender(mut message)) = consumer.incoming[1].as_mut().unwrap().try_pop() else {
+        panic!("missing report");
+    };
+    consumer.observe_sender_handoff(&mut message);
+    producer.flush_notifications().unwrap();
+    producer.publish_sender_handoffs();
+    consumer.publish_sender_handoffs();
+    assert_eq!(producer.counters.report_enqueued, 1);
+    assert!(producer.counters.report_queue_ns >= 1_000_000);
+    assert_eq!(consumer.counters.report_queue_ns, 0);
+    assert_eq!(producer.counters.report_notified, 1);
+    assert_eq!(producer.counters.report_notify_pending, 0);
+    assert_eq!(consumer.counters.report_observed, 1);
+    assert_eq!(
+        producer.counters.report_censored + consumer.counters.report_censored,
+        0
+    );
+    // A running consumer can observe before the notification; the residual may be negative.
+    assert!(consumer.counters.report_observe_ns <= producer.counters.report_notify_ns);
+    consumer.observe_sender_handoff(&mut message);
+    consumer.publish_sender_handoffs();
+    assert_eq!(
+        consumer.counters.report_observed, 1,
+        "an unstamped local handoff is excluded"
+    );
+}
