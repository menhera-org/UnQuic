+        let (shared, [mut worker, mut other]) = test_workers_built(3, true, true);
+        let frame = crate::tap::test_common::tcp::frame(false, 1, 1, 0x10, &[], &[7; 100]);
+        assert_eq!(worker.route(0, false, &frame, 1, ms(1000)), (1, None));
+        // The first call only starts a window; a full one publishes the share
+        // not spent blocked, and a part of one publishes nothing.
+        other.note_load(ms(50), ms(1000));
+        assert_eq!(shared.loads[1].load(Ordering::Relaxed), 0);
+        other.note_load(ms(4), ms(1040));
+        assert_eq!(shared.loads[1].load(Ordering::Relaxed), 0);
+        other.note_load(ms(6), ms(1100));
+        assert_eq!(shared.loads[1].load(Ordering::Relaxed), 90);
+        // A wait longer than its window counts as the whole window.
+        worker.note_load(Duration::ZERO, ms(1000));
+        worker.note_load(ms(500), ms(1100));
+        assert_eq!(shared.loads[0].load(Ordering::Relaxed), 0);
+        // The flow stays on lane 1 until that lane's owner has refused frames
+        // for STRIPE_PRESS_MS; then it moves to lane 2, whose worker is idle.
+        assert_eq!(worker.route(0, false, &frame, 1, ms(1100)), (1, None));
+        other.mark_refusal(0, 1, ms(1085));
+        other.mark_refusal(0, 1, ms(1100));
+        assert!(!worker.shifted.get());
+        assert_eq!(worker.route(0, false, &frame, 1, ms(1101)), (2, None));
+        assert!(worker.shifted.take());
+        // It does not move back when lane 2 backs up and lane 1 clears.
+        shared.loads[1].store(5, Ordering::Relaxed);
+        worker.mark_refusal(0, 2, ms(1280));
+        worker.mark_refusal(0, 2, ms(1300));
+        assert_eq!(
+            worker.route(0, false, &frame, 1, ms(1101 + SHIFT_MS)),
+            (2, None)
+        );
+        assert!(!worker.shifted.get());
+        // Another flow on lane 2 moves to lane 1 now.
+        let mut second = frame.clone();
+        second[35] ^= 1;
+        assert_eq!(worker.route(0, false, &second, 1, ms(1300)), (2, None));
+        assert_eq!(worker.route(0, false, &second, 1, ms(1302)), (1, None));
+        assert!(worker.shifted.take());
+    }
