+
+impl Snapshot {
+    pub(crate) fn data_request(&mut self, retained: bool, count: usize, bytes: u64) {
+        let bins = if retained {
+            self.data_retained_requests = self.data_retained_requests.wrapping_add(1);
+            self.data_retained_packets = self.data_retained_packets.wrapping_add(count as u64);
+            self.data_retained_bytes = self.data_retained_bytes.wrapping_add(bytes);
+            [
+                &mut self.data_retained_1,
+                &mut self.data_retained_2_4,
+                &mut self.data_retained_5_8,
+                &mut self.data_retained_9_16,
+                &mut self.data_retained_17_32,
+                &mut self.data_retained_33_64,
+            ]
+        } else {
+            self.data_fresh_requests = self.data_fresh_requests.wrapping_add(1);
+            self.data_fresh_packets = self.data_fresh_packets.wrapping_add(count as u64);
+            self.data_fresh_bytes = self.data_fresh_bytes.wrapping_add(bytes);
+            [
+                &mut self.data_fresh_1,
+                &mut self.data_fresh_2_4,
+                &mut self.data_fresh_5_8,
+                &mut self.data_fresh_9_16,
+                &mut self.data_fresh_17_32,
+                &mut self.data_fresh_33_64,
+            ]
+        };
+        data_size_bin(bins, count);
+    }
+
+    pub(crate) fn data_grant(&mut self, count: usize, bytes: u64) {
+        self.data_grants = self.data_grants.wrapping_add(1);
+        self.data_grant_packets = self.data_grant_packets.wrapping_add(count as u64);
+        self.data_grant_bytes = self.data_grant_bytes.wrapping_add(bytes);
+        data_size_bin(
+            [
+                &mut self.data_grant_1,
+                &mut self.data_grant_2_4,
+                &mut self.data_grant_5_8,
+                &mut self.data_grant_9_16,
+                &mut self.data_grant_17_32,
+                &mut self.data_grant_33_64,
+            ],
+            count,
+        );
+    }
+}
+
+fn data_size_bin(bins: [&mut u64; 6], count: usize) {
+    let index = match count {
+        1 => 0,
+        2..=4 => 1,
+        5..=8 => 2,
+        9..=16 => 3,
+        17..=32 => 4,
+        33..=64 => 5,
+        _ => return,
+    };
+    *bins[index] = bins[index].wrapping_add(1);
+}
+
+#[cfg(test)]
+mod request_size_tests {
+    use super::*;
+
+    #[test]
+    fn bins_keep_fresh_retained_and_granted_counts_separate() {
+        let mut counts = Snapshot::default();
+        for count in 1..=64 {
+            counts.data_request(false, count, count as u64 * 1500);
+            counts.data_grant(count, count as u64 * 1500);
+        }
+        counts.data_request(true, 4, 6000);
+        assert_eq!(counts.data_fresh_requests, 64);
+        assert_eq!(counts.data_fresh_packets, 2080);
+        assert_eq!(counts.data_fresh_bytes, 3_120_000);
+        assert_eq!(
+            [
+                counts.data_fresh_1,
+                counts.data_fresh_2_4,
+                counts.data_fresh_5_8,
+                counts.data_fresh_9_16,
+                counts.data_fresh_17_32,
+                counts.data_fresh_33_64,
+            ],
+            [1, 3, 4, 8, 16, 32]
+        );
+        assert_eq!(
+            [
+                counts.data_grant_1,
+                counts.data_grant_2_4,
+                counts.data_grant_5_8,
+                counts.data_grant_9_16,
+                counts.data_grant_17_32,
+                counts.data_grant_33_64,
+            ],
+            [1, 3, 4, 8, 16, 32]
+        );
+        assert_eq!(counts.data_retained_requests, 1);
+        assert_eq!(counts.data_retained_packets, 4);
+        assert_eq!(counts.data_retained_bytes, 6000);
+        assert_eq!(counts.data_retained_2_4, 1);
+    }
+}
