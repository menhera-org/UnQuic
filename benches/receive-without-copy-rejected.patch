+#[cfg(test)]
+#[test]
+fn split_sums_and_layouts_match_contiguous_frames_at_every_split() {
+    let bytes: Vec<_> = (0..1501).map(|n| (n * 13 + n / 256) as u8).collect();
+    for split in 0..=bytes.len() {
+        let (first, second) = bytes.split_at(split);
+        assert_eq!(
+            fold(sum_split(first, second)),
+            fold(sum(&bytes)),
+            "split {split}"
+        );
+    }
+    let frame = crate::tap::test_common::udp::frame(false, 7, &[0x5a; 1472]);
+    let whole = parse(&frame).unwrap();
+    for split in [0, 41, 255, 256, 257, 1000, frame.len()] {
+        let (head, tail) = frame.split_at(split);
+        // A head too short to hold every header byte is never coalesced.
+        let expected = (split >= HEAD_BYTES).then_some(whole);
+        assert_eq!(transport(Gather { head, tail }), expected, "split {split}");
+    }
+    let mut corrupt = frame.clone();
+    corrupt[1200] ^= 1;
+    let (head, tail) = corrupt.split_at(1000);
+    assert_eq!(transport(Gather { head, tail }), None);
+    // Consecutive frames of one flow coalesce however they are split.
+    let frames: Vec<_> = (0..4)
+        .map(|id| crate::tap::test_common::udp::frame(false, 7 + id, &[id as u8; 1472]))
+        .collect();
+    for split in [300, 1001, 1384, frame.len()] {
+        let gathers: Vec<_> = frames
+            .iter()
+            .map(|frame| {
+                let (head, tail) = frame.split_at(split);
+                Gather { head, tail }
+            })
+            .collect();
+        let (mask, tcp, _) = write(
+            -1,
+            gathers[0],
+            gathers[1..].iter().copied(),
+            1514,
+            (true, true),
+        )
+        .unwrap_or_else(|| panic!("split {split} did not coalesce"));
+        assert_eq!((mask, tcp), (0b1111, false), "split {split}");
+    }
+}
