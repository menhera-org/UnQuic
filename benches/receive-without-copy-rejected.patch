+    fn gro_runs_deliver_frames_from_their_receive_buffer() {
+        let (mut worker, tap) = receive_worker();
+        let frames: Vec<Vec<u8>> = (0..8u8)
+            .map(|seed| {
+                (0..1514)
+                    .map(|i| (i as u8).wrapping_mul(11) ^ seed)
+                    .collect()
+            })
+            .collect();
+        // Pack the frames tail to head into full 1452-byte datagrams, as the
+        // sender does, and lay them back to back as one GRO receive.
+        let mut buffer = worker.free.pop().unwrap();
+        let (mut frame, mut offset, mut number) = (0, 0, 0);
+        let mut length = 0;
+        while frame < frames.len() {
+            let mut records = Vec::new();
+            let mut space = 1452 - wire::HEADER_LEN;
+            while frame < frames.len() && space > 20 {
+                let piece = (1514 - offset).min(space - 20);
+                records.push(Record::Data {
+                    frame_id: (7 << 48) | (frame as u64 + 1),
+                    total_len: 1514,
+                    offset: offset as u32,
+                    bytes: &frames[frame][offset..offset + piece],
+                    offload: false,
+                });
+                space -= 20 + piece;
+                offset += piece;
+                if offset == 1514 {
+                    (frame, offset) = (frame + 1, 0);
+                }
+            }
+            assert!(
+                space == 0 || frame == frames.len(),
+                "a datagram must be full"
+            );
+            number += 1;
+            length += receive_bytes(number, &records, &mut buffer.bytes[length..]);
+        }
+        assert!(number > 8);
+        buffer.length = length;
+        buffer.segment_size = 1452;
+        worker.received.push_back(buffer);
+        while worker.drain_packets(Duration::ZERO).unwrap() {}
+        // Frames keep their pieces in the receive buffer until the TAP flush.
+        assert!(worker.sessions[0].rx[0].as_ref().unwrap().borrows());
+        worker.flush_taps(Duration::ZERO).unwrap();
+        assert!(!worker.sessions[0].rx[0].as_ref().unwrap().borrows());
+        assert!(worker.drained.is_empty() && worker.paused.is_none());
+        let mut output = [0; 2048];
+        for expected in &frames {
+            let n = tap.recv(&mut output).unwrap();
+            assert_eq!(&output[..n], expected.as_slice());
+        }
+        assert_eq!(
+            tap.recv(&mut output).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+        assert_eq!(worker.free.len(), BUFFERS);
