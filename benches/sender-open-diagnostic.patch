+#[derive(Clone, Copy)]
+struct OpenClock {
+    at: Duration,
+    open: bool,
+    reason: usize,
+    paced_until: Option<Duration>,
+    expires: Option<Duration>,
+    totals: [u64; 7],
+}
+
+impl OpenClock {
+    fn account(&mut self, now: Duration) {
+        let end = now.max(self.at);
+        if self.open {
+            let valid_end = self.expires.unwrap_or(end).min(end).max(self.at);
+            if self.reason == 0 {
+                self.totals[0] = self.totals[0].saturating_add(diagnostic_ns(end - self.at));
+            } else {
+                let paced_end = self
+                    .paced_until
+                    .unwrap_or(self.at)
+                    .min(valid_end)
+                    .max(self.at);
+                self.totals[1] = self.totals[1].saturating_add(diagnostic_ns(paced_end - self.at));
+                self.totals[self.reason] =
+                    self.totals[self.reason].saturating_add(diagnostic_ns(valid_end - paced_end));
+                self.totals[5] = self.totals[5].saturating_add(diagnostic_ns(end - valid_end));
+            }
+        }
+        self.at = end;
+    }
+}
