     #[test]
+    fn diagnostic_loss_stamp_preserves_ack_arrival_order_and_detects_aliases() {
+        for received in [2, 3, 4] {
+            for alias in [false, true] {
+                let mut lane = lane();
+                send(&mut lane, 1, 1);
+                lane.force_loss(Duration::from_millis(2));
+                let mut report = Report::new(0);
+                assert!(
+                    lane.advance_report(&mut report, Duration::from_millis(3), &mut 64)
+                        .unwrap()
+                );
+                lane.report_completed(&report).unwrap();
+                if alias {
+                    lane.diag_lost_at[1] = (257, Duration::from_millis(3));
+                }
+                let mut ack = ack(1, 1);
+                ack.received = Duration::from_millis(received);
+                assert!(lane.begin_ack(ack).is_ok());
+                assert!(
+                    lane.advance_report(&mut report, Duration::from_millis(5), &mut 64)
+                        .unwrap()
+                );
+                assert_eq!(lane.diag.diag_late_ack_stamp_miss, u64::from(alias));
+                assert_eq!(lane.diag.diag_late_ack_stamp_match, u64::from(!alias));
+                assert_eq!(
+                    lane.diag.diag_late_ack_before_loss,
+                    u64::from(!alias && received <= 3)
+                );
+                assert_eq!(
+                    lane.diag.diag_late_ack_after_loss,
+                    u64::from(!alias && received > 3)
+                );
+                assert_eq!(lane.diag.diag_late_acks, 1);
+            }
+        }
+    }
