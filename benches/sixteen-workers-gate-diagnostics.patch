+}
+
+pub(crate) fn xlat(loss: bool, sent_ns: u64, bytes: u64) {
+    let now = monotonic_now().map_or(0, |d| d.as_nanos() as u64);
+    let us = now.saturating_sub(sent_ns) / 1000;
+    let bucket = match us {
+        0..=99 => 0,
+        100..=199 => 1,
+        200..=499 => 2,
+        500..=999 => 3,
+        1000..=1999 => 4,
+        2000..=4999 => 5,
+        5000..=9999 => 6,
+        10000..=19999 => 7,
+        _ => 8,
+    };
+    XLAT.with(|x| x.borrow_mut()[usize::from(loss)][bucket] += bytes);
+}
+
+fn xlat_report(id: usize) {
+    XLAT.with(|x| eprintln!("unquic: xlat worker {id} {:?}", x.borrow()));
+}
+
+/// Experiment: receive buffers a worker may hold unprocessed.
+fn rxb() -> usize {
+    if xflag(8) { 32 } else { RECEIVE_BUFFERS }
+}
+
+/// Experiment switches from the UQ_X environment variable (scratch builds only).
+pub(crate) fn xflag(bit: u32) -> bool {
+    static X: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *X.get_or_init(|| {
+        std::env::var("UQ_X")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    }) & bit
+        != 0
+}
