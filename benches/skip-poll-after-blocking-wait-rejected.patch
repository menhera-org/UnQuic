+/// Whether this turn may go on without asking the kernel for events.
+///
+/// A worker woken from a blocking wait usually needs one more turn for what
+/// it found, and four in five of the non-blocking polls between those two
+/// turns found nothing new. Whatever did become ready is still ready when the
+/// worker next waits, at the end of the following turn, blocking or not: only
+/// the first turn after a blocking wait skips, so a busy worker polls as
+/// often as before. `woken` carries whether the last wait blocked.
+fn skip_poll(block: bool, woken: &mut bool) -> bool {
+    let skip = !block && *woken;
+    *woken = block;
+    skip
+}
