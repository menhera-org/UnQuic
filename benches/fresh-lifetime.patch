+    fn fresh_head_deadline_skips_consumed_prefix_and_repair_batch() {
+        let mut store = Store::new(3).unwrap();
+        let source = store.insert_source(buffer(60)).ok().unwrap();
+        let full = store.insert_frame(frame(source, 0..60, 1)).unwrap();
+        let partial = store.insert_frame(frame(source, 0..60, 2)).unwrap();
+        let pending = store.insert_frame(frame(source, 0..60, 3)).unwrap();
+        store.frame_mut(full).unwrap().offset = 60;
+        store.frame_mut(partial).unwrap().offset = 30;
+        let mut batch = super::super::TxBatch::new();
+        batch.len = 4;
+        batch.frames[1] = Some(full);
+        batch.frames[3] = Some(partial);
+        batch.pending.push_back(&mut store, pending).unwrap();
+        assert_eq!(batch.fresh_deadline(&store), Some(Duration::from_millis(2)));
+        batch.repair = true;
+        assert_eq!(batch.fresh_deadline(&store), Some(Duration::from_millis(3)));
+        batch.pending.pop_front(&mut store).unwrap();
+        assert_eq!(batch.fresh_deadline(&store), None);
+        batch.repair = false;
+        assert_eq!(batch.fresh_deadline(&store), Some(Duration::from_millis(2)));
+        store.frame_mut(partial).unwrap().offset = 60;
+        assert_eq!(batch.fresh_deadline(&store), None);
+        store.frame_mut(partial).unwrap().offset = 30;
+        store.frame_mut(pending).unwrap().deadline = Duration::from_millis(1);
+        batch.pending.push_back(&mut store, pending).unwrap();
