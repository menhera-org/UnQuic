+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn fresh_lifetime_guard_ignores_repair_batch_but_checks_pending_originals() {
+    let (mut workers, _rx) = workers();
+    let worker = &mut workers[0];
+    queue_frame(worker, 60);
+    queue_frame(worker, 60);
+    let repair = worker.sessions[0].batches[0]
+        .as_mut()
+        .unwrap()
+        .pending
+        .pop_front(&mut worker.frames)
+        .unwrap()
+        .unwrap();
+    let fresh = worker.sessions[0].batches[0]
+        .as_ref()
+        .unwrap()
+        .pending
+        .front()
+        .unwrap();
+    submit_original(worker, repair, 0..60);
+    worker.frames.frame_mut(repair).unwrap().offset = 60;
+    assert!(worker.frames.recovery_mut(repair).unwrap().lost(0..60, 0));
+    worker.recovery.set(repair, recovery::Place::Batch).unwrap();
+    let batch = worker.sessions[0].batches[0].as_mut().unwrap();
+    batch.repair = true;
+    batch.len = 1;
+    batch.frames[0] = Some(repair);
+    batch.selection[0] = Selection {
+        start: 0,
+        end: 60,
+        attempt: 1,
+    };
+    let now = Duration::from_millis(50);
+    queue_frame_at(worker, 60, now);
+    assert_eq!(worker.counters.tx_fresh_guard_drops, 1);
+    assert_eq!(
+        worker.frames.recovery(repair).unwrap().next_repair(60),
+        Some((0..60, 1))
+    );
+    assert_eq!(
+        worker.sessions[0].batches[0].as_ref().unwrap().frames[0],
+        Some(repair)
+    );
+
+    worker.sessions[0].batches[0]
+        .as_mut()
+        .unwrap()
+        .pending
+        .pop_front(&mut worker.frames)
+        .unwrap();
+    submit_original(worker, fresh, 0..60);
+    worker.frames.frame_mut(fresh).unwrap().offset = 60;
+    worker
+        .recovery
+        .set(fresh, recovery::Place::Retained)
+        .unwrap();
+    queue_frame_at(worker, 60, now);
+    assert_eq!(worker.counters.tx_fresh_guard_drops, 1);
+    assert_eq!(
+        worker.sessions[0].batches[0]
+            .as_ref()
+            .unwrap()
+            .pending
+            .len(),
+        1
+    );
+    assert_eq!(
+        worker.frames.recovery(repair).unwrap().next_repair(60),
+        Some((0..60, 1))
+    );
+    assert_eq!(
+        worker.frames.frame(repair).unwrap().deadline,
+        Duration::from_millis(100)
+    );
+}
