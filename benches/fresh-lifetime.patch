+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn fresh_lifetime_guard_boundary_preserves_partial_original_and_resumes_after_it() {
+    let (mut workers, _rx) = workers();
+    let worker = &mut workers[0];
+    queue_frame(worker, 60);
+    let slot = worker.sessions[0].batches[0]
+        .as_mut()
+        .unwrap()
+        .pending
+        .pop_front(&mut worker.frames)
+        .unwrap()
+        .unwrap();
+    submit_original(worker, slot, 0..30);
+    worker.frames.frame_mut(slot).unwrap().offset = 30;
+    worker.recovery.set(slot, recovery::Place::Batch).unwrap();
+    let batch = worker.sessions[0].batches[0].as_mut().unwrap();
+    batch.len = 3;
+    batch.frames[2] = Some(slot);
+    let boundary = Duration::from_millis(50);
+    queue_frame_at(worker, 60, boundary - Duration::from_nanos(1));
+    let retained = worker.sessions[0].tx_retained;
+    let bytes = worker.sessions[0].tx_bytes;
+    let free = worker.free.len();
+    queue_frame_at(worker, 60, boundary);
+    assert_eq!(worker.counters.tx_fresh_guard_drops, 1);
+    assert_eq!(worker.counters.tx_backlog_drops, 1);
+    assert_eq!(worker.sessions[0].tx_retained, retained);
+    assert_eq!(worker.sessions[0].tx_bytes, bytes);
+    assert_eq!(worker.free.len(), free);
+    assert_eq!(worker.frames.frame(slot).unwrap().offset, 30);
+    assert_eq!(
+        worker.frames.frame(slot).unwrap().deadline,
+        Duration::from_millis(100)
+    );
+    assert_eq!(worker.frames.recovery(slot).unwrap().sent(), 30);
+    assert_eq!(
+        worker.sessions[0].batches[0].as_ref().unwrap().frames[2],
+        Some(slot)
+    );
+    assert_eq!(
+        worker.sessions[0].batches[0]
+            .as_ref()
+            .unwrap()
+            .pending
+            .len(),
+        1
+    );
+
+    submit_original(worker, slot, 30..60);
+    worker.frames.frame_mut(slot).unwrap().offset = 60;
+    // Even an un-compacted completed prefix awaiting ACK cannot trigger the guard.
+    queue_frame_at(worker, 60, boundary);
+    assert_eq!(worker.counters.tx_fresh_guard_drops, 1);
+    assert_eq!(
+        worker.sessions[0].batches[0]
+            .as_ref()
+            .unwrap()
+            .pending
+            .len(),
+        2
+    );
+    assert_eq!(worker.frames.recovery(slot).unwrap().sent(), 60);
+    assert!(worker.frames.recovery(slot).unwrap().remaining() != 0);
+
+    queue_frame_at(&mut workers[1], 60, boundary);
+    assert_eq!(workers[1].counters.tx_backlog_drops, 0);
+    let index = workers[1].sender_index(0, 1).unwrap();
+    assert_eq!(workers[1].sender.lanes[index].unsent_bytes, 60);
+}
