+impl Snapshot {
+    pub(crate) fn record_tx_final_margin(&mut self, elapsed: std::time::Duration) {
+        let counter = match elapsed.as_nanos() {
+            0..=100000 => &mut self.tx_final_margin_100us,
+            100001..=250000 => &mut self.tx_final_margin_250us,
+            250001..=1000000 => &mut self.tx_final_margin_1ms,
+            1000001..=5000000 => &mut self.tx_final_margin_5ms,
+            5000001..=10000000 => &mut self.tx_final_margin_10ms,
+            10000001..=20000000 => &mut self.tx_final_margin_20ms,
+            _ => &mut self.tx_final_margin_over20ms,
+        };
+        *counter = counter.wrapping_add(1);
+    }
+    pub(crate) fn record_ack_apply_age(&mut self, elapsed: std::time::Duration) {
+        let counter = match elapsed.as_nanos() {
+            0..=100000 => &mut self.ack_apply_age_100us,
+            100001..=250000 => &mut self.ack_apply_age_250us,
+            250001..=1000000 => &mut self.ack_apply_age_1ms,
+            1000001..=5000000 => &mut self.ack_apply_age_5ms,
+            5000001..=10000000 => &mut self.ack_apply_age_10ms,
+            10000001..=20000000 => &mut self.ack_apply_age_20ms,
+            _ => &mut self.ack_apply_age_over20ms,
+        };
+        *counter = counter.wrapping_add(1);
+    }
+}
