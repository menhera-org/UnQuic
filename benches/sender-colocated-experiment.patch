+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn colocated_transmit_ownership_keeps_eight_wire_lanes_and_bounded_storage() {
+    let (shared, mut workers) = test_workers_with_layout(8, 8);
+    let rx = ReceiveSocket::bind("[::1]:40001".parse().unwrap(), None).unwrap();
+    assert_eq!(shared.workers(), 8);
+    let params = wire::Params {
+        port: 40000,
+        max_frame_len: 9022,
+        mandatory_features: 0,
+        optional_features: 0,
+    };
+    let connection = Connection {
+        role: handshake::Role::Initiator,
+        initiator: Tag::new(1).unwrap(),
+        responder: Tag::new(2).unwrap(),
+        local: params,
+        peer: wire::Params {
+            port: 40001,
+            ..params
+        },
+        max_frame_len: 9022,
+    };
+    Worker::init_senders(&mut workers).unwrap();
+    for worker in &mut workers {
+        worker.unpaced_fixture = false;
+        let owns = worker.id == 0;
+        assert_eq!(worker.mtu_jobs.len(), if owns { 16 } else { 0 });
+        assert_eq!(worker.frames.available(), 2 * frame_quota(8));
+        assert_eq!(worker.sender.lanes.len(), if owns { 16 } else { 0 });
+        for session in 0..2 {
+            worker
+                .command(
+                    session,
+                    Command {
+                        generation: 1,
+                        phase: Phase::Install,
+                        connection: Some(connection),
+                    },
+                    0,
+                )
+                .unwrap();
+            let local = &worker.sessions[session];
+            assert_eq!(local.tx.len(), 8);
+            assert_eq!(local.tx_workers, 8);
+            for lane in 0..8 {
+                assert_eq!(local.batches[lane].is_some(), owns);
+                assert_eq!(local.tx[lane].is_some(), owns);
+                assert_eq!(
+                    worker.sender_index(session, lane).ok(),
+                    owns.then_some(session * 8 + lane)
+                );
+            }
+        }
+        worker.setup(Duration::from_secs(1)).unwrap();
+        assert_eq!(
+            worker.transmit[0].paths[0]
+                .lanes
+                .iter()
+                .filter(|lane| lane.socket.is_some())
+                .count(),
+            if owns { 8 } else { 0 },
+        );
+        if !owns {
+            let (tx, mut rx) = crate::spsc::channel();
+            worker.outgoing[0] = Some(tx);
+            worker
+                .sender_message(
+                    Message::CheckLoss {
+                        group: 0,
+                        token: 1,
+                        before: Duration::ZERO,
+                        force: false,
+                    },
+                    Duration::ZERO,
+                )
+                .unwrap();
+            worker.service_sender(Duration::ZERO).unwrap();
+            assert!(matches!(rx.try_pop(), Some(Event::Sender(
+                Message::LossChecked {
+                    worker: id, group: 0, token: 1, ..
+                }
+            )) if id == worker.id));
+            assert!(!worker.mtu_timers(Duration::ZERO).unwrap());
+            assert!(worker.deadline(Duration::ZERO).unwrap() > Duration::ZERO);
+        }
+    }
+    assert!(frame_quota(8) * workers.len() <= frames::CAPACITY);
+    assert_eq!(workers[0].pending_receive.len(), 7);
+    for from in 0..workers.len() {
+        for to in 0..workers.len() {
+            if from != to {
+                let (tx, rx) = crate::spsc::channel();
+                workers[from].outgoing[to] = Some(tx);
+                workers[to].incoming[from] = Some(rx);
+            }
+        }
+    }
+    for lane in 0..8 {
+        let worker = &mut workers[0];
+        let mut frame = worker.free.pop().unwrap();
+        frame.session = 0;
+        frame.lane = lane;
+        frame.tag = 1;
+        frame.length = 60;
+        frame.bytes[..60].fill(lane as u8);
+        frame.deadline = Duration::from_secs(1);
+        frame.tx_reserved = true;
+        worker.sessions[0].tx_retained += 1;
+        worker.sessions[0].tx_bytes += 60;
+        worker.input_frame(frame, Duration::ZERO).unwrap();
+    }
+    let mut seen = 0_u8;
+    let mut storage = [0; BASE_UDP_PAYLOAD];
+    for tick in 0..100 {
+        let now = Duration::from_micros(tick * 100);
+        for worker in &mut workers {
+            worker.drain_queues(now).unwrap();
+            worker.service_sender(now).unwrap();
+            worker.flush_frames(now).unwrap();
+        }
+        while let Ok((length, _)) = rx.recv(&mut storage) {
+            let datagram = Datagram::decode(&storage[..length]).unwrap();
+            let header = datagram.header();
+            assert!((1..=8).contains(&header.lane));
+            let lane = (header.lane - 1) as u8;
+            for record in datagram.records() {
+                if let Record::Data {
+                    offset,
+                    total_len,
+                    bytes,
+                    ..
+                } = record
+                {
+                    assert_eq!(offset, 0);
+                    assert_eq!(total_len, 60);
+                    assert_eq!(bytes, &[lane; 60]);
+                    assert_eq!(seen & (1 << lane), 0);
+                    seen |= 1 << lane;
+                }
+            }
+            let range = [crate::wire::AckRange {
+                start: header.packet_number,
+                end: header.packet_number,
+            }];
+            workers[0]
+                .incoming_ack(
+                    0,
+                    1,
+                    header.lane,
+                    0,
+                    crate::wire::AckRanges::new(&range).unwrap(),
+                    now,
+                )
+                .unwrap();
+        }
+    }
+    assert_eq!(seen, u8::MAX);
+    assert!(
+        workers[0]
+            .sender
+            .lanes
+            .iter()
+            .all(|lane| lane.history.inflight_bytes() == 0)
+    );
+    assert_eq!(
+        workers[0]
+            .sender
+            .owner
+            .as_ref()
+            .unwrap()
+            .snapshot(0)
+            .unwrap()
+            .bytes_in_flight,
+        0
+    );
+}
