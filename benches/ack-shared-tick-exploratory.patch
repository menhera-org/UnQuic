@@ -20,6 +20,24 @@ pub(crate) const DELAY: Duration = Duration::from_millis(1);
 /// built: an ACK of more costs the sender a second report round trip.
 const COUNT: u8 = 48;
 
+/// The first multiple of DELAY after `now`: when held feedback falls due.
+///
+/// Every lane of every worker counts from the same clock, so the ACKs a
+/// session's lanes are holding fall due together. They then reach worker 0
+/// in one turn and leave in one datagram, and at the sender they reach the
+/// lanes' workers and the controller owner together, where ACKs each due
+/// DELAY after its own first packet would wake those workers one by one.
+/// Feedback waits DELAY at most, as before, and half of it on average.
+fn tick_after(now: Duration) -> Duration {
+    let tick = DELAY.as_nanos();
+    let next = (now.as_nanos() / tick + 1).saturating_mul(tick);
+    let seconds = next / 1_000_000_000;
+    if seconds > u128::from(u64::MAX) {
+        return Duration::MAX;
+    }
+    Duration::new(seconds as u64, (next % 1_000_000_000) as u32)
+}
+
 pub(crate) struct Schedule {
     pub highest: u64,
     highest_at: Duration,
@@ -50,7 +68,7 @@ impl Schedule {
             self.schedule(if gap || self.eliciting >= COUNT {
                 now
             } else {
-                now.saturating_add(DELAY)
+                tick_after(now)
             });
