+#[test]
+fn recycled_coverage_preserves_repairs_and_acks_across_fresh_word_boundaries() {
+    let mut frame = FrameRecovery::new(MAX_FRAME_LEN).unwrap();
+    for length in [14, 63, 64, 65, 127, 128, 129, 1514, MAX_FRAME_LEN, 14] {
+        for prefix in [1, 13, 63, 64, 65, 127, 128, length - 1] {
+            if prefix >= length {
+                continue;
+            }
+            for old in 0..4 {
+                // Reuse both ACKed and outstanding/lost repair bits from a larger frame.
+                assert!(frame.reset(MAX_FRAME_LEN));
+                assert!(frame.submitted(0..MAX_FRAME_LEN, 0));
+                for attempt in 0..old.min(2) {
+                    assert!(frame.lost(0..MAX_FRAME_LEN, attempt));
+                    assert!(frame.submitted(0..MAX_FRAME_LEN, attempt + 1));
+                }
+                if old == 3 {
+                    assert_eq!(frame.acknowledge(0..MAX_FRAME_LEN, 0), Some(MAX_FRAME_LEN));
+                }
+                assert!(frame.reset(length));
+                assert_eq!(frame.sent(), 0);
+                assert_eq!(frame.remaining(), length);
+                assert_eq!(frame.next_repair(usize::MAX), None);
+                for attempt in 0..=2 {
+                    assert!(!frame.lost(0..1, attempt));
+                    assert_eq!(frame.acknowledge(0..1, attempt), None);
+                }
+                assert!(!frame.submitted(0..0, 0));
+                assert!(!frame.submitted(1..length, 0));
+                assert!(frame.submitted(0..prefix, 0));
+                assert!(!frame.lost(0..prefix, 1));
+                assert_eq!(frame.acknowledge(0..prefix, 1), None);
+                assert_eq!(frame.next_repair(usize::MAX), None);
+
+                assert!(frame.lost(0..prefix, 0));
+                assert!(frame.submitted(0..prefix, 1));
+                let acked = prefix / 2;
+                if acked != 0 {
+                    assert_eq!(frame.acknowledge(0..acked, 0), Some(acked));
+                }
+                assert!(frame.lost(0..prefix, 1));
+                assert_eq!(frame.next_repair(usize::MAX), Some((acked..prefix, 2)));
+
+                // Fresh continuation can share a word with repaired and ACKed bytes.
+                assert!(frame.submitted(prefix..length, 0));
+                assert_eq!(frame.remaining(), length - acked);
+                assert_eq!(frame.next_repair(usize::MAX), Some((acked..prefix, 2)));
+                assert!(frame.submitted(acked..prefix, 2));
+                assert!(frame.lost(0..prefix, 0));
+                assert_eq!(frame.next_repair(usize::MAX), None);
+                assert!(frame.lost(prefix..length, 0));
+                assert_eq!(frame.next_repair(usize::MAX), Some((prefix..length, 1)));
+                assert_eq!(frame.acknowledge(0..prefix, 0), Some(prefix - acked));
+                assert!(!frame.can_submit(acked..prefix, 2));
+                assert!(frame.submitted(prefix..length, 1));
+                assert_eq!(frame.acknowledge(0..length, 0), Some(length - prefix));
+                assert_eq!(frame.remaining(), 0);
+                assert_eq!(frame.next_repair(usize::MAX), None);
+            }
+        }
+    }
+}
