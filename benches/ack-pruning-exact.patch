+#[test]
+fn ack_pruning_counts_only_successful_snapshots_and_preserves_late_arrivals() {
+    use unquic::wire::{AckRange, MAX_ACK_RANGES};
+    let mut lane = Lane::new(1, 1514).unwrap();
+    for number in [1, 3] {
+        assert_eq!(
+            admit(&mut lane, number, &[Record::Probe], Duration::ZERO),
+            Admission::Fresh
+        );
+    }
+    let mut output = [AckRange { start: 0, end: 0 }; MAX_ACK_RANGES];
+    let Some(Record::Ack { ranges, .. }) = lane.take_ack(Duration::ZERO, &mut output) else {
+        panic!("missing initial ACK");
+    };
+    assert_eq!(
+        admit(&mut lane, 2, &[Record::Probe], Duration::from_micros(1)),
+        Admission::Fresh
+    );
+    lane.ack_transmitted(Duration::from_micros(2), ranges);
+    let all = [AckRange { start: 1, end: 3 }];
+    // A cancelled/failed submission contributes no repetition.
+    assert_eq!(repeated_ack(&mut lane, 3, 10, false), all);
+    assert_eq!(repeated_ack(&mut lane, 3, 20, true), all);
+    assert_eq!(repeated_ack(&mut lane, 3, 30, true), all);
+    // Packet 2 was absent from the delayed first snapshot and needs one more ACK.
+    assert_eq!(
+        repeated_ack(&mut lane, 3, 40, true),
+        [AckRange { start: 2, end: 3 }]
+    );
+    assert_eq!(
+        repeated_ack(&mut lane, 3, 50, true),
+        [AckRange { start: 3, end: 3 }]
+    );
+    assert_eq!(lane.lower_bounds().0, 1);
+    assert_eq!(
+        admit(&mut lane, 1, &[Record::Probe], Duration::from_millis(60)),
+        Admission::Duplicate
+    );
+
+    assert_eq!(
+        admit(&mut lane, 5, &[Record::Probe], Duration::from_millis(60)),
+        Admission::Fresh
+    );
+    for millis in [70, 80, 90] {
+        repeated_ack(&mut lane, 5, millis, true);
+    }
+    // A late fresh packet remains ACK-eligible below pruned packet numbers.
+    assert_eq!(
+        admit(&mut lane, 4, &[Record::Probe], Duration::from_millis(100)),
+        Admission::Fresh
+    );
+    for millis in [110, 120, 130] {
+        assert_eq!(
+            repeated_ack(&mut lane, 5, millis, true),
+            [AckRange { start: 4, end: 5 }]
+        );
+    }
+    assert_eq!(
+        repeated_ack(&mut lane, 5, 140, true),
+        [AckRange { start: 5, end: 5 }]
+    );
+}
