+fn repeated_ack(
+    lane: &mut Lane,
+    highest: u64,
+    millis: u64,
+    transmitted: bool,
+) -> Vec<unquic::wire::AckRange> {
+    use unquic::wire::{AckRange, MAX_ACK_RANGES};
+    let now = Duration::from_millis(millis);
+    assert_eq!(
+        admit(lane, highest, &[Record::Probe], now),
+        Admission::Duplicate
+    );
+    let mut output = [AckRange { start: 0, end: 0 }; MAX_ACK_RANGES];
+    let Some(Record::Ack { ranges, .. }) =
+        lane.take_ack(now + Duration::from_millis(1), &mut output)
+    else {
+        panic!("missing repeated ACK");
+    };
+    if transmitted {
+        lane.ack_transmitted(now + Duration::from_millis(1), ranges);
+    }
+    ranges.iter().collect()
+}
