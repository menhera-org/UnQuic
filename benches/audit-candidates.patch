+
+    assert_eq!(
+        admit(&mut lane, 5, &[Record::Probe], Duration::from_millis(60)),
+        Admission::Fresh
+    );
+    for millis in [70, 80, 90] {
+        repeated_ack(&mut lane, 5, millis, true);
+    }
+    // A late fresh packet remains ACK-eligible below pruned packet numbers.
+    assert_eq!(
+        admit(&mut lane, 4, &[Record::Probe], Duration::from_millis(100)),
+        Admission::Fresh
+    );
+    for millis in [110, 120, 130] {
