+#[test]
+fn delayed_ack_reports_do_not_charge_recycled_window_bits() {
+    use unquic::wire::{AckRange, MAX_ACK_RANGES};
+    let mut lane = Lane::new(1, 1514).unwrap();
+    for number in 1..=130 {
+        admit(&mut lane, number, &[Record::Probe], Duration::ZERO);
+    }
+    let mut output = [AckRange { start: 0, end: 0 }; MAX_ACK_RANGES];
+    let Some(Record::Ack { ranges, .. }) = lane.take_ack(Duration::ZERO, &mut output) else {
+        panic!("missing initial ACK");
+    };
+    let high = WINDOW_LEN as u64 + 130;
+    for number in high - 129..=high {
+        admit(
+            &mut lane,
+            number,
+            &[Record::Probe],
+            Duration::from_millis(1),
+        );
+    }
+    lane.ack_transmitted(Duration::from_millis(2), ranges);
+    for millis in [10, 20, 30] {
+        assert_eq!(
+            repeated_ack(&mut lane, high, millis, true),
+            [AckRange {
+                start: high - 129,
+                end: high
+            },]
+        );
+    }
+    assert_eq!(
+        repeated_ack(&mut lane, high, 40, true),
+        [AckRange {
+            start: high,
+            end: high
+        }]
+    );
+    for number in u64::MAX - 129..=u64::MAX {
+        admit(
+            &mut lane,
+            number,
+            &[Record::Probe],
+            Duration::from_millis(50),
+        );
+    }
+    for millis in [60, 70, 80] {
+        assert_eq!(
+            repeated_ack(&mut lane, u64::MAX, millis, true),
+            [AckRange {
+                start: u64::MAX - 129,
+                end: u64::MAX
+            },]
+        );
+    }
+    assert_eq!(
+        repeated_ack(&mut lane, u64::MAX, 90, true),
+        [AckRange {
+            start: u64::MAX,
+            end: u64::MAX
+        },]
+    );
+}
