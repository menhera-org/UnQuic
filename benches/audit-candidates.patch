+#[test]
+fn safe_prefix_recycles_before_later_grants_and_feedback_closes_rolling_issuance() {
+    let (mut sender, flights) = Sender::new(1, 3, 6).unwrap();
+    let mut flights = buffers(flights);
+    let mut spare = flights.pop().unwrap();
+    let mut b = flights.pop().unwrap();
+    let mut a = flights.pop().unwrap();
+    let first = packet(0, 1, 100);
+    let later = packet(1, 1, 200);
+    let middle = packet(0, 2, 300);
+    a.prepare(&[first]).unwrap();
+    b.prepare(&[later]).unwrap();
+    spare.prepare(&[packet(2, 1, 100)]).unwrap();
+    sender.reserve(0, &mut a, false, limits(), us(0)).unwrap();
+    let first_handle = a.handle(0).unwrap();
+    sender.reserve(0, &mut b, false, limits(), us(10)).unwrap();
+    let later_handle = b.handle(0).unwrap();
+    a.complete(1, Some(us(1)), false).unwrap();
+    sender.reported(a).unwrap();
+    let mut a = commit(&mut sender, 0);
+    assert_eq!(sender.flight_bytes(0), Some((200, 100)));
+    assert!(!sender.feedback_ready(0));
+    a.prepare(&[middle]).unwrap();
+    sender.reserve(0, &mut a, false, limits(), us(20)).unwrap();
+    let middle_handle = a.handle(0).unwrap();
+    b.complete(1, Some(us(30)), false).unwrap();
+    sender.reported(b).unwrap();
+    assert!(sender.advance(0, 64).unwrap().is_none());
+    sender.close(0).unwrap();
+    assert_eq!(
+        sender.reserve(0, &mut spare, false, limits(), us(31)),
+        Err(Error::Blocked)
+    );
+    assert_eq!(sender.begin_ack(0, us(100), false), Err(Error::Blocked));
+    a.complete(1, Some(us(21)), false).unwrap();
+    sender.reported(a).unwrap();
+    let a = commit(&mut sender, 0);
+    assert_eq!(a.worker(), 0);
+    let b = commit(&mut sender, 0);
+    assert_eq!(b.worker(), 1);
+    assert!(sender.feedback_ready(0));
+    for (index, (packet, handle, flight)) in [
+        (first, first_handle, 100),
+        (middle, middle_handle, 400),
+        (later, later_handle, 600),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let sample = acknowledge(&mut sender, 0, packet, handle, 100 + index as u64);
+        assert_eq!(
+            (sample.last_packet, sample.tx_in_flight),
+            (index as u64 + 1, flight)
+        );
+    }
+    assert_eq!(sender.flight_bytes(0), Some((0, 0)));
+    sender.reopen(0).unwrap();
+    sender
+        .reserve(0, &mut spare, false, limits(), us(103))
+        .unwrap();
+}
