+    let mut lane = Lane::new(1, 1514).unwrap();
+    for number in [1, 3] {
+        assert_eq!(
+            admit(&mut lane, number, &[Record::Probe], Duration::ZERO),
+            Admission::Fresh
+        );
+    }
+    let mut output = [AckRange { start: 0, end: 0 }; MAX_ACK_RANGES];
+    let Some(Record::Ack { ranges, .. }) = lane.take_ack(Duration::ZERO, &mut output) else {
+        panic!("missing initial ACK");
+    };
+    assert_eq!(
+        admit(&mut lane, 2, &[Record::Probe], Duration::from_micros(1)),
+        Admission::Fresh
+    );
+    lane.ack_transmitted(Duration::from_micros(2), ranges);
+    let all = [AckRange { start: 1, end: 3 }];
+    // A cancelled/failed submission contributes no repetition.
+    assert_eq!(repeated_ack(&mut lane, 3, 10, false), all);
+    assert_eq!(repeated_ack(&mut lane, 3, 20, true), all);
+    assert_eq!(repeated_ack(&mut lane, 3, 30, true), all);
+    // Packet 2 was absent from the delayed first snapshot and needs one more ACK.
+    assert_eq!(
+        repeated_ack(&mut lane, 3, 40, true),
