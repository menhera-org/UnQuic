+#[test]
+fn rolling_commits_match_chronological_sampler_for_all_short_orders_and_prefixes() {
+    use unquic::bbr::Delivery;
+    let permutations = [
+        [0, 1, 2],
+        [0, 2, 1],
+        [1, 0, 2],
+        [1, 2, 0],
+        [2, 0, 1],
+        [2, 1, 0],
+    ];
+    for counts in 0..27 {
+        for times in 0..27 {
+            for order in permutations {
+                let (mut sender, flights) = Sender::new(1, 3, 6).unwrap();
+                let flights: [Box<Flight>; 3] = flights.into_vec().try_into().unwrap();
+                let mut flights = flights.map(Some);
+                let plans: [[Planned; 2]; 3] = std::array::from_fn(|worker| {
+                    std::array::from_fn(|ordinal| {
+                        packet(
+                            worker as u16,
+                            ordinal as u64 + 1,
+                            100 + worker as u16 * 50 + ordinal as u16 * 25,
+                        )
+                    })
+                });
+                let successful: [usize; 3] =
+                    std::array::from_fn(|worker| counts / 3_usize.pow(worker as u32) % 3);
+                let starts: [Duration; 3] = std::array::from_fn(|worker| {
+                    us((worker * 10 + times / 3_usize.pow(worker as u32) % 3 * 10) as u64)
+                });
+                let mut handles = [[None; 2]; 3];
+                for (worker, slot) in flights.iter_mut().enumerate() {
+                    let flight = slot.as_mut().unwrap();
+                    flight.prepare(&plans[worker]).unwrap();
+                    sender
+                        .reserve(0, flight, false, limits(), us(worker as u64 * 10))
+                        .unwrap();
+                    handles[worker] = [flight.handle(0), flight.handle(1)];
+                    flight
+                        .complete(
+                            successful[worker],
+                            (successful[worker] != 0).then_some(starts[worker]),
+                            worker == 1,
+                        )
+                        .unwrap();
+                }
+                for (arrival, worker) in order.into_iter().enumerate() {
+                    sender.reported(flights[worker].take().unwrap()).unwrap();
+                    for _ in 0..6 {
+                        if let Some(flight) = sender.advance(0, 1).unwrap() {
+                            let worker = flight.worker();
+                            assert!(flights[worker].is_none());
+                            flights[worker] = Some(flight);
+                        }
+                    }
+                    assert_eq!(sender.feedback_ready(0), arrival == 2);
+                }
+                let mut chronology = Vec::new();
+                for (worker, &count) in successful.iter().enumerate() {
+                    for ordinal in 0..count {
+                        chronology.push((starts[worker], worker, ordinal));
+                    }
+                }
+                chronology.sort_unstable();
+                let mut reference = Delivery::new();
+                let mut inflight = 0;
+                let mut expected = Vec::new();
+                for (at, worker, ordinal) in chronology {
+                    let plan = plans[worker][ordinal];
+                    let sample = reference
+                        .sent(at, plan.bytes, inflight, worker == 1)
+                        .unwrap();
+                    inflight += u64::from(plan.bytes);
+                    expected.push((worker, ordinal, sample));
+                }
+                assert_eq!(sender.flight_bytes(0), Some((0, inflight)));
+                for (index, (worker, ordinal, mut packet)) in expected.into_iter().rev().enumerate()
+                {
+                    let at = 100 + index as u64;
+                    reference.begin_ack(us(at), false).unwrap();
+                    reference.acknowledged(&mut packet).unwrap();
+                    let sample = acknowledge(
+                        &mut sender,
+                        0,
+                        plans[worker][ordinal],
+                        handles[worker][ordinal].unwrap(),
+                        at,
+                    );
+                    assert_eq!(
+                        Some(sample),
+                        reference.finish_ack(Duration::ZERO).unwrap(),
+                        "counts={counts}, times={times}, order={order:?}"
+                    );
+                }
+                assert_eq!(sender.flight_bytes(0), Some((0, 0)));
+                assert_eq!(sender.available(), 6);
+            }
+        }
+    }
 }
 
