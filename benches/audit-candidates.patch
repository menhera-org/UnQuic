+#[test]
+fn delayed_ack_report_counts_only_the_surviving_part_of_its_snapshot() {
+    use unquic::wire::{AckRange, MAX_ACK_RANGES};
+    let mut lane = Lane::new(1, 1514).unwrap();
+    for number in 1..=130 {
+        admit(&mut lane, number, &[Record::Probe], Duration::ZERO);
+    }
+    let mut output = [AckRange { start: 0, end: 0 }; MAX_ACK_RANGES];
+    let Some(Record::Ack { ranges, .. }) = lane.take_ack(Duration::ZERO, &mut output) else {
+        panic!("missing initial ACK");
+    };
+    let alias = WINDOW_LEN as u64 + 1;
+    let highest = WINDOW_LEN as u64 + 64;
+    for number in [alias, highest] {
+        assert_eq!(
+            admit(
+                &mut lane,
+                number,
+                &[Record::Probe],
+                Duration::from_millis(1),
+            ),
+            Admission::Fresh,
+        );
+    }
+    assert_eq!(lane.lower_bounds().0, 65);
+    lane.ack_transmitted(Duration::from_millis(2), ranges);
+    let newer = [
+        AckRange {
+            start: highest,
+            end: highest,
+        },
+        AckRange {
+            start: alias,
+            end: alias,
+        },
+    ];
+    for millis in [10, 20] {
+        assert_eq!(
+            repeated_ack(&mut lane, highest, millis, true),
+            [
+                newer[0],
+                newer[1],
+                AckRange {
+                    start: 65,
+                    end: 130
+                }
+            ],
+        );
+    }
+    // Surviving old packets have three reports; recycled aliases have only two.
+    assert_eq!(repeated_ack(&mut lane, highest, 30, true), newer);
+    assert_eq!(repeated_ack(&mut lane, highest, 40, true), [newer[0]],);
+}
