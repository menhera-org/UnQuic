+    lane.reset(1, 1514).unwrap();
+    for number in [1, 3] {
+        admit(&mut lane, number, &[Record::Probe], Duration::ZERO);
+    }
+    assert_eq!(
+        repeated_ack(&mut lane, 3, 10, true),
+        [AckRange { start: 3, end: 3 }, AckRange { start: 1, end: 1 },]
+    );
+}
