+/// One sent packet's frame pieces when it has at most INLINE of them, the
+/// common case for full-size frames: no journal nodes or frame lists.
+///
+/// Inline pieces do not pin their frame slot. Each records the slot's
+/// generation when reserved; cleanup bumps the generation when it frees the
+/// slot, so a piece that outlives its frame is recognised as stale and
+/// skipped, even if the frame ID repeats on a later connection.
+#[derive(Clone, Copy, Default)]
+struct InlinePacket {
+    pieces: [InlinePiece; INLINE],
+    count: u8,
+}
+
+/// A FramePiece without its frame ID: the generation names the slot's
+/// occupancy, and the slot holds that occupancy's ID.
+#[derive(Clone, Copy, Default)]
+struct InlinePiece {
+    generation: u32,
+    slot: u16,
+    start: u16,
+    end: u16,
+    attempt: u8,
+}
 
