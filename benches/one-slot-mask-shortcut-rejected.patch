+/// The mask of `span` slots from `slot`. Nearly every frame holds one slot,
+/// whose bit takes a 64-bit shift instead of two 128-bit ones.
+const fn slots(slot: usize, span: u8) -> u128 {
+    if span != 1 {
+        return run(span) << slot;
+    }
+    let bit = (1_u64 << (slot % 64)) as u128;
+    if slot < 64 { bit } else { bit << 64 }
+}
+
 /// Reserves `span` free slots: the lowest free slot for a one-slot frame, the
 /// highest free run for a longer one, so the two rarely fragment each other.
