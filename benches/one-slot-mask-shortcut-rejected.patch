+        let run = run(span);
         (0..=FRAME_CAPACITY - usize::from(span))
             .rev()
             .find(|&slot| *reserved & (run << slot) == 0)
     }?;
-    *reserved |= run << slot;
+    *reserved |= slots(slot, span);
     Some(slot)
 }
 
