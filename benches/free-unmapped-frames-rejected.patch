+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn acknowledged_frames_without_other_mappings_free_without_a_cleanup_pass() {
+    let (mut workers, _rx) = workers();
+    let worker = &mut workers[1];
+    for _ in 0..4 {
+        queue_frame(worker, 60);
+    }
+    let slots: Vec<_> = worker.sessions[0].batches[1]
+        .as_ref()
+        .unwrap()
+        .pending
+        .iter(&worker.frames)
+        .collect();
+    let mut pieces = [crate::ack::FramePiece::default(); 4];
+    for (piece, &index) in pieces.iter_mut().zip(&slots) {
+        let frame = worker.frames.frame(index).unwrap();
+        *piece = crate::ack::FramePiece {
+            frame_slot: index as u16,
+            frame_id: frame.id,
+            start: 0,
+            end: 60,
+            attempt: 0,
+        };
+        submit_original(worker, index, 0..60);
+    }
+    // Packet 0 carries all four frames; packet 1 another copy of the last.
+    assert!(worker.recovery.journal.reserve_packet(0, &pieces));
+    assert!(worker.recovery.journal.reserve_packet(1, &pieces[3..]));
+    for handle in 1..=2 {
+        assert_eq!(worker.sender.records.take().unwrap().get(), handle);
+    }
+    let mut report = worker.sender.report.take().unwrap();
+    report.kind = ReportKind::Ack {
+        received: Duration::from_millis(2),
+        delay_us: 0,
+        first: true,
+        end: None,
+    };
+    report.count = 1;
+    report.entries[0] = Entry {
+        number: 1,
+        sample: NonZeroU16::new(1),
+        settled: true,
+        ..Entry::default()
+    };
+    worker.recovery.staged = Some(report);
+    assert!(!worker.stage_recovery().unwrap());
+    // The three frames only packet 0 mapped are gone without a cleanup pass;
+    // the fourth is acknowledged too but waits for packet 1's mapping.
+    assert!(
+        slots[..3]
+            .iter()
+            .all(|&slot| worker.frames.frame(slot).is_none())
+    );
+    assert_eq!(worker.frames.recovery(slots[3]).unwrap().remaining(), 0);
+    assert_eq!(worker.sessions[0].tx_retained, 1);
+    assert_eq!(worker.counters.recovery_cleanup_peak, 1);
+    assert!(worker.recovery.has_cleanup());
+    assert!(worker.recovery.journal.pop_packet(1).is_some());
+    while worker.cleanup_frames().unwrap() {}
+    assert!(worker.frames.frame(slots[3]).is_none());
+    assert_eq!(worker.sessions[0].tx_retained, 0);
+}
