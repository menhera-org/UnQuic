+            assert_eq!(replacement.expires, now + LIFETIME);
+            assert_eq!(worker.counters.abandon_evicted, 1);
+            assert_eq!(worker.sessions[0].totals.abandon_evicted, 1);
+            assert_eq!(worker.sessions[0].tx_totals[0].abandon_evicted, 1);
