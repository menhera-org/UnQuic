+                    .flatten()
+                    .all(|a| a.expires == LIFETIME)
+            );
+            pump(worker, at);
+            assert_eq!(seen, u128::MAX);
+            assert_eq!(datagrams, 2);
+            assert_eq!(worker.counters.abandon_sent, 128);
+            assert_eq!(worker.counters.abandon_datagrams, 2);
+            assert_eq!(worker.counters.abandon_retried, 0);
+            assert_eq!(worker.counters.abandon_evicted, 1);
+            assert_eq!(worker.sender.lanes[0].history.inflight_bytes(), 0);
+        });
