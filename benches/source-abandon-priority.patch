+            worker.flush_sender_messages(now).unwrap();
+            assert!(worker.sender.job.is_none());
+            worker.queue_abandon(0, 0, (1 << 48) | 130, true, now);
+            assert!(worker.sender.abandons.get(0, selected_serial).is_none());
