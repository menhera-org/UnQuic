+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn selected_full_victim_cancels_stale_grant_and_rebuilds_all_live_records() {
+        let (mut workers, rx) = setup();
+        let worker = &mut workers[0];
+        for id in 1..=128 {
+            worker.queue_abandon(0, 0, (1 << 48) | id, id > 64, Duration::ZERO);
+        }
+        let now = Duration::from_millis(6);
+        let job = permit(worker, now);
+        let old = worker.sender.abandons.entries[0].unwrap();
+        without_allocations(|| {
+            worker.queue_abandon(0, 0, (1 << 48) | 129, true, now);
+            assert!(worker.sender.abandons.get(0, old.serial).is_none());
+            worker.use_sender_permit(now).unwrap();
+            empty(&rx);
+            assert_eq!(worker.counters.abandon_sent, 0);
+            assert_eq!(worker.sender.lanes[0].history.inflight_bytes(), 0);
+            assert!(worker.sender.lanes[0].history.packet(job.first).is_none());
+            assert!(
+                worker
+                    .sender
+                    .abandons
+                    .entries
+                    .iter()
+                    .flatten()
+                    .all(|a| a.attempts == 0)
+            );
+            let mut seen = 0_u128;
+            let mut datagrams = 0;
+            let mut bytes = [0; BASE_UDP_PAYLOAD];
+            let mut at = Duration::from_millis(12);
+            // Ordinary pacing may space the two grants. ACK each submitted
+            // packet while advancing time, keeping retries out of this fixture.
+            while seen != u128::MAX && at < Duration::from_millis(50) {
+                pump(worker, at);
+                loop {
+                    let length = match rx.recv(&mut bytes) {
+                        Ok((length, _)) => length,
+                        Err(error) if error.kind() == io::ErrorKind::WouldBlock => break,
+                        Err(error) => panic!("{error}"),
+                    };
+                    let packet = Datagram::decode(&bytes[..length]).unwrap();
+                    let number = packet.header().packet_number;
+                    assert!(number > job.first);
+                    for record in packet.records() {
+                        let Record::FrameAbandon { frame_id, .. } = record else {
+                            panic!("unexpected record")
+                        };
+                        let id = frame_id & 0x0000_ffff_ffff_ffff;
+                        assert!((2..=129).contains(&id));
+                        let bit = 1_u128 << (id - 2);
+                        assert_eq!(seen & bit, 0);
+                        seen |= bit;
