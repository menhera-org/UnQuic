+            worker.queue_abandon(0, 0, (1 << 48) | 129, true, now);
+            assert_eq!(worker.sender.abandons.count, CAPACITY);
+            assert_eq!(
+                worker.sender.abandons.entries[0].unwrap().serial,
+                selected_serial
