+#[cfg(test)]
+mod open_clock_tests {
+    use super::*;
+    fn ns(value: u64) -> Duration {
+        Duration::from_nanos(value)
+    }
+    fn clock(reason: usize) -> OpenClock {
+        OpenClock {
+            at: ns(10),
+            open: true,
+            reason,
+            paced_until: Some(ns(20)),
+            expires: None,
+            totals: [0; 7],
+        }
+    }
+
+    #[test]
+    fn waiting_splits_at_pacer_and_expiry_without_double_counting() {
+        let mut c = clock(2);
+        c.expires = Some(ns(30));
+        c.account(ns(15));
+        assert_eq!(c.totals, [0, 5, 0, 0, 0, 0, 0]);
+        c.account(ns(25));
+        assert_eq!(c.totals, [0, 10, 5, 0, 0, 0, 0]);
+        let mut snapshot = c;
+        snapshot.account(ns(40));
+        assert_eq!(snapshot.totals, [0, 10, 10, 0, 0, 10, 0]);
+        assert_eq!(c.totals, [0, 10, 5, 0, 0, 0, 0]);
+        c.account(ns(40));
+        assert_eq!(c.totals, snapshot.totals);
+        c.account(ns(39));
+        assert_eq!(c.totals, snapshot.totals);
+    }
+
+    #[test]
+    fn expired_request_is_actionable_even_before_pacer_opens() {
+        let mut c = clock(2);
+        c.expires = Some(ns(15));
+        c.account(ns(25));
+        assert_eq!(c.totals, [0, 5, 0, 0, 0, 10, 0]);
+    }
+
+    #[test]
+    fn no_request_and_closed_intervals_do_not_count_pacing() {
+        let mut c = clock(0);
+        c.account(ns(100));
+        assert_eq!(c.totals, [90, 0, 0, 0, 0, 0, 0]);
+        c.open = false;
+        c.account(ns(200));
+        assert_eq!(c.totals, [90, 0, 0, 0, 0, 0, 0]);
+        c.open = true;
+        c.reason = 5;
+        c.account(ns(210));
+        assert_eq!(c.totals, [90, 0, 0, 0, 0, 10, 0]);
+    }
+}
