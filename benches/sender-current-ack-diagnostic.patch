+    use super::*;
+    #[test]
+    fn socket_receive_age_is_separate_from_cached_admission_clock() {
+        let mut schedule = Schedule::new();
+        schedule.accepted(2, true, Duration::from_micros(100));
+        schedule.diagnostic_received(2, Duration::from_micros(50));
+        assert_eq!(
+            schedule.diagnostic(Duration::from_micros(200)),
+            [2, 1, 100_000, 100_000, 100_000, 150_000, 150_000]
+        );
+        schedule.accepted(3, false, Duration::from_micros(120));
+        schedule.diagnostic_received(3, Duration::from_micros(90));
+        assert_eq!(
+            schedule.diagnostic(Duration::from_micros(200)),
+            [2, 1, 80_000, 100_000, 100_000, 110_000, 150_000]
+        );
+        assert!(schedule.take(Duration::from_micros(200)).is_some());
+        assert_eq!(
+            &schedule.diagnostic(Duration::from_micros(210))[5..],
+            &[120_000, 0]
+        );
+    }
+}
