+    // Temporary diagnostic: one cookie/tag identity, lanes 1..=64 per reader.
+    // Counts all decoded datagrams; older duplicates also count as reordered.
+    // No admission state is changed. These are raw socket arrival counters.
+    fn diagnose_raw_receive(&mut self, bytes: &[u8], segment_size: usize) {
+        let size = if segment_size == 0 { bytes.len().max(1) } else { segment_size };
+        self.counters.diag_raw_buffers = self.counters.diag_raw_buffers.wrapping_add(1);
+        self.counters.diag_raw_gro_buffers = self.counters.diag_raw_gro_buffers
+            .wrapping_add(u64::from(segment_size != 0));
+        for segment in bytes.chunks(size) {
+            let Ok(datagram) = Datagram::decode(segment) else {
+                self.counters.diag_raw_malformed = self.counters.diag_raw_malformed.wrapping_add(1);
+                continue;
+            };
+            let header = datagram.header();
+            if header.lane == 0 {
+                continue;
+            }
+            let identity = (header.cookie, header.receive_tag);
+            let tracked = self.diag_raw_identity.get_or_insert(identity);
+            let lane = usize::from(header.lane) - 1;
+            if *tracked != identity || lane >= 64 {
+                self.counters.diag_raw_scope_skip = self.counters.diag_raw_scope_skip.wrapping_add(1);
+                continue;
+            }
+            let cookie = header.cookie.as_bytes();
+            let cookie_low = u32::from_be_bytes([cookie[12], cookie[13], cookie[14], cookie[15]]);
+            let expected = cookie_low.wrapping_add(lane as u32) as usize % self.shared.workers();
+            self.counters.diag_raw_owner_mismatch = self.counters.diag_raw_owner_mismatch
+                .wrapping_add(u64::from(expected != self.id));
+            let high = &mut self.diag_raw_highest[lane];
+            let lag = high.saturating_sub(header.packet_number);
+            self.counters.diag_raw_equal_highest = self.counters.diag_raw_equal_highest
+                .wrapping_add(u64::from(header.packet_number == *high));
+            *high = (*high).max(header.packet_number);
+            let totals = &mut self.counters;
+            if datagram.records().any(|record| matches!(record, Record::Data { .. })) {
+                totals.diag_raw_data_received = totals.diag_raw_data_received.wrapping_add(1);
+                totals.diag_raw_data_reordered = totals.diag_raw_data_reordered.wrapping_add(u64::from(lag != 0));
+                totals.diag_raw_data_reorder_lag = totals.diag_raw_data_reorder_lag.wrapping_add(lag);
+                totals.diag_raw_data_reorder_lag_max = totals.diag_raw_data_reorder_lag_max.max(lag);
+            } else {
+                totals.diag_raw_control_received = totals.diag_raw_control_received.wrapping_add(1);
+                totals.diag_raw_control_reordered = totals.diag_raw_control_reordered.wrapping_add(u64::from(lag != 0));
+                totals.diag_raw_control_reorder_lag = totals.diag_raw_control_reorder_lag.wrapping_add(lag);
+                totals.diag_raw_control_reorder_lag_max = totals.diag_raw_control_reorder_lag_max.max(lag);
+            }
+        }
+    }
