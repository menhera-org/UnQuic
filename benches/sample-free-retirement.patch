+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn retirement_continues_beyond_lane_visit_budget_without_spinning_on_owned_reports() {
+    let (mut workers, _rx) = workers();
+    let worker = &mut workers[1];
+    // Empty histories isolate the scheduler's lane-visit budget from packet work.
+    worker.sender.lanes.clear();
+    for lane in 1..=65 {
+        worker.sender.lanes.push(Lane::new(0, lane, 0).unwrap());
+    }
+    worker.sender.cursor = 1;
+    worker
+        .sender_message(Message::Reclaim, Duration::ZERO)
+        .unwrap();
+    assert!(worker.service_sender(Duration::ZERO).unwrap());
+    assert_eq!(worker.sender.cursor, 0);
+    assert_eq!(worker.sender.reclaim, Some(65));
+
+    let report = worker.sender.report.take();
+    assert!(!worker.service_sender(Duration::ZERO).unwrap());
+    assert_eq!(worker.sender.cursor, 0);
+    assert_eq!(worker.sender.reclaim, Some(65));
+    worker.sender.report = report;
+
+    assert!(worker.service_sender(Duration::ZERO).unwrap());
+    assert_eq!(worker.sender.cursor, 32);
+    assert_eq!(worker.sender.reclaim, Some(33));
+    assert!(worker.service_sender(Duration::ZERO).unwrap());
+    assert_eq!(worker.sender.cursor, 64);
+    assert_eq!(worker.sender.reclaim, Some(1));
+    worker.service_sender(Duration::ZERO).unwrap();
+    assert_eq!(worker.sender.reclaim, None);
+    assert!(!worker.service_sender(Duration::ZERO).unwrap());
+
+    worker.sender.lanes.clear();
+    worker.sender.cursor = 0;
+    worker
+        .sender_message(Message::Reclaim, Duration::ZERO)
+        .unwrap();
+    assert!(!worker.service_sender(Duration::ZERO).unwrap());
+}
