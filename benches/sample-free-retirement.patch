+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn retirement_skips_unowned_holes_without_losing_its_lane_or_spinning_on_pins() {
+    let (mut workers, _rx) = workers();
+    let [peer, worker] = &mut workers;
+    let connection = worker.sessions[0].connection;
+    worker
+        .command(
+            1,
+            Command {
+                generation: 1,
+                phase: Phase::Install,
+                connection,
+            },
+            0,
+        )
+        .unwrap();
+    worker.install_sender(1, 1, true).unwrap();
+    let index = worker.sender_index(0, 1).unwrap();
+    let other = worker.sender_index(1, 1).unwrap();
+    for number in 1..=129 {
+        let history = &mut worker.sender.lanes[index].history;
+        history.reserve(number, 100, false, false).unwrap();
+        if number == 65 {
+            assert!(history.submit(number, Duration::ZERO));
+            let ranges = [AckRange {
+                start: number,
+                end: number,
+            }];
+            history
+                .acknowledge(AckRanges::new(&ranges).unwrap(), |_| {})
+                .unwrap();
+        } else {
+            assert!(history.cancel(number));
+        }
+    }
+    let lane = &mut worker.sender.lanes[index];
+    lane.history.reserve(130, 100, true, true).unwrap();
+    assert!(lane.submitted(130, Duration::ZERO, NonZeroU16::new(1)));
+    assert!(lane.history.lose(130).is_some());
+    lane.history.reserve(131, 100, false, false).unwrap();
+    worker.sender.lanes[other]
+        .history
+        .reserve(1, 100, false, false)
+        .unwrap();
+    worker.sender.reclaim = Some(worker.sender.lanes.len());
+    worker.sender.cursor = index;
+    for _ in 0..2 {
+        assert!(worker.service_sender(Duration::ZERO).unwrap());
+        assert_eq!(worker.sender.reclaim, Some(2));
+        assert!(peer.incoming[1].as_mut().unwrap().try_pop().is_none());
+    }
+    worker.service_sender(Duration::ZERO).unwrap();
+    let Some(Event::Sender(Message::Report(report))) = peer.incoming[1].as_mut().unwrap().try_pop()
+    else {
+        panic!("missing sampled retirement");
+    };
+    assert!(matches!(report.kind, ReportKind::Retire));
+    assert_eq!(report.id.session, 0);
+    assert_eq!(report.count, 1);
+    assert_eq!(report.entries[0].number, 130);
+    assert_eq!(report.entries[0].sample, NonZeroU16::new(1));
+    assert_eq!(worker.sender.reclaim, Some(2));
+    worker
+        .sender_message(Message::ReportReturn(report), Duration::ZERO)
+        .unwrap();
+    assert!(worker.service_sender(Duration::ZERO).unwrap());
+    assert_eq!(worker.sender.reclaim, Some(1));
+    worker.service_sender(Duration::ZERO).unwrap();
+    assert_eq!(worker.sender.reclaim, None);
+    assert!(worker.sender.lanes[index].history.is_reserved(131));
+    assert!(worker.sender.lanes[other].history.is_reserved(1));
+    assert!(peer.incoming[1].as_mut().unwrap().try_pop().is_none());
+
+    // Independent quiescence drains sample-free histories across bounded turns.
+    for (session, lane, first) in [(0, index, 131), (1, other, 1)] {
+        assert!(worker.sender.lanes[lane].history.cancel(first));
+        for number in first + 1..=first + 130 {
+            let history = &mut worker.sender.lanes[lane].history;
+            history.reserve(number, 100, false, false).unwrap();
+            assert!(history.cancel(number));
+        }
+        worker
+            .command(
+                session,
+                Command {
+                    generation: 2,
+                    phase: Phase::Quiesce,
+                    connection: None,
+                },
+                0,
+            )
+            .unwrap();
+    }
+    for _ in 0..16 {
+        let more = worker.service_sender(Duration::ZERO).unwrap();
+        if worker.sender_idle(0) && worker.sender_idle(1) {
+            break;
+        }
+        assert!(more, "quiescence must continue without a report wakeup");
+    }
+    assert!(worker.sender_idle(0));
+    assert!(worker.sender_idle(1));
+    assert!(peer.incoming[1].as_mut().unwrap().try_pop().is_none());
+}
