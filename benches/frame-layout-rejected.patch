+/// Asks for transparent huge pages over a vector's whole capacity; call before
+/// filling it. Advisory only: failure or a non-Linux system keeps ordinary pages.
+pub(crate) fn advise_huge_pages<T>(memory: &Vec<T>) {
+    #[cfg(target_os = "linux")]
+    {
+        const HUGE: usize = 2 * 1024 * 1024;
+        let start = memory.as_ptr() as usize;
+        let end = start.saturating_add(memory.capacity().saturating_mul(size_of::<T>()));
+        let first = start.next_multiple_of(HUGE);
+        let last = end & !(HUGE - 1);
+        if last > first {
+            // SAFETY: the range lies inside the vector's own allocation; the advice
+            // changes no contents and no mapping.
+            unsafe {
+                libc::madvise(
+                    first as *mut libc::c_void,
+                    last - first,
+                    libc::MADV_HUGEPAGE,
+                );
+            }
+        }
+    }
+    #[cfg(not(target_os = "linux"))]
+    let _ = memory;
+}
+
 pub(crate) fn invalid(message: &'static str) -> io::Error {
     io::Error::new(io::ErrorKind::InvalidInput, message)
 }
