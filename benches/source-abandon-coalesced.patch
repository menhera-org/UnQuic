+
+    #[test]
+    fn initial_trigger_does_not_replace_member_backoff_or_lifetime() {
+        let mut advisory = Advisory {
+            serial: 1,
+            session: 0,
+            generation: 1,
+            lane: 0,
+            frame: (1 << 48) | 1,
+            expires: LIFETIME,
+            due: Duration::ZERO,
+            sent: [0; 3],
+            attempts: 0,
+        };
+        assert_eq!(advisory.trigger(), Duration::from_millis(5));
+        assert_eq!(advisory.due, Duration::ZERO);
+        advisory.due = Duration::from_millis(8);
+        assert_eq!(advisory.trigger(), advisory.due);
+        assert_eq!(advisory.expires, LIFETIME);
+        advisory.attempts = 1;
+        advisory.due = Duration::from_millis(3);
+        assert_eq!(advisory.trigger(), advisory.due);
+        advisory.attempts = 0;
+        advisory.expires = Duration::MAX;
+        advisory.due = Duration::MAX - Duration::from_millis(2);
+        assert_eq!(advisory.trigger(), advisory.due);
+        assert_eq!(advisory.expires, Duration::MAX);
+    }
+
+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn initial_coalescing_piggybacks_young_records_without_extending_lifetimes() {
+        let (mut workers, rx) = setup();
+        let worker = &mut workers[0];
+        worker.queue_abandon(0, 0, (1 << 48) | 1, Duration::ZERO);
+        let young = Duration::from_millis(4);
+        worker.queue_abandon(0, 0, (1 << 48) | 2, young);
+        without_allocations(|| {
+            pump(worker, young);
+            assert!(worker.sender.job.is_none());
+            assert_eq!(worker.abandon_deadline(), Some(Duration::from_millis(5)));
+            empty(&rx);
+            let now = Duration::from_millis(5);
+            let job = permit(worker, now);
+            assert_eq!(job.deadline, LIFETIME);
+            assert_eq!(worker.sender.abandons.selected_len, 2);
+            assert_eq!(
+                worker.sender.abandons.entries[1].unwrap().trigger(),
+                Duration::from_millis(9)
+            );
+            worker.use_sender_permit(now).unwrap();
+            pump(worker, now);
+            let mut bytes = [0; BASE_UDP_PAYLOAD];
+            let length = rx.recv(&mut bytes).unwrap().0;
+            assert_eq!(Datagram::decode(&bytes[..length]).unwrap().record_count, 2);
+            assert_eq!(worker.counters.abandon_datagrams, 1);
+            assert_eq!(worker.counters.abandon_sent, 2);
+            assert_eq!(worker.sender.abandons.entries[0].unwrap().expires, LIFETIME);
+            assert_eq!(
+                worker.sender.abandons.entries[1].unwrap().expires,
+                young + LIFETIME
+            );
+            pump(worker, LIFETIME);
+            assert!(worker.sender.abandons.entries[0].is_none());
+            assert_eq!(
+                worker.sender.abandons.entries[1].unwrap().expires,
+                young + LIFETIME
+            );
+            pump(worker, young + LIFETIME);
+            assert_eq!(worker.sender.abandons.count, 0);
+        });
+    }
+
+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn failed_early_piggyback_keeps_backoff_and_original_initial_trigger() {
+        let (mut workers, rx) = setup();
+        let worker = &mut workers[0];
+        worker.queue_abandon(0, 0, (1 << 48) | 1, Duration::ZERO);
+        worker.queue_abandon(0, 0, (1 << 48) | 2, Duration::from_millis(4));
+        let now = Duration::from_millis(5);
+        permit(worker, now);
+        assert_eq!(worker.sender.abandons.selected_len, 2);
+        CLOCK_CALLS.with(|c| c.set(0));
+        worker.io_time = Some(|now| {
+            CLOCK_CALLS.with(|c| {
+                let call = c.get();
+                c.set(call + 1);
+                if call == 1 {
+                    Err(io::ErrorKind::WouldBlock.into())
+                } else {
+                    Ok(now)
+                }
+            })
+        });
+        without_allocations(|| worker.use_sender_permit(now).unwrap());
+        worker.io_time = Some(Ok);
+        empty(&rx);
+        let young = worker.sender.abandons.entries[1].unwrap();
+        assert_eq!(young.attempts, 0);
+        assert_eq!(young.due, Duration::from_millis(6));
+        assert_eq!(young.trigger(), Duration::from_millis(9));
+        assert_eq!(young.expires, Duration::from_millis(104));
+        without_allocations(|| {
+            pump(worker, now + Duration::from_micros(500));
+            assert!(worker.sender.job.is_none());
+            empty(&rx);
+            // Remove the older anchor to test the young member independently.
+            let old = worker.sender.abandons.entries[0].unwrap();
+            worker.sender.abandons.remove(0, old.serial);
+            pump(worker, Duration::from_millis(8));
+            assert!(worker.sender.job.is_none());
+            assert_eq!(worker.abandon_deadline(), Some(Duration::from_millis(9)));
+            permit(worker, Duration::from_millis(9));
+            worker.use_sender_permit(Duration::from_millis(9)).unwrap();
+            let mut bytes = [0; BASE_UDP_PAYLOAD];
+            let length = rx.recv(&mut bytes).unwrap().0;
+            let packet = Datagram::decode(&bytes[..length]).unwrap();
+            assert_eq!(packet.record_count, 1);
+            assert!(matches!(
+                packet.records().next(),
+                Some(Record::FrameAbandon {
+                    frame_id: 0x0001_0000_0000_0002,
+                    ..
+                })
+            ));
+            let young = worker.sender.abandons.entries[1].unwrap();
+            assert_eq!(young.attempts, 1);
+            assert_eq!(young.expires, Duration::from_millis(104));
+            assert_eq!(worker.counters.abandon_retried, 0);
+        });
+    }
