+#[cfg(test)]
+mod diagnostic_tests {
+    use super::*;
+
+    #[test]
+    fn factorial_changes_only_selected_limits_and_preserves_probe_rtt_drain() {
+        for probe_rtt in [false, true] {
+            for mode in 0..=3 {
+                let raw = pacing::Limits {
+                    window: 5120,
+                    rate: 12_345_678,
+                    quantum: 2560,
+                    max_datagram: 1280,
+                };
+                let limits = diagnostic_limits(raw, mode, probe_rtt);
+                assert_eq!(
+                    limits.rate,
+                    if mode & 1 != 0 {
+                        4_000_000_000
+                    } else {
+                        raw.rate
+                    }
+                );
+                assert_eq!(
+                    limits.window,
+                    if mode & 2 != 0 && !probe_rtt {
+                        8 * 1024 * 1024
+                    } else {
+                        raw.window
+                    }
+                );
+                assert_eq!(limits.quantum, raw.quantum);
+                assert_eq!(limits.max_datagram, raw.max_datagram);
+            }
+        }
+    }
+
+    #[test]
+    fn every_mode_preserves_expiry_accounting_burst_and_stalled_pto_bounds() {
+        for mode in 0..=3 {
+            let raw = pacing::Limits {
+                window: 5120,
+                rate: 128_000_000,
+                quantum: 2560,
+                max_datagram: 1280,
+            };
+            let limits = diagnostic_limits(raw, mode, false);
+            let mut grants = crate::pacing::Grants::new(2).unwrap();
+            let first = grants
+                .reserve(0, 2560, false, limits, Duration::ZERO)
+                .unwrap();
+            assert_eq!(first.expires(), Duration::from_micros(100));
+            assert_eq!(
+                grants.reserve(1, 1280, false, limits, Duration::from_secs(1)),
+                Err(GrantError::Blocked)
+            );
+            assert_eq!(grants.reserved(), 2560);
+            grants.reported(first, 1280, Some(Duration::ZERO)).unwrap();
+            assert_eq!((grants.reserved(), grants.in_flight()), (0, 1280));
+            assert_eq!(grants.reported(first, 0, None), Err(GrantError::Stale));
+            let stalled = pacing::Limits {
+                window: 0,
+                ..limits
+            };
+            assert_eq!(
+                grants.reserve(0, 1280, false, stalled, Duration::from_secs(1)),
+                Err(GrantError::Blocked)
+            );
+            grants.probe_allowance(1).unwrap();
+            let probe = grants
+                .reserve(0, 1280, true, stalled, Duration::from_secs(1))
+                .unwrap();
+            assert!(probe.is_probe());
+            grants
+                .reported(probe, 1280, Some(Duration::from_secs(1)))
+                .unwrap();
+            assert_eq!(grants.in_flight(), 2560);
+            assert_eq!(
+                grants.reserve(1, 1280, true, stalled, Duration::from_secs(2)),
+                Err(GrantError::Blocked)
+            );
+            grants.settled(2560).unwrap();
+            assert_eq!(grants.in_flight(), 0);
+        }
+    }
