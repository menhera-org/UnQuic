diff --git a/src/worker/sender/diagnostic.rs b/src/worker/sender/diagnostic.rs
new file mode 100644
index 0000000..0aa5a97
--- /dev/null
+++ b/src/worker/sender/diagnostic.rs
@@ -0,0 +1,253 @@
+//! Isolated service-ceiling measurements; never changes admission or ordering.
+use super::*;
+
+#[derive(Clone, Copy, Default)]
+struct Sample {
+    sequence: u64,
+    issued: Option<Duration>,
+}
+
+pub(super) struct Diagnostic {
+    values: Snapshot,
+    samples: [Sample; 64],
+    previous_busy: Option<Duration>,
+}
+
+impl Diagnostic {
+    pub(super) fn new() -> Self {
+        Self {
+            values: Snapshot::default(),
+            samples: [Sample::default(); 64],
+            previous_busy: None,
+        }
+    }
+
+    pub(super) fn publish(&self, values: &mut Snapshot) {
+        values.service_grants = self.values.service_grants;
+        values.service_reserved_bytes = self.values.service_reserved_bytes;
+        values.service_planned_packets = self.values.service_planned_packets;
+        values.service_submitted_bytes = self.values.service_submitted_bytes;
+        values.service_completions = self.values.service_completions;
+        values.service_zero_completions = self.values.service_zero_completions;
+        values.service_partial_completions = self.values.service_partial_completions;
+        values.service_burst_filled = self.values.service_burst_filled;
+        values.service_epochs = self.values.service_epochs;
+        values.service_epoch_grants = self.values.service_epoch_grants;
+        values.service_epoch_grants_peak = self.values.service_epoch_grants_peak;
+        values.service_charged_peak = self.values.service_charged_peak;
+        values.service_window_insufficient = self.values.service_window_insufficient;
+        values.service_window_limited_grants = self.values.service_window_limited_grants;
+        values.service_owner_passes = self.values.service_owner_passes;
+        values.service_busy_passes = self.values.service_busy_passes;
+        values.service_busy_intervals = self.values.service_busy_intervals;
+        values.service_busy_interval_ns = self.values.service_busy_interval_ns;
+        values.service_busy_interval_max_ns = self.values.service_busy_interval_max_ns;
+        values.service_grant_intervals = self.values.service_grant_intervals;
+        values.service_grant_interval_ns = self.values.service_grant_interval_ns;
+        values.service_grant_interval_max_ns = self.values.service_grant_interval_max_ns;
+        values.service_owner_samples = self.values.service_owner_samples;
+        values.service_owner_sample_ns = self.values.service_owner_sample_ns;
+        values.service_owner_sample_max_ns = self.values.service_owner_sample_max_ns;
+        values.service_report_samples = self.values.service_report_samples;
+        values.service_reserve_report_ns = self.values.service_reserve_report_ns;
+        values.service_reserve_report_max_ns = self.values.service_reserve_report_max_ns;
+        values.service_send_samples = self.values.service_send_samples;
+        values.service_reserve_send_ns = self.values.service_reserve_send_ns;
+        values.service_send_report_ns = self.values.service_send_report_ns;
+        values.service_clock_anomalies = self.values.service_clock_anomalies;
+    }
+
+    pub(super) fn pass(&mut self, now: Duration, busy: bool) {
+        self.values.service_owner_passes += 1;
+        if busy {
+            self.values.service_busy_passes += 1;
+            if let Some(previous) = self.previous_busy {
+                if let Some(elapsed) = now.checked_sub(previous) {
+                    let ns = nanos(elapsed);
+                    self.values.service_busy_intervals += 1;
+                    self.values.service_busy_interval_ns += ns;
+                    self.values.service_busy_interval_max_ns =
+                        self.values.service_busy_interval_max_ns.max(ns);
+                } else {
+                    self.values.service_clock_anomalies += 1;
+                }
+            }
+        }
+        self.previous_busy = busy.then_some(now);
+    }
+
+    pub(super) fn sample_pass(&self) -> bool {
+        self.values.service_owner_passes & 63 == 0
+    }
+
+    pub(super) fn pass_finished(&mut self, start: Duration, end: Duration) {
+        if let Some(elapsed) = end.checked_sub(start) {
+            let ns = nanos(elapsed);
+            self.values.service_owner_samples += 1;
+            self.values.service_owner_sample_ns += ns;
+            self.values.service_owner_sample_max_ns =
+                self.values.service_owner_sample_max_ns.max(ns);
+        } else {
+            self.values.service_clock_anomalies += 1;
+        }
+    }
+
+    pub(super) fn occupancy(&mut self, charged: u64) {
+        self.values.service_charged_peak = self.values.service_charged_peak.max(charged);
+    }
+
+    pub(super) fn window_limited_grant(&mut self) {
+        self.values.service_window_limited_grants += 1;
+    }
+
+    pub(super) fn window_insufficient(&mut self) {
+        self.values.service_window_insufficient += 1;
+    }
+
+    pub(super) fn granted(
+        &mut self,
+        worker: usize,
+        bytes: u32,
+        packets: usize,
+        filled: bool,
+        now: Duration,
+        previous: Option<Duration>,
+    ) {
+        self.values.service_grants += 1;
+        self.values.service_reserved_bytes += u64::from(bytes);
+        self.values.service_planned_packets += packets as u64;
+        self.values.service_burst_filled += u64::from(filled);
+        if let Some(previous) = previous {
+            if let Some(elapsed) = now.checked_sub(previous) {
+                let ns = nanos(elapsed);
+                self.values.service_grant_intervals += 1;
+                self.values.service_grant_interval_ns += ns;
+                self.values.service_grant_interval_max_ns =
+                    self.values.service_grant_interval_max_ns.max(ns);
+            } else {
+                self.values.service_clock_anomalies += 1;
+            }
+        }
+        let sample = &mut self.samples[worker];
+        sample.issued = (sample.sequence & 63 == 0).then_some(now);
+        sample.sequence = sample.sequence.wrapping_add(1);
+    }
+
+    pub(super) fn sample_completion(&self, worker: usize) -> bool {
+        self.samples.get(worker).is_some_and(|s| s.issued.is_some())
+    }
+
+    pub(super) fn completed(
+        &mut self,
+        worker: usize,
+        reserved: u32,
+        submitted: u64,
+        started: Option<Duration>,
+        observed: Option<Duration>,
+    ) {
+        self.values.service_completions += 1;
+        self.values.service_submitted_bytes += submitted;
+        self.values.service_zero_completions += u64::from(submitted == 0);
+        self.values.service_partial_completions +=
+            u64::from(submitted != 0 && submitted < u64::from(reserved));
+        let issued = self.samples[worker].issued.take();
+        if let (Some(issued), Some(observed)) = (issued, observed) {
+            if let Some(elapsed) = observed.checked_sub(issued) {
+                let ns = nanos(elapsed);
+                self.values.service_report_samples += 1;
+                self.values.service_reserve_report_ns += ns;
+                self.values.service_reserve_report_max_ns =
+                    self.values.service_reserve_report_max_ns.max(ns);
+            } else {
+                self.values.service_clock_anomalies += 1;
+                return;
+            }
+            if let Some(started) = started {
+                if let (Some(before), Some(after)) =
+                    (started.checked_sub(issued), observed.checked_sub(started))
+                {
+                    self.values.service_send_samples += 1;
+                    self.values.service_reserve_send_ns += nanos(before);
+                    self.values.service_send_report_ns += nanos(after);
+                } else {
+                    self.values.service_clock_anomalies += 1;
+                }
+            }
+        }
+    }
+
+    pub(super) fn reopened(&mut self, grants: u64) {
+        if grants != 0 {
+            self.values.service_epochs += 1;
+            self.values.service_epoch_grants += grants;
+            self.values.service_epoch_grants_peak =
+                self.values.service_epoch_grants_peak.max(grants);
+        }
+    }
+}
+
+fn nanos(elapsed: Duration) -> u64 {
+    elapsed.as_nanos().min(u128::from(u64::MAX)) as u64
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn us(value: u64) -> Duration {
+        Duration::from_micros(value)
+    }
+
+    #[test]
+    fn accounting_and_samples_include_zero_partial_and_separate_workers() {
+        let mut diag = Diagnostic::new();
+        diag.granted(0, 3000, 2, true, us(10), None);
+        diag.granted(1, 1500, 1, false, us(12), Some(us(10)));
+        assert!(diag.sample_completion(0));
+        assert!(diag.sample_completion(1));
+        diag.completed(0, 3000, 1500, Some(us(20)), Some(us(40)));
+        diag.completed(1, 1500, 0, None, Some(us(50)));
+        diag.reopened(2);
+        assert_eq!(diag.values.service_reserved_bytes, 4500);
+        assert_eq!(diag.values.service_submitted_bytes, 1500);
+        assert_eq!(diag.values.service_zero_completions, 1);
+        assert_eq!(diag.values.service_partial_completions, 1);
+        assert_eq!(diag.values.service_report_samples, 2);
+        assert_eq!(diag.values.service_reserve_report_ns, 68_000);
+        assert_eq!(diag.values.service_reserve_send_ns, 10_000);
+        assert_eq!(diag.values.service_send_report_ns, 20_000);
+        assert_eq!(diag.values.service_send_samples, 1);
+        assert_eq!(diag.values.service_epoch_grants, 2);
+        assert!(!diag.sample_completion(0));
+        for sequence in 1..=64 {
+            diag.granted(0, 1500, 1, false, us(60 + sequence), None);
+            assert_eq!(diag.sample_completion(0), sequence == 64);
+            diag.completed(0, 1500, 1500, None, None);
+        }
+    }
+
+    #[test]
+    fn busy_intervals_exclude_idle_and_clock_anomalies_do_not_wrap() {
+        let mut diag = Diagnostic::new();
+        diag.pass(us(10), true);
+        diag.pass(us(30), true);
+        diag.pass(us(100), false);
+        diag.pass(us(200), true);
+        diag.pass(us(190), true);
+        diag.pass_finished(us(10), us(15));
+        diag.pass_finished(us(20), us(19));
+        diag.granted(0, 1500, 1, false, us(40), Some(us(50)));
+        diag.completed(0, 1500, 0, None, Some(us(39)));
+        diag.reopened(0);
+        assert_eq!(diag.values.service_busy_intervals, 1);
+        assert_eq!(diag.values.service_busy_interval_ns, 20_000);
+        assert_eq!(diag.values.service_owner_samples, 1);
+        assert_eq!(diag.values.service_owner_sample_ns, 5_000);
+        assert_eq!(diag.values.service_clock_anomalies, 4);
+        assert_eq!(diag.values.service_report_samples, 0);
+        assert_eq!(diag.values.service_epochs, 0);
+        let mut snapshot = Snapshot::default();
+        diag.publish(&mut snapshot);
+        diag.publish(&mut snapshot);
+        assert_eq!(snapshot.service_busy_passes, 4);
+    }
+}
