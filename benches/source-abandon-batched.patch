+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn changed_members_cancel_batch_then_rebuild_only_live_members() {
+        let (mut workers, rx) = setup();
+        let worker = &mut workers[0];
+        worker.queue_abandon(0, 0, (1 << 48) | 1, Duration::ZERO);
+        permit(worker, Duration::from_millis(1));
+        worker.use_sender_permit(Duration::from_millis(1)).unwrap();
+        pump(worker, Duration::from_millis(1));
+        let first = receive(&rx);
+        let now = Duration::from_millis(20);
+        for id in 2..=4 {
+            worker.queue_abandon(0, 0, (1 << 48) | id, Duration::from_millis(2));
+        }
+        let job = permit(worker, now);
+        assert_eq!(worker.sender.abandons.selected_len, 4);
+        assert_eq!(job.deadline, LIFETIME);
+        worker.sender.lanes[0]
+            .history
+            .acknowledge(
+                AckRanges::new(&[AckRange {
+                    start: first,
+                    end: first,
+                }])
+                .unwrap(),
+                |_| {},
+            )
+            .unwrap();
+        worker.sender.abandons.entries[2].as_mut().unwrap().expires = now;
+        let replaced = worker.sender.abandons.entries[3].unwrap();
+        worker.sender.abandons.remove(3, replaced.serial);
+        worker.queue_abandon(0, 0, (1 << 48) | 5, now);
+        without_allocations(|| {
+            worker.use_sender_permit(now).unwrap();
+            empty(&rx);
+            assert!(worker.sender.abandons.entries[0].is_none());
+            assert!(worker.sender.abandons.entries[2].is_none());
+            assert_eq!(worker.sender.abandons.entries[1].unwrap().attempts, 0);
+            assert_eq!(worker.sender.abandons.entries[3].unwrap().attempts, 0);
+            assert_eq!(
+                worker.sender.abandons.entries[1].unwrap().expires,
+                Duration::from_millis(102)
+            );
+            // Recycle and rebuild after both surviving members become due.
+            permit(worker, now + Duration::from_millis(2));
+            worker
+                .use_sender_permit(now + Duration::from_millis(2))
+                .unwrap();
+            let mut bytes = [0; BASE_UDP_PAYLOAD];
+            let length = rx.recv(&mut bytes).unwrap().0;
+            let packet = Datagram::decode(&bytes[..length]).unwrap();
+            assert_eq!(packet.record_count, 2);
+            let mut ids = [0; 2];
+            for (id, record) in ids.iter_mut().zip(packet.records()) {
+                let Record::FrameAbandon { frame_id, .. } = record else {
+                    panic!("unexpected record")
+                };
+                *id = frame_id;
+            }
+            ids.sort_unstable();
+            assert_eq!(ids, [(1 << 48) | 2, (1 << 48) | 5]);
+            assert_eq!(worker.counters.abandon_sent, 3);
+            assert_eq!(worker.counters.abandon_datagrams, 2);
+            assert_eq!(worker.counters.abandon_retried, 0);
+        });
+    }
