+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn packed_advisories_release_full_receive_lane_with_one_ordinary_datagram() {
+        let (mut workers, rx) = setup();
+        let worker = &mut workers[0];
+        let mut remote = reassembly::Lane::new(1, 1514).unwrap();
+        let mut encoded = [0; BASE_UDP_PAYLOAD];
+        let first = Duration::from_millis(1);
+        without_allocations(|| {
+            for sequence in 1..=64 {
+                let id = (1 << 48) | sequence;
+                let length = wire::encode_datagram(
+                    Header {
+                        cookie: worker.shared.config.config().sessions[0].cookie,
+                        receive_tag: 2,
+                        lane: 1,
+                        packet_number: sequence,
+                        record_area_len: 0,
+                    },
+                    &[Record::Data {
+                        frame_id: id,
+                        total_len: 1514,
+                        offset: 0,
+                        bytes: &[7; 100],
+                    }],
+                    &mut encoded,
+                )
+                .unwrap();
+                assert_eq!(
+                    remote.admit(
+                        &Datagram::decode(&encoded[..length]).unwrap(),
+                        Duration::ZERO
+                    ),
+                    Admission::Fresh
+                );
+                worker.queue_abandon(0, 0, id, Duration::ZERO);
+            }
+            assert_eq!(remote.retained_frames(), 64);
+            // The fixture's control packet must follow these admitted DATA IDs.
+            worker.sessions[0].tx[0]
+                .as_mut()
+                .unwrap()
+                .allocate_packets(64)
+                .unwrap();
+            let job = permit(worker, first);
+            assert_eq!(job.deadline, LIFETIME);
+            assert_eq!(worker.sender.abandons.selected_len, 64);
+            worker.use_sender_permit(first).unwrap();
+            pump(worker, first);
+            let length = rx.recv(&mut encoded).unwrap().0;
+            assert_eq!(length, MAX_LENGTH);
+            let packet = Datagram::decode(&encoded[..length]).unwrap();
+            assert_eq!(packet.record_count, 64);
+            assert_eq!(remote.admit(&packet, first), Admission::Fresh);
+            assert_eq!(remote.retained_frames(), 0);
+            assert_eq!(worker.counters.abandon_sent, 64);
+            assert_eq!(worker.counters.abandon_datagrams, 1);
+            assert_eq!(
+                worker.sender.lanes[0].history.inflight_bytes(),
+                (MAX_LENGTH + 48) as u64
+            );
+            assert_eq!(
+                worker
+                    .sender
+                    .owner
+                    .as_ref()
+                    .unwrap()
+                    .snapshot(0)
+                    .unwrap()
+                    .bytes_in_flight,
+                (MAX_LENGTH + 48) as u64
+            );
+            empty(&rx);
+            let length = wire::encode_datagram(
+                Header {
+                    cookie: worker.shared.config.config().sessions[0].cookie,
+                    receive_tag: 2,
+                    lane: 1,
+                    packet_number: job.first + 1,
