+            )
+            .unwrap();
+            assert_eq!(
+                remote.admit(&Datagram::decode(&encoded[..length]).unwrap(), first),
+                Admission::Fresh
+            );
+            assert_eq!(remote.front(first).unwrap().bytes, &[9; 60]);
+            assert!(remote.finish_front());
