+                Ok(if call == 0 { now } else { LIFETIME })
+            })
+        });
+        without_allocations(|| worker.use_sender_permit(now).unwrap());
+        empty(&rx);
+        assert!(worker.sender.abandons.entries[0].is_none());
+        let remaining = worker.sender.abandons.entries[1].unwrap();
+        assert_eq!(remaining.expires, Duration::from_millis(101));
+        assert_eq!(remaining.attempts, 0);
+        assert_eq!(remaining.due, LIFETIME + RETRY);
+        assert_eq!(worker.counters.abandon_datagrams, 0);
+        assert_eq!(worker.counters.abandon_expired, 1);
+    }
 }
