+/// Transmit lane index on which worker `own` sends the ACK for receive lane
+/// `acked`: one of its own lanes, preferring a lane whose peer receive owner,
+/// `(low + lane) mod queues` as in Worker::packet_one, is the peer's transmit
+/// owner of `acked`, `(acked − 1) mod workers`. None when `own` has no lane.
+fn ack_lane(
+    low: u32,
+    queues: usize,
+    workers: usize,
+    lanes: usize,
+    own: usize,
+    acked: u16,
+) -> Option<usize> {
+    let (queues, workers) = (queues.max(1), workers.max(1));
+    let target = usize::from(acked).saturating_sub(1) % workers;
+    let mut owned = (own..lanes).step_by(workers);
+    let first = owned.clone().next()?;
+    Some(
+        owned
+            .find(|&lane| low.wrapping_add(lane as u32) as usize % queues == target)
+            .unwrap_or(first),
+    )
+}
