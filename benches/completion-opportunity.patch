+
+    fn observe_completion(
+        &mut self,
+        group: usize,
+        before: (u64, u64),
+        slots: usize,
+        now: Duration,
+    ) -> io::Result<()> {
+        let mut limits = self.groups[group].controller.limits();
+        if self.groups[group].pto.stalled() {
+            limits.window = 0;
+        }
+        let after = self
+            .sender
+            .flight_bytes(group)
+            .ok_or(io::ErrorKind::InvalidData)?;
+        let quantum = u64::from(limits.quantum.min(64 * u32::from(limits.max_datagram)));
+        let pre_window = limits
+            .window
+            .saturating_sub(before.0)
+            .saturating_sub(before.1);
+        let post_window = limits
+            .window
+            .saturating_sub(after.0)
+            .saturating_sub(after.1);
+        let pre_quantum = quantum.saturating_sub(before.0);
+        let post_quantum = quantum.saturating_sub(after.0);
+        let post_slots = self.sender.available();
+        let pacing = limits.rate != 0 && self.sender.deadline(group, now).is_none();
+        let d = &mut self.opportunity;
+        d.opportunity_samples += 1;
+        d.opportunity_pacing += u64::from(pacing);
+        d.opportunity_pre_slots += slots as u64;
+        d.opportunity_post_slots += post_slots as u64;
+        d.opportunity_pre_window += pre_window;
+        d.opportunity_post_window += post_window;
+        d.opportunity_pre_quantum += pre_quantum;
+        d.opportunity_post_quantum += post_quantum;
+        let mut pre_any = false;
+        let mut post_any = false;
+        for request in self.requests.iter().flatten() {
+            if !request.diagnostic_data
+                || request.group != group
+                || request.probe.is_some()
+                || request.pmtu
+                || now >= request.deadline
+            {
+                continue;
+            }
+            let Some(packet) = request.flight.packets().next() else {
+                continue;
+            };
+            if !self.timers.matches(packet.id) {
+                continue;
+            }
+            d.opportunity_pending += 1;
+            // Do not mutate the controller to predict a differently sized request.
+            if request.mtu != limits.max_datagram {
+                d.opportunity_mtu_mismatch += 1;
+                continue;
+            }
+            let bytes = u64::from(packet.bytes);
+            d.opportunity_pre_window_fit += u64::from(bytes <= pre_window);
+            d.opportunity_post_window_fit += u64::from(bytes <= post_window);
+            d.opportunity_pre_quantum_fit += u64::from(bytes <= pre_quantum);
+            d.opportunity_post_quantum_fit += u64::from(bytes <= post_quantum);
+            let pre = pacing && slots != 0 && bytes <= pre_window && bytes <= pre_quantum;
+            let post = pacing && post_slots != 0 && bytes <= post_window && bytes <= post_quantum;
+            d.opportunity_pre_fit += u64::from(pre);
+            d.opportunity_post_fit += u64::from(post);
+            pre_any |= pre;
+            post_any |= post;
+        }
+        d.opportunity_pre_any += u64::from(pre_any);
+        d.opportunity_post_any += u64::from(post_any);
         Ok(())
     }
 
