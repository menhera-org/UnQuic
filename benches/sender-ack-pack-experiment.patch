+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn ack_packing_stops_at_future_or_stale_front_snapshot() {
+        for stale in [false, true] {
+            let (mut worker, _) = receive_worker();
+            let rx = socket(&mut worker);
+            worker.io_time = Some(Ok);
+            for lane in 7..11 {
+                queue_snapshot(&mut worker, 0, lane, 1, 0);
+            }
+            let Pending::Ack(next) = &mut worker.pending_control[1] else {
+                panic!()
+            };
+            if stale {
+                next.tag = 9;
+            } else {
+                next.due = Duration::from_millis(1);
+            }
+            worker.flush_control(Duration::ZERO).unwrap();
+            let mut bytes = [0; BASE_UDP_PAYLOAD];
+            for count in [1, 2] {
+                let length = rx.recv(&mut bytes).unwrap().0;
+                assert_eq!(
+                    Datagram::decode(&bytes[..length])
+                        .unwrap()
+                        .records()
+                        .count(),
+                    count
+                );
+            }
+            assert_eq!(
+                rx.recv(&mut bytes).unwrap_err().kind(),
+                io::ErrorKind::WouldBlock
+            );
+            assert_eq!(worker.pending_control.len(), usize::from(!stale));
+            if !stale {
+                worker.flush_control(Duration::from_millis(1)).unwrap();
+                let length = rx.recv(&mut bytes).unwrap().0;
+                assert!(matches!(
+                    Datagram::decode(&bytes[..length]).unwrap().records().next(),
+                    Some(Record::Ack { lane: 8, .. })
+                ));
+            }
+            assert_eq!(worker.feedback_free.len(), BUFFERS);
+        }
+    }
