+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn packed_acks_keep_snapshot_budget_and_session_order() {
+        let (mut worker, _) = receive_worker();
+        let rx = socket(&mut worker);
+        worker.io_time = Some(Ok);
+        for _ in 0..BATCH_SIZE - 2 {
+            worker.pending_control.push_back(Pending::Reply {
+                session: 0,
+                tag: 1,
+                lane: 7,
+                packet: 1,
+                length: 52,
+                due: Duration::from_secs(1),
+            });
+        }
+        for lane in 7..11 {
+            queue_snapshot(&mut worker, 0, lane, 1, 0);
+        }
+        worker.flush_control(Duration::ZERO).unwrap();
+        let mut bytes = [0; BASE_UDP_PAYLOAD];
+        let length = rx.recv(&mut bytes).unwrap().0;
+        assert_eq!(
+            Datagram::decode(&bytes[..length])
+                .unwrap()
+                .records()
+                .count(),
+            2
+        );
+        assert_eq!(worker.feedback_free.len(), 2);
+        assert_eq!(worker.pending_control.len(), BATCH_SIZE);
+        worker.flush_control(Duration::ZERO).unwrap();
+        let length = rx.recv(&mut bytes).unwrap().0;
+        assert_eq!(
+            Datagram::decode(&bytes[..length])
+                .unwrap()
+                .records()
+                .count(),
+            2
+        );
+        assert_eq!(worker.feedback_free.len(), BUFFERS);
+        worker.pending_control.clear();
+        worker
+            .command(1, worker.sessions[0].installed.unwrap(), 0)
+            .unwrap();
+        for (lane, session) in [(7, 0), (8, 1), (9, 0), (10, 1)] {
+            queue_snapshot(&mut worker, session, lane, 1, 0);
+        }
+        worker.flush_control(Duration::ZERO).unwrap();
+        for session in [0, 1, 0, 1] {
+            let length = rx.recv(&mut bytes).unwrap().0;
+            let datagram = Datagram::decode(&bytes[..length]).unwrap();
+            assert_eq!(datagram.records().count(), 1);
+            assert_eq!(
+                datagram.header().cookie,
+                worker.shared.config.config().sessions[session].cookie
+            );
+        }
+        assert_eq!(
+            rx.recv(&mut bytes).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+    }
