+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn packed_ack_send_failure_returns_all_snapshots_and_cancels_history() {
+        let (mut worker, _) = receive_worker();
+        let rx = socket(&mut worker);
+        worker.unpaced_fixture = false;
+        std::thread_local! { static STEP: std::cell::Cell<usize> = const { std::cell::Cell::new(0) }; }
+        STEP.set(0);
+        worker.io_time = Some(|_| {
+            if STEP.replace(STEP.get() + 1) == 2 {
+                Err(io::ErrorKind::WouldBlock.into())
+            } else {
+                Ok(Duration::ZERO)
+            }
+        });
+        for lane in 7..11 {
+            queue_snapshot(&mut worker, 0, lane, 1, 0);
+        }
+        worker.flush_control(Duration::ZERO).unwrap();
+        assert_eq!(worker.feedback_free.len(), BUFFERS);
+        assert!(
+            worker
+                .feedback_free
+                .iter()
+                .all(|feedback| feedback.sent.is_none())
+        );
+        assert!(worker.pending_control.is_empty());
+        assert_eq!(worker.counters.tx_outer_bytes, 0);
+        assert_eq!(worker.control_budgets[0].deadline(), None);
+        let index = worker.sender_index(0, 0).unwrap();
+        assert_eq!(worker.sender.lanes[index].history.highest_sent(), 0);
+        assert!(!worker.sender.lanes[index].history.is_reserved(1));
+        let mut bytes = [0; BASE_UDP_PAYLOAD];
+        assert_eq!(
+            rx.recv(&mut bytes).unwrap_err().kind(),
+            io::ErrorKind::WouldBlock
+        );
+    }
