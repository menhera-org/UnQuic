+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn packed_acks_fit_baseline_and_charge_one_physical_packet() {
+        for ranges in [1, MAX_ACK_RANGES] {
+            let (mut worker, _) = receive_worker();
+            let rx = socket(&mut worker);
+            worker.unpaced_fixture = false;
+            worker.io_time = Some(|_| Ok(Duration::from_micros(700)));
+            for index in 0..4 {
+                queue_snapshot(&mut worker, 0, index + 7, ranges, u64::from(index) * 100);
+            }
+            worker.flush_control(Duration::from_micros(300)).unwrap();
+            assert_eq!(worker.feedback_free.len(), BUFFERS);
+            assert!(worker.pending_control.is_empty());
+            let packets = if ranges == 1 { 1 } else { 2 };
+            let per_packet = 4 / packets;
+            let mut bytes = [0; BASE_UDP_PAYLOAD];
+            let mut outer = 0;
+            for number in 1..=packets {
+                let length = rx.recv(&mut bytes).unwrap().0;
+                assert_eq!(length, wire::HEADER_LEN + per_packet * (12 + 16 * ranges));
+                let datagram = Datagram::decode(&bytes[..length]).unwrap();
+                assert_eq!(datagram.header().packet_number, number as u64);
+                assert_eq!(datagram.records().count(), per_packet);
+                for (offset, record) in datagram.records().enumerate() {
+                    let index = (number - 1) * per_packet + offset;
+                    let Record::Ack {
+                        lane,
+                        delay_us,
+                        ranges: received,
+                    } = record
+                    else {
+                        panic!()
+                    };
+                    assert_eq!(lane, index as u16 + 7);
+                    assert_eq!(delay_us, 700 - 90 * index as u32);
+                    assert_eq!(received.len(), ranges);
+                    assert_eq!(received.iter().next().unwrap().end, (ranges * 2) as u64);
+                }
+                outer += length + 48;
+                let index = worker.sender_index(0, 0).unwrap();
+                let sent = worker.sender.lanes[index]
+                    .history
+                    .packet(number as u64)
+                    .unwrap();
+                assert_eq!(usize::from(sent.outer_bytes), length + 48);
+                assert!(!sent.charged && !sent.eliciting);
+            }
+            assert_eq!(worker.counters.tx_outer_bytes, outer as u64);
+            assert_eq!(
+                rx.recv(&mut bytes).unwrap_err().kind(),
+                io::ErrorKind::WouldBlock
+            );
+            let reply = Record::ProbeReply {
+                lane: 7,
+                packet_number: 1,
+                payload_len: 52,
+            };
+            for _ in packets..16 {
+                assert!(
+                    worker
+                        .send_record(0, reply, Duration::from_micros(700))
+                        .unwrap()
+                        .is_some()
+                );
+            }
+            assert!(
+                worker
+                    .send_record(0, reply, Duration::from_micros(700))
+                    .unwrap()
+                    .is_none()
+            );
+        }
+    }
