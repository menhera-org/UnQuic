+    fn queue_snapshot(worker: &mut Worker, session: usize, lane: u16, count: usize, age: u64) {
+        let mut feedback = worker.feedback_free.pop().unwrap();
+        feedback.session = session;
+        feedback.tag = 1;
+        feedback.lane = lane;
+        feedback.slot = 0;
+        feedback.count = count;
+        feedback.created = Duration::from_micros(age);
+        feedback.delay_us = age as u32 / 10;
+        feedback.due = Duration::ZERO;
+        feedback.sent = None;
+        for (index, range) in feedback.ranges[..count].iter_mut().enumerate() {
+            let number = ((count - index) * 2) as u64;
+            *range = AckRange {
+                start: number,
+                end: number,
+            };
+        }
+        worker.shared.owners[session][usize::from(lane)].store(1, Ordering::Release);
+        worker.pending_control.push_back(Pending::Ack(feedback));
+    }
