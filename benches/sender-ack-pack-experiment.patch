+    #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn packed_ack_admission_dispatches_every_record_once() {
+        let (mut worker, _) = receive_worker();
+        let rx = socket(&mut worker);
+        worker.unpaced_fixture = false;
+        worker.io_time = Some(Ok);
+        for lane in [1, 2, 1, 2] {
+            queue_snapshot(&mut worker, 0, lane, 1, 0);
+        }
+        worker.flush_control(Duration::ZERO).unwrap();
+        let mut buffer = worker.free.pop().unwrap();
+        buffer.length = rx.recv(&mut buffer.bytes).unwrap().0;
+        let mut header = Datagram::decode(&buffer.bytes[..buffer.length])
+            .unwrap()
+            .header();
+        header.receive_tag = 1;
+        header.lane = 7;
+        header.encode((&mut buffer.bytes[..wire::HEADER_LEN]).try_into().unwrap());
+        let copy = buffer.bytes[..buffer.length].to_vec();
+        let mut budget = ReceiveBudget::default();
+        let buffer = worker
+            .packet_one(buffer, Duration::ZERO, &mut budget)
+            .unwrap()
+            .unwrap();
+        assert_eq!(budget.datagrams, 1);
+        assert_eq!(budget.records, 4);
+        assert_eq!(worker.sender.ack_free.len(), 0);
+        assert_eq!(worker.sender.incoming.len(), 2);
+        assert_eq!(worker.sender.outgoing.len(), 2);
+        assert_eq!(worker.counters.queue_drops, 0);
+        worker.free.push(buffer);
+        let mut duplicate = worker.free.pop().unwrap();
+        duplicate.length = copy.len();
+        duplicate.bytes[..copy.len()].copy_from_slice(&copy);
+        worker
+            .packet_one(duplicate, Duration::ZERO, &mut ReceiveBudget::default())
+            .unwrap();
+        assert_eq!(worker.counters.duplicate_packets, 1);
+        assert_eq!(worker.counters.queue_drops, 0);
+    }
