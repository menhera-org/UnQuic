+// Isolated causal experiment; absent at compile time leaves controller outputs unchanged.
+const DIAGNOSTIC_MODE: u8 = match option_env!("UNQUIC_CONTROLLER_DIAGNOSTIC") {
+    None => 0,
+    Some(value) => match value.as_bytes() {
+        [b'r', b'a', b't', b'e'] => 1,
+        [b'w', b'i', b'n', b'd', b'o', b'w'] => 2,
+        [b'b', b'o', b't', b'h'] => 3,
+        _ => panic!("invalid UNQUIC_CONTROLLER_DIAGNOSTIC"),
+    },
+};
+
+fn diagnostic_limits(mut limits: pacing::Limits, mode: u8, probe_rtt: bool) -> pacing::Limits {
+    if mode & 1 != 0 {
+        limits.rate = 4_000_000_000;
+    }
+    if mode & 2 != 0 && !probe_rtt {
+        limits.window = 8 * 1024 * 1024;
+    }
+    limits
+}
+
+impl Group {
+    fn effective_limits(&self) -> pacing::Limits {
+        diagnostic_limits(
+            self.controller.limits(),
+            DIAGNOSTIC_MODE,
+            self.controller.state() == crate::bbr::State::ProbeRtt,
+        )
+    }
+}
