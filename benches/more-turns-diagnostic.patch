+/// Diagnostic: counts which phase asked for another turn.
+#[inline(always)]
+fn note(_phase: usize, more: bool) -> bool {
+    #[cfg(feature = "profile")]
+    if more {
+        crate::profile::MORE[_phase].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    }
+    more
