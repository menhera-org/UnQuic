+#[cfg(test)]
+mod timing_diagnostic_tests {
+    use super::*;
+    #[test]
+    fn cached_turn_time_is_separate_from_handoff_and_owner_service() {
+        let mut feedback = Feedback::new(1);
+        feedback.created = Duration::from_micros(10);
+        feedback.constructed = Duration::from_micros(110);
+        feedback.enqueued = Duration::from_micros(160);
+        let times = feedback.diagnostic_times(Duration::from_micros(210));
+        assert_eq!(times, [100_000, 100_000, 50_000, 50_000]);
+        assert_eq!(times[1], times[2] + times[3]);
+        feedback.origin = 0;
+        feedback.enqueued = feedback.constructed;
+        assert_eq!(
+            feedback.diagnostic_times(Duration::from_micros(210)),
+            [100_000, 100_000, 0, 100_000]
+        );
+    }
