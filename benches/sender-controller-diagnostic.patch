+impl Group {
+    fn transition(&mut self, phase: Phase) {
+        if self.phase == phase {
+            return;
+        }
+        let now = Instant::now();
+        let index = self.phase as usize;
+        self.phase_totals[index] = self.phase_totals[index].saturating_add(
+            now.duration_since(self.phase_clock)
+                .as_nanos()
+                .min(u64::MAX as u128) as u64,
+        );
+        self.phase_clock = now;
+        self.phase = phase;
+    }
+
+    fn phase_times(&self) -> [u64; 4] {
+        let mut totals = self.phase_totals;
+        let index = self.phase as usize;
+        totals[index] = totals[index]
+            .saturating_add(self.phase_clock.elapsed().as_nanos().min(u64::MAX as u128) as u64);
+        totals
+    }
+}
