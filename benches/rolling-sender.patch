+#[test]
+fn replacement_grants_do_not_charge_uncommitted_reports_twice() {
+    let (mut sender, flights) = Sender::new(1, 3, 3).unwrap();
+    let mut flights = buffers(flights);
+    let mut c = flights.pop().unwrap();
+    let mut b = flights.pop().unwrap();
+    let mut a = flights.pop().unwrap();
+    let plans = [packet(0, 1, 100), packet(1, 1, 200), packet(2, 1, 300)];
+    let mut handles = [None; 3];
+    for (worker, flight) in [&mut a, &mut b].into_iter().enumerate() {
+        flight.prepare(&plans[worker..worker + 1]).unwrap();
+        sender
+            .reserve(0, flight, false, limits(), us(worker as u64 * 10))
+            .unwrap();
+        handles[worker] = flight.handle(0);
+    }
+    a.complete(1, Some(us(30)), false).unwrap();
+    b.complete(1, Some(us(20)), false).unwrap();
+    sender.reported(a).unwrap();
+    sender.reported(b).unwrap();
+    c.prepare(&plans[2..]).unwrap();
+    sender.reserve(0, &mut c, false, limits(), us(40)).unwrap();
+    handles[2] = c.handle(0);
+    let _b = commit(&mut sender, 0);
+    let _a = commit(&mut sender, 0);
+    c.complete(1, Some(us(41)), false).unwrap();
+    sender.reported(c).unwrap();
+    let _c = commit(&mut sender, 0);
+    for (index, (worker, flight)) in [(1, 200), (0, 300), (2, 600)].into_iter().enumerate() {
+        let sample = acknowledge(
+            &mut sender,
+            0,
+            plans[worker],
+            handles[worker].unwrap(),
+            100 + index as u64,
+        );
+        assert_eq!(
+            (sample.last_packet, sample.tx_in_flight),
+            (index as u64 + 1, flight)
+        );
+    }
+}
