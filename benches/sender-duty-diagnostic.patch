+impl Group {
+    fn diagnostic_account(&mut self, now: Duration) {
+        let elapsed = now.saturating_sub(self.diagnostic_at).as_nanos() as u64;
+        self.diagnostic_at = now;
+        let d = &mut self.diagnostic;
+        d.diag_now_ns = now.as_nanos() as u64;
+        let dwell = match self.controller.state() {
+            crate::bbr::State::Startup => &mut d.diag_startup_ns,
+            crate::bbr::State::Drain => &mut d.diag_drain_ns,
+            crate::bbr::State::Down => &mut d.diag_down_ns,
+            crate::bbr::State::Cruise => &mut d.diag_cruise_ns,
+            crate::bbr::State::Refill => &mut d.diag_refill_ns,
+            crate::bbr::State::Up => &mut d.diag_up_ns,
+            crate::bbr::State::ProbeRtt => &mut d.diag_probe_rtt_ns,
+        };
+        *dwell = dwell.wrapping_add(elapsed);
+    }
+
+    fn diagnostic_observe(&mut self) {
+        let limits = self.controller.limits();
+        let state = self.controller.state() as u64;
+        let d = &mut self.diagnostic;
+        if state == crate::bbr::State::ProbeRtt as u64 && d.diag_state != state {
+            d.diag_probe_rtt_entries += 1;
+        }
+        d.diag_state = state;
+        d.diag_cwnd = limits.window;
+        d.diag_cwnd_min = if d.diag_cwnd_min == 0 {
+            limits.window
+        } else {
+            d.diag_cwnd_min.min(limits.window)
+        };
+        d.diag_cwnd_max = d.diag_cwnd_max.max(limits.window);
+        d.diag_rate_min = if d.diag_rate_min == 0 {
+            limits.rate
+        } else {
+            d.diag_rate_min.min(limits.rate)
+        };
+        d.diag_rate_max = d.diag_rate_max.max(limits.rate);
+        (
+            d.diag_max_bw,
+            d.diag_bw_shortterm,
+            d.diag_inflight_shortterm,
+            d.diag_lost_bytes,
+        ) = self.controller.diagnostic_bounds();
+    }
+}
