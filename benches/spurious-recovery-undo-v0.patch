+                crate::pacing::Limits {
+                    window: 100_000,
+                    rate: 1_000_000_000,
+                    quantum: 100_000,
+                    max_datagram: 1280,
+                },
+                at,
+            )
+            .unwrap();
+        let handles = (0..numbers.len())
+            .map(|i| flight.handle(i).unwrap())
+            .collect();
+        flight.complete(numbers.len(), Some(at), false).unwrap();
+        owner.sender.reported(flight).unwrap();
+        let flight = owner.sender.advance(0, 64).unwrap().unwrap();
+        owner
+            .timers
+            .submitted(0, 1, 1, numbers.len() as u32, at)
+            .unwrap();
+        (flight, handles)
+    }
+
+    fn ack(
+        owner: &mut Owner,
+        number: u64,
+        handle: NonZeroU16,
+        sent: Duration,
+        received: Duration,
+        settled: bool,
+    ) {
+        let mut report = Report::new(0);
+        report.group = 0;
+        report.id = PacketId {
+            session: 0,
+            generation: 1,
+            lane: 1,
+            number: 0,
+        };
+        report.kind = ReportKind::Ack {
+            received,
+            delay_us: 0,
+            first: true,
+            end: Some(AckProgress {
+                packets: 1,
+                eliciting: true,
+                released_bytes: if settled { 1280 } else { 0 },
+                rtt_sent_at: Some(sent),
+            }),
+        };
+        report.count = 1;
+        report.entries[0] = Entry {
+            number,
+            sample: Some(handle),
+            settled,
+        };
+        owner.apply_report(&report, received).unwrap();
+    }
+
+    #[test]
+    fn proof_finishes_before_or_after_the_normal_recovery_exit() {
+        for finish_first in [false, true] {
+            let (mut owner, flights) = Owner::new(1, 1, &[(0, 1, 0)], Duration::ZERO).unwrap();
+            owner.timers.install(0, 1).unwrap();
+            owner.sender.close(0).unwrap();
+            owner.sender.advance(0, 64).unwrap();
+            let (flight, handles) = send(
+                &mut owner,
+                flights.into_vec().pop().unwrap(),
+                &[1, 2],
+                Duration::ZERO,
+            );
+            let mut loss = Report::new(0);
+            loss.group = 0;
+            loss.id = PacketId {
+                session: 0,
+                generation: 1,
+                lane: 1,
+                number: 0,
+            };
+            loss.kind = ReportKind::Loss;
+            loss.count = 2;
+            for (index, &handle) in handles.iter().enumerate() {
+                loss.entries[index] = Entry {
+                    number: index as u64 + 1,
+                    sample: Some(handle),
+                    settled: true,
+                };
+            }
+            owner.apply_report(&loss, Duration::from_millis(1)).unwrap();
+            ack(
+                &mut owner,
+                1,
+                handles[0],
+                Duration::ZERO,
+                Duration::from_millis(3),
+                false,
+            );
+            assert_eq!(owner.groups[0].recovery, Some(Duration::from_millis(1)));
+            if finish_first {
+                let (_flight, new_handles) =
+                    send(&mut owner, flight, &[3], Duration::from_millis(4));
+                ack(
+                    &mut owner,
+                    3,
+                    new_handles[0],
+                    Duration::from_millis(4),
+                    Duration::from_millis(5),
+                    true,
+                );
+                assert_eq!(owner.groups[0].recovery, None);
+            }
+            ack(
+                &mut owner,
+                2,
+                handles[1],
+                Duration::ZERO,
+                Duration::from_millis(6),
+                false,
+            );
+            assert_eq!(owner.groups[0].recovery, None);
+            assert!(!owner.sender.spurious_recovery(0).unwrap());
+            assert_eq!(owner.sender.flight_bytes(0), Some((0, 0)));
+            assert_eq!(
+                owner.groups[0]
+                    .controller
+                    .undo_recovery(Duration::from_millis(6)),
+                Err(crate::bbr::ControllerError::Invalid)
+            );
+        }
+    }
+}
