+#[test]
+fn recovery_checkpoint_survives_multiple_loss_rounds_and_late_proof() {
+    for finish_first in [false, true] {
+        let mut c = cruise();
+        let original = c.limits().window;
+        c.enter_recovery(c.now, 30_000, false).unwrap();
+        for round in 0..3 {
+            loss(&mut c, 1500, 1500, 30_000, false);
+            let s = sample(&c, 100_000, 1500);
+            c.on_ack(s, Some(ms(10)), 15_000, false, ms(60 + round * 10))
+                .unwrap();
+        }
+        assert!(c.bw_shortterm < INFINITY);
+        assert!(c.inflight_shortterm < INFINITY);
+        let counters = (c.delivered, c.lost);
+        if finish_first {
+            c.recovery_finished(c.now, false).unwrap();
+            // ProbeRTT has its own saved window; it must not replace the loss checkpoint.
+            c.prior_cwnd = 6000;
+            c.cwnd = 6000;
+            c.state = State::ProbeRtt;
+        }
+        c.undo_recovery(c.now).unwrap();
+        assert_eq!((c.bw_shortterm, c.inflight_shortterm), (INFINITY, INFINITY));
+        assert!(c.cwnd >= original);
+        assert_eq!((c.delivered, c.lost), counters);
+        assert!(!c.recovering);
+        assert!(!c.loss_in_round);
+        if finish_first {
+            assert_eq!(c.state(), State::ProbeRtt);
+        }
+        assert_eq!(c.undo_recovery(c.now), Err(ControllerError::Invalid));
+    }
+}
+
+#[test]
+fn a_new_recovery_replaces_the_previous_checkpoint() {
+    let mut c = cruise();
+    c.enter_recovery(c.now, 30_000, false).unwrap();
+    loss(&mut c, 1500, 1500, 30_000, false);
+    let s = sample(&c, 100_000, 1500);
+    c.on_ack(s, Some(ms(10)), 15_000, false, ms(60)).unwrap();
+    c.recovery_finished(c.now, false).unwrap();
+    let bounds = (c.bw_shortterm, c.inflight_shortterm);
+    c.enter_recovery(c.now, 15_000, false).unwrap();
+    loss(&mut c, 1500, 1500, 15_000, false);
+    let s = sample(&c, 10_000, 1500);
+    c.on_ack(s, Some(ms(10)), 7500, false, ms(70)).unwrap();
+    c.undo_recovery(c.now).unwrap();
+    assert_eq!((c.bw_shortterm, c.inflight_shortterm), bounds);
+}
+
+#[test]
+fn later_loss_rounds_do_not_forget_the_loss_caused_probe_departure() {
+    let mut c = cruise();
+    c.start_refill();
+    c.start_up(1_500_000);
+    c.check_probe_loss = true;
+    c.enter_recovery(c.now, 15000, false).unwrap();
+    loss(&mut c, 1500, 1500, 15000, false);
+    assert_eq!(c.state(), State::Down);
+    c.loss_in_round = false;
+    loss(&mut c, 1500, 1500, 15000, false);
+    c.recovery_finished(c.now, false).unwrap();
+    c.undo_recovery(c.now).unwrap();
+    assert_eq!(c.state(), State::Refill);
+    assert_eq!(c.inflight_longterm, INFINITY);
+}
