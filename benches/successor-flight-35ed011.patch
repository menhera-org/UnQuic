+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn successor_probe_resize_or_cancel_before_retirement_preserves_data_accounting() {
+    for resize in [false, true] {
+        let (mut workers, _rx) = successful_predecessor(60);
+        let old = workers[1].sender.retiring.unwrap();
+        let (_, Message::Complete(complete)) = workers[1].sender.outgoing.pop_front().unwrap()
+        else {
+            panic!()
+        };
+        workers[1]
+            .request_probe(0, 1, BASE_UDP_PAYLOAD, true, None, Duration::from_millis(2))
+            .unwrap();
+        let (_, Message::Request(request)) = workers[1].sender.outgoing.pop_front().unwrap() else {
+            panic!()
+        };
+        assert!(request.flight.completion().is_none());
+        let message = if resize {
+            Message::Resize {
+                flight: request.flight,
+                payload: BASE_UDP_PAYLOAD,
+            }
+        } else {
+            Message::Recycle(request.flight)
+        };
+        workers[1]
+            .sender_message(message, Duration::from_millis(2))
+            .unwrap();
+        assert!(workers[1].sender.job.is_none());
+        assert!(workers[1].sender.flight.is_some());
+        assert!(workers[1].sender.spare.is_none());
+        assert_eq!(workers[1].sender.retiring.unwrap().first, old.first);
+        let owner = workers[0].sender.owner.as_mut().unwrap();
+        owner.complete(complete).unwrap();
+        let mut outgoing = VecDeque::with_capacity(32);
+        owner
+            .advance(Duration::from_millis(2), &mut outgoing)
+            .unwrap();
+        let (_, Message::Recycle(retired)) = outgoing.pop_front().unwrap() else {
+            panic!()
+        };
+        workers[1]
+            .sender_message(Message::Recycle(retired), Duration::from_millis(2))
+            .unwrap();
+        assert!(workers[1].sender.retiring.is_none());
+        assert!(workers[1].sender.spare.is_some());
+        assert!(workers[1].sender.flight.is_some());
+    }
+}
