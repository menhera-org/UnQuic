+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn retiring_successor_identity_rejects_wrong_generation_without_releasing_state() {
+    let (mut workers, _rx) = successful_predecessor(60);
+    let (_, Message::Complete(complete)) = workers[1].sender.outgoing.pop_front().unwrap() else {
+        panic!()
+    };
+    let owner = workers[0].sender.owner.as_mut().unwrap();
+    owner.complete(complete).unwrap();
+    let mut outgoing = VecDeque::with_capacity(32);
+    owner
+        .advance(Duration::from_millis(2), &mut outgoing)
+        .unwrap();
+    let (_, Message::Recycle(retired)) = outgoing.pop_front().unwrap() else {
+        panic!()
+    };
+    workers[1].sender.retiring.as_mut().unwrap().generation += 1;
+    assert!(
+        workers[1]
+            .sender_message(Message::Recycle(retired), Duration::from_millis(2))
+            .is_err()
+    );
+    assert!(workers[1].sender.retiring.is_some());
+    assert!(workers[1].sender.spare.is_none());
+}
