+#[test]
+#[ignore = "kernel descriptor test; run in a disposable container"]
+fn successor_preserves_reserved_suffix_and_waits_for_predecessor_commit() {
+    let (mut workers, _rx) = successful_predecessor(9022);
+    let old = workers[1].sender.retiring.unwrap();
+    assert_eq!(old.count, 1);
+    let index = workers[1].sender_index(0, 1).unwrap();
+    let suffix = workers[1].sessions[0].batches[1]
+        .as_ref()
+        .unwrap()
+        .plan
+        .packet(0)
+        .unwrap()
+        .number;
+    assert_eq!(suffix, old.first + 1);
+    assert!(workers[1].sender.lanes[index].history.is_reserved(suffix));
+    workers[1].flush_frames(Duration::from_millis(1)).unwrap();
+    let (_, Message::Complete(complete)) = workers[1].sender.outgoing.pop_front().unwrap() else {
+        panic!()
+    };
+    let (_, Message::Request(request)) = workers[1].sender.outgoing.pop_front().unwrap() else {
+        panic!()
+    };
+    assert_eq!(request.flight.packets().next().unwrap().id.number, suffix);
+    let owner = workers[0].sender.owner.as_mut().unwrap();
+    owner.request(request).unwrap();
+    let mut outgoing = VecDeque::with_capacity(32);
+    owner
+        .advance(Duration::from_millis(2), &mut outgoing)
+        .unwrap();
+    assert!(
+        !outgoing
+            .iter()
+            .any(|(_, message)| matches!(message, Message::Permit(_)))
+    );
+    owner.complete(complete).unwrap();
+    owner
+        .advance(Duration::from_millis(3), &mut outgoing)
+        .unwrap();
+    let (_, Message::Recycle(retired)) = outgoing.pop_front().unwrap() else {
+        panic!()
+    };
+    workers[1]
+        .sender_message(Message::Recycle(retired), Duration::from_millis(3))
+        .unwrap();
+    assert!(workers[1].sender.retiring.is_none());
+    assert!(workers[1].sender.spare.is_some());
+    assert_eq!(workers[1].sender.job.unwrap().first, suffix);
+    assert!(workers[1].sender.lanes[index].history.is_reserved(suffix));
+    if let Some((_, Message::Permit(flight))) = outgoing.pop_front() {
+        workers[1]
+            .sender_message(Message::Permit(flight), Duration::from_millis(3))
+            .unwrap();
+        assert!(workers[1].sender.permitted);
+    }
+}
