+fn successful_predecessor(length: usize) -> ([Worker; 2], ReceiveSocket) {
+    let (mut workers, rx) = workers();
+    workers[1].mtu_due = Duration::MAX;
+    queue_frame(&mut workers[1], length);
+    workers[1].flush_frames(Duration::ZERO).unwrap();
+    let (_, Message::Request(mut request)) = workers[1].sender.outgoing.pop_front().unwrap() else {
+        panic!()
+    };
+    let first_bytes = request.flight.packets().next().unwrap().bytes;
+    request.flight.truncate(u32::from(first_bytes)).unwrap();
+    let owner = workers[0].sender.owner.as_mut().unwrap();
+    owner.request(request).unwrap();
+    let mut outgoing = VecDeque::with_capacity(32);
+    owner
+        .advance(Duration::from_millis(1), &mut outgoing)
+        .unwrap();
+    let (_, Message::Permit(flight)) = outgoing.pop_front().unwrap() else {
+        panic!()
+    };
+    workers[1]
+        .sender_message(Message::Permit(flight), Duration::from_millis(1))
+        .unwrap();
+    workers[1]
+        .use_sender_permit(Duration::from_millis(1))
+        .unwrap();
+    assert!(workers[1].sender.job.is_none());
+    assert!(workers[1].sender.retiring.is_some());
+    assert!(workers[1].sender.flight.is_some());
+    assert!(workers[1].sender.spare.is_none());
+    (workers, rx)
+}
