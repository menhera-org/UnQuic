+    #[test]
+    fn simultaneous_grants_commit_reverse_reports_in_physical_send_order() {
+        for equal_time in [false, true] {
+            let (mut sender, mut flights, limits) = setup(2);
+            let pass = sender.begin_grant_pass(Duration::ZERO).unwrap();
+            for flight in &mut flights {
+                sender
+                    .reserve_prefix(0, flight, 1280, false, limits, pass)
+                    .unwrap();
+            }
+            let packets: Vec<_> = flights
+                .iter()
+                .map(|f| (f.packets().next().unwrap().id, f.handle(0).unwrap()))
+                .collect();
+            let first = if equal_time { 0 } else { 1 };
+            let mut second = flights.pop().unwrap();
+            second
+                .complete(1, Some(Duration::from_micros(10)), false)
+                .unwrap();
+            sender.reported(second).unwrap();
+            let mut first_grant = flights.pop().unwrap();
+            first_grant
+                .complete(
+                    1,
+                    Some(Duration::from_micros(if equal_time { 10 } else { 20 })),
+                    false,
+                )
+                .unwrap();
+            sender.reported(first_grant).unwrap();
+            for (ordinal, index) in [first, 1 - first].into_iter().enumerate() {
+                assert_eq!(sender.advance(0, 1).unwrap().unwrap().worker(), index);
+                // ACKs wait until every simultaneous flight's samples commit.
+                if ordinal == 0 {
+                    assert!(!sender.feedback_ready(0));
+                }
+            }
+            for (ordinal, index) in [first, 1 - first].into_iter().enumerate() {
+                sender
+                    .begin_ack(0, Duration::from_micros(100 + ordinal as u64), false)
+                    .unwrap();
+                sender
+                    .acknowledged(0, packets[index].0, packets[index].1)
+                    .unwrap();
+                let sample = sender.finish_ack(0, Duration::ZERO).unwrap().unwrap();
+                assert_eq!(sample.last_packet, ordinal as u64 + 1);
+                assert_eq!(sample.tx_in_flight, (ordinal as u64 + 1) * 1280);
+                assert_eq!(sample.newly_acked, 1280);
+            }
+            assert_eq!(sender.flight_bytes(0), Some((0, 0)));
+        }
+    }
