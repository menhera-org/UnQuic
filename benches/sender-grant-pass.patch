+    #[allow(clippy::vec_box)] // Exercise the movable buffers used by the worker queues.
+    fn setup(workers: usize) -> (Sender, Vec<Box<Flight>>, Limits) {
+        let (sender, flights) = Sender::new(1, workers, 64).unwrap();
+        let mut flights = flights.into_vec();
+        for flight in &mut flights {
+            let worker = flight.worker();
+            flight
+                .prepare(&[Planned {
+                    id: PacketId {
+                        session: 0,
+                        generation: 1,
+                        lane: worker as u16 + 1,
+                        number: 1,
+                    },
+                    bytes: 1280,
+                }])
+                .unwrap();
+        }
+        (
+            sender,
+            flights,
+            Limits {
+                window: 10_000,
+                rate: 1_000_000,
+                quantum: 2560,
+                max_datagram: 1280,
+            },
+        )
+    }
+
+    #[test]
+    fn one_pass_splits_the_cap_and_charges_every_byte_without_refund() {
+        let (mut sender, mut flights, limits) = setup(3);
+        let pass = sender.begin_grant_pass(Duration::ZERO).unwrap();
+        sender
+            .reserve_prefix(0, &mut flights[0], 1280, false, limits, pass)
+            .unwrap();
+        // Public reservation retains strict pacing even during an explicit pass.
+        assert_eq!(
+            sender.reserve(0, &mut flights[1], false, limits, Duration::ZERO),
+            Err(GrantError::Blocked)
+        );
+        sender
+            .reserve_prefix(0, &mut flights[1], 1280, false, limits, pass)
+            .unwrap();
+        assert_eq!(
+            sender.reserve_prefix(0, &mut flights[2], 1280, false, limits, pass),
+            Err(GrantError::Blocked)
+        );
+        assert_eq!(flights[2].packets().count(), 1);
+        assert_eq!(sender.flight_bytes(0), Some((2560, 0)));
+        let due = Duration::from_micros(2560);
+        assert_eq!(sender.deadline(0, Duration::ZERO), Some(due));
+        // Unused reports close issuance without rewinding reserved pacing time.
+        let mut unused = flights.remove(1);
+        unused.complete(0, None, false).unwrap();
+        sender.reported(unused).unwrap();
+        assert_eq!(
+            sender.reserve_prefix(0, &mut flights[1], 1280, false, limits, pass),
+            Err(GrantError::Blocked)
+        );
+        let mut sent = flights.remove(0);
+        sent.complete(1, Some(Duration::ZERO), false).unwrap();
+        sender.reported(sent).unwrap();
+        while sender.advance(0, 64).unwrap().is_some() {}
+        sender.reopen(0).unwrap();
+        assert_eq!(sender.deadline(0, Duration::ZERO), Some(due));
+        assert_eq!(
+            sender.reserve_prefix(0, &mut flights[0], 1280, false, limits, pass),
+            Err(GrantError::Blocked)
+        );
+        let fresh = sender.begin_grant_pass(Duration::from_secs(1)).unwrap();
+        sender
+            .reserve_prefix(0, &mut flights[0], 1280, false, limits, fresh)
+            .unwrap();
+        assert_eq!(
+            sender.deadline(0, Duration::from_secs(1)),
+            Some(Duration::from_secs(1) + Duration::from_micros(1280))
+        );
+    }
+
+    #[test]
+    fn pass_identity_and_changed_limits_cannot_create_extra_credit() {
+        let (mut sender, mut flights, limits) = setup(3);
+        let pass = sender.begin_grant_pass(Duration::ZERO).unwrap();
+        sender
+            .reserve_prefix(0, &mut flights[0], 1280, false, limits, pass)
+            .unwrap();
+        for changed in [
+            Limits { rate: 0, ..limits },
+            Limits {
+                rate: limits.rate / 2,
+                ..limits
+            },
+            Limits {
+                rate: limits.rate * 2,
+                ..limits
+            },
+            Limits {
+                quantum: limits.quantum * 2,
+                ..limits
+            },
+            Limits {
+                quantum: limits.quantum / 2,
+                ..limits
+            },
+            Limits {
+                window: 1280,
+                ..limits
+            },
+        ] {
+            assert_eq!(
+                sender.reserve_prefix(0, &mut flights[1], 1280, false, changed, pass),
+                Err(GrantError::Blocked)
+            );
+            assert_eq!(sender.flight_bytes(0), Some((1280, 0)));
+            assert!(flights[1].handle(0).is_none());
+        }
+        sender
+            .reserve_prefix(0, &mut flights[1], 1280, false, limits, pass)
+            .unwrap();
+        let next = sender.begin_grant_pass(Duration::ZERO).unwrap();
+        assert_eq!(
+            sender.reserve_prefix(0, &mut flights[2], 1280, false, limits, pass),
+            Err(GrantError::Stale)
+        );
+        assert_eq!(
+            sender.reserve_prefix(0, &mut flights[2], 1280, false, limits, next),
+            Err(GrantError::Blocked)
+        );
+    }
