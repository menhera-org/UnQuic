+        assert!(limits.quantum >= 2560 && limits.window >= 2560);
+        let mut outgoing = VecDeque::with_capacity(16);
+        owner.advance(Duration::ZERO, &mut outgoing).unwrap();
+        assert_eq!(
+            outgoing.len(),
+            2,
+            "short requests did not share the available quantum"
+        );
+        for worker in 0..2 {
+            let (destination, Message::Permit(flight)) = outgoing.pop_front().unwrap() else {
+                panic!("missing send permission");
+            };
+            assert_eq!(destination, worker);
+            assert_eq!(flight.grant().unwrap().bytes(), 1280);
+        }
+        assert_eq!(owner.sender.flight_bytes(0), Some((2560, 0)));
+        let service = (1280_u64 * 1_000_000_000).div_ceil(limits.rate);
+        assert_eq!(
+            owner.sender.deadline(0, Duration::ZERO),
+            Some(Duration::from_nanos(2 * service))
+        );
+    }
+}
