index c12610b..2960fd3 100644
--- a/src/profile.rs
+++ b/src/profile.rs
@@ -80,8 +80,43 @@ pub fn syscall(kind: usize, started: u64, items: usize) {
     }
 }
 
+thread_local! {
+    /// Diagnostic: per-thread cycle and call counts for spots outside the
+    /// worker loop's phases, by index: see LOCAL_NAMES.
+    static LOCAL: [std::cell::Cell<u64>; 16] = const { [const { std::cell::Cell::new(0) }; 16] };
+}
+
+/// Names of the LOCAL spots, cycles then calls for each.
+pub const LOCAL_NAMES: [&str; 8] = [
+    "admit_expire",
+    "admit_scan",
+    "admit_copy",
+    "admit_tail",
+    "tap_write_syscall",
+    "tap_write_calls",
+    "expand",
+    "expand_frames",
+];
+
+/// Adds `value` to LOCAL spot `index` on this thread.
+pub fn local(index: usize, value: u64) {
+    LOCAL.with(|spots| {
+        if let Some(spot) = spots.get(index) {
+            spot.set(spot.get().wrapping_add(value));
+        }
+    });
+}
+
 /// Prints one worker's phase totals, largest first, as shares of their sum.
 pub fn report(worker: usize, phases: &[u64; PHASES]) {
+    LOCAL.with(|spots| {
+        let line: Vec<String> = LOCAL_NAMES
+            .iter()
+            .zip(spots.iter())
+            .map(|(name, spot)| format!("{name}={}", spot.get()))
+            .collect();
+        eprintln!("unquic: profile worker {worker} local {}", line.join(" "));
+    });
     let total: u64 = phases.iter().sum();
     let mut order: Vec<usize> = (0..PHASES).collect();
     order.sort_by_key(|&index| std::cmp::Reverse(phases[index]));
