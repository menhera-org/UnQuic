     #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn handoff_quota_yields_and_continues_after_coalesced_wakes() {
+        let (shared, mut workers) = test_workers_with_layout(3, 3);
+        let params = wire::Params {
+            port: 40000,
+            max_frame_len: 9022,
+            mandatory_features: 0,
+            optional_features: 0,
+        };
+        workers[0].sessions[0].connection = Some(Connection {
+            role: handshake::Role::Initiator,
+            initiator: Tag::new(1).unwrap(),
+            responder: Tag::new(2).unwrap(),
+            local: params,
+            peer: params,
+            max_frame_len: 9022,
+        });
+        for from in 1..3 {
+            let (tx, rx) = crate::spsc::channel();
+            workers[from].outgoing[0] = Some(tx);
+            workers[0].incoming[from] = Some(rx);
+            for index in 0..17 {
+                let event = if index == 8 {
+                    Event::Retire {
+                        session: 0,
+                        tag: 1,
+                        lane: from as u16,
+                    }
+                } else {
+                    Event::Packet(workers[from].free.pop().unwrap())
+                };
+                assert!(workers[from].push(0, event).is_ok());
+            }
+            workers[from].flush_notifications().unwrap();
+        }
+        let mut events = [libc::epoll_event { events: 0, u64: 0 }; 4];
+        assert_ne!(workers[0].reactor.wait(&mut events, 0).unwrap(), 0);
+        workers[0].reactor.drain(0).unwrap();
+        assert!(workers[0].drain_queues(Duration::ZERO).unwrap());
+        assert_eq!(workers[0].received.len(), 16);
+        for lane in 1..3 {
+            assert_eq!(shared.owners[0][lane].load(Ordering::Acquire), 0);
+        }
+        // Both wake writes were consumed; only bounded-work continuation remains.
+        assert_eq!(workers[0].reactor.wait(&mut events, 0).unwrap(), 0);
+        assert!(workers[0].drain_queues(Duration::ZERO).unwrap());
+        assert_eq!(workers[0].received.len(), 30);
+        for lane in 1..3 {
+            assert_eq!(shared.owners[0][lane].load(Ordering::Acquire), 255);
+        }
+        assert!(!workers[0].drain_queues(Duration::ZERO).unwrap());
+        assert_eq!(workers[0].received.len(), 32);
+        assert!(!workers[0].drain_queues(Duration::ZERO).unwrap());
+    }
