+#[cfg(test)]
+mod diagnostic_tests {
+    use super::*;
+    fn us(n: u64) -> Duration {
+        Duration::from_micros(n)
+    }
+
+    #[test]
+    fn earliest_cause_survives_coalescing_and_take_resets_fresh_count() {
+        let mut ack = Schedule::new();
+        ack.accepted(2, true, us(10));
+        for number in 3..=18 {
+            ack.accepted(number, true, us(20));
+        }
+        assert_eq!(ack.diagnostic(us(30)), [2, 17, 10_000, 20_000, 20_000]);
+        assert_eq!(ack.take(us(30)), Some(10));
+        assert_eq!(ack.diagnostic(us(30))[..2], [0, 0]);
+        ack.accepted(19, true, us(100));
+        for number in 20..=34 {
+            ack.accepted(number, true, us(1200));
+        }
+        // Timer already became eligible before the threshold was reached.
+        assert_eq!(
+            ack.diagnostic(us(1300)),
+            [4, 16, 100_000, 200_000, 1_200_000]
+        );
+    }
+
+    #[test]
+    fn earlier_threshold_replaces_timer_and_tied_gap_is_retained() {
+        let mut ack = Schedule::new();
+        for number in 1..16 {
+            ack.accepted(number, true, us(10));
+        }
+        ack.accepted(17, true, us(20));
+        assert_eq!(ack.diagnostic(us(20))[..2], [3, 16]);
+        ack.duplicate(us(20));
+        assert_eq!(ack.diagnostic(us(20))[0], 11);
+        assert!(ack.take(us(20)).is_some());
+        ack.duplicate(us(30));
+        assert_eq!(ack.diagnostic(us(1020))[..2], [8, 0]);
+    }
+}
