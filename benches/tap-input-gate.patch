     #[test]
+    #[ignore = "kernel descriptor test; run in a disposable container"]
+    fn tap_gate_diagnostic_distinguishes_pending_work_and_physical_pressure() {
+        let (mut worker, _tap) = receive_worker();
+        let source = deadline_input(&mut worker, true);
+        worker.input_frame(source, Duration::ZERO).unwrap();
+        assert!(worker.tap_physical_capacity(0) != 0);
+        assert!(worker.tap_can_expand(0));
+        for tick in [1, 3] {
+            worker.flush_taps(Duration::from_millis(tick)).unwrap();
+        }
+        let retained = worker.sessions[0].tx_retained;
+        worker.sessions[0].tx_retained = frame_quota(worker.sessions[0].tx_workers);
+        assert!(!worker.tap_can_expand(0));
+        for tick in [6, 10] {
+            worker.flush_taps(Duration::from_millis(tick)).unwrap();
+        }
+        worker.sessions[0].tx_retained = retained;
+        let source = worker.sessions[0].tap_inputs.pop_front().unwrap();
+        worker.close_source(source);
+        worker.flush_taps(Duration::from_millis(11)).unwrap();
+        let free = std::mem::take(&mut worker.free);
+        for tick in [12, 13] {
+            worker.flush_taps(Duration::from_millis(tick)).unwrap();
+        }
+        worker.free = free;
+        worker.flush_taps(Duration::from_millis(14)).unwrap();
+        worker.sessions[0].tap_registered = false;
+        worker.flush_taps(Duration::from_millis(20)).unwrap();
+        worker.flush_taps(Duration::from_millis(30)).unwrap();
+        worker.sessions[0].tap_registered = true;
+        worker.flush_taps(Duration::from_millis(40)).unwrap();
+        worker.flush_taps(Duration::from_millis(40)).unwrap();
+        for totals in [&worker.counters, &worker.sessions[0].totals] {
+            assert_eq!(totals.tap_observed_turns, 10);
+            assert_eq!(totals.tap_input_gate_turns, 4);
+            assert_eq!(totals.tap_input_gate_spare_turns, 2);
+            assert_eq!(totals.tap_input_gate_stalled_turns, 2);
+            assert_eq!(totals.tap_input_gate_ns, 10_000_000);
+            assert_eq!(totals.tap_input_gate_spare_ns, 5_000_000);
+            assert_eq!(totals.tap_input_gate_stalled_ns, 5_000_000);
+            assert_eq!(totals.tap_read_interest_gate_off, 1);
+            assert_eq!(totals.tap_read_interest_credit_off, 1);
+            assert_eq!(totals.tap_read_interest_on, 2);
+        }
+        assert_eq!(worker.free.len(), BUFFERS);
+        assert_eq!(worker.counters.queue_drops, 0);
+    }
