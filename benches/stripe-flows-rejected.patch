+/// Consecutive frames a striped session sends on one lane before the next.
+const STRIPE_FRAMES: usize = 16;
+
+/// Under `stripe_flows`, sends each run of STRIPE_FRAMES strict-path frames of
+/// a session to its next lane, whatever their flow.
+fn stripe_lane(cursor: &std::sync::atomic::AtomicUsize, lanes: usize) -> usize {
+    cursor.fetch_add(1, Ordering::Relaxed) / STRIPE_FRAMES % lanes
+}
